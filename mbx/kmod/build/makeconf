# ENV is used in a few other makefiles instead of the literal 'linux', for
# reasons of portability, presumably.  It's common to all of the linux makeconf
# files (usually build/*/makeconf.build) so now lives.
#
ENV				?= linux

# MODBASE is the name of the current module with any extension removed.
# MODSUFFIX is the suffix of the current module with the filename base removed.
#
MODBASE			= $(basename $(MODULE))
MODSUFFIX		= $(suffix $(MODULE))

# SILENT=@ causes command text to be omitted during the process.  If you want
# to see what's really happening then use "make SILENT= ..."
#
SILENT			= @

# BUILD=release sets the default release.
#
BUILD			?= release

# LIB_SUFFIX=so causes (where possible) the type of library generated to be a 
# shared library.  This isn't used in many places and isn't referenced here
# but opengles/ddk/makefile.alt and other places do use it.
#
LIB_SUFFIX		?= so

# MAKE_OPT defaults to --no-print-directory to declutter the build output.
#
MAKE_OPT		?= --no-print-directory

# COPY determines whether the local result is copied to $(SYSBIN).  By
# default this is "copy" - the name of the rule to do the copying.  But some
# places don't do this (e.g. services_um).  Override this by setting it to NULL
# rather than 'echo'.
#
COPY			?= copy

# Compilers and other such tools
#
AR  			= $(CROSS_COMPILE)ar
AS				= $(CROSS_COMPILE)as
CC				= $(CROSS_COMPILE)gcc
BUILD_CC		= gcc
CPP				= $(CROSS_COMPILE)g++
LD				= $(CROSS_COMPILE)ld
OBJCOPY 		= $(CROSS_COMPILE)objcopy
OBJDUMP			= $(CROSS_COMPILE)objdump
RANLIB			= $(CROSS_COMPILE)ranlib
STRIP			= $(CROSS_COMPILE)strip
SIZE			= $(CROSS_COMPILE)size

# Device name that will be used for creating device node with mknod
MBXACCESS_DEVICE ?= "\"mbx\""

# Minor convenience variables
#
DO_MKDIR		= $(SILENT)$(MKDIR) $@
DO_LN_S			= $(SILENT)$(LN) -s $< $@


# Basic entities contributing to the build
#
_SOURCES		= $(SOURCES) $(SOURCES.$(BUILD)) $(SOURCES.1)
OBJS			= $(addprefix $(TMP)/, $(patsubst %.s,%.o,$(patsubst %.cpp,%.o,$(_SOURCES:.c=.o))))
DEPS			= $(addprefix $(TMP)/, \
					$(patsubst %.s,%.depend,$(patsubst %.cpp,%.depend,$(_SOURCES:.c=.depend))))
MODULE_DEPS		+= $(patsubst %,$(SYSBIN)/%,$(LIB_DEPS))


# Work out our origins.  Embedded.pj is not supplied to end-users
# so instead we supply pvrversion.h.  We produce pvrversion.h if
# if doesn't exist.
#
DATE			:= $(shell date)
EMBEDDED_PJ		= $(PVR_CONSUMER_ROOT)/embedded.pj
PVRVERSION_H	= $(PVR_CONSUMER_ROOT)/include/pvrversion.h
PVRVERSION		= $(shell if [ -f $(EMBEDDED_PJ) ]; then \
						$(GREP) "\$Revision" $(EMBEDDED_PJ) |\
						$(SED) "s,.* \([0-9.]*\) .*,\1,"; \
					else \
						$(GREP) "PVRVERSION_STRING" < $(PVRVERSION_H) | $(SED) "s,.*\"\([0-9.]*\)\".*,\1,"; \
					fi)
PVRVERSION_MAJ		= $(shell echo $(PVRVERSION) | cut -d '.' -f1)
PVRVERSION_MIN		= $(shell echo $(PVRVERSION) | cut -d '.' -f2)
PVRVERSION_BRANCH	= $(shell echo $(PVRVERSION) | cut -d '.' -f3)
PVRVERSION_BUILD	= $(shell echo $(PVRVERSION) | cut -d '.' -f4,5,6)

# Useful (important) directories for the build.
#
BIN				= bin_$(PVR_BUILD_DIR)_$(BUILD)_$(MODULE)
TMP 			= tmp_$(PVR_BUILD_DIR)_$(BUILD)_$(MODULE)
_SYSBIN  		= $(PVR_CONSUMER_ROOT)/binary
SYSBIN  		= $(_SYSBIN)_$(PVR_BUILD_DIR)_$(BUILD)
FDO				= $(PVR_CONSUMER_ROOT)/freedesktop
SYSFDO			= $(SYSBIN)/freedesktop
SYSFDOBIN		= $(SYSFDO)/bin
SYSFDOLIB		= $(SYSFDO)/lib
SYSFDOINCLUDE	= $(SYSFDO)/include
SYSPKG			= $(SYSBIN)/packages
SYSPKGBIN		= $(SYSPKG)/bin
SYSPKGLIB		= $(SYSPKG)/lib
SYSPKGINCLUDE	= $(SYSPKG)/include


# Unix/Linux commands useful to the build process.
#
CAT				= /bin/cat
CP				= /bin/cp
CHMOD			= /bin/chmod
DOS2UNIX		= /usr/bin/dos2unix
ECHO			= -@echo
FIND			= /usr/bin/find
GREP			= /bin/grep
LN				= /bin/ln -s
MKDIR			= /bin/mkdir -p
MV				= /bin/mv
RM				= /bin/rm -f
SED				= /bin/sed
