###############################################################################
#
#  X window system build settings.
#

###############################################################################
#
# NOTE: X11ROOT sets the location used to find libX11.so which is a
# dependancy of libpvr2d if SUPPORT_XWS is used.
#
# It doesn't affect the install location for Xmbx or any other
# freedesktop packages that we build
# 
# The seperation lets you simply build the DDK against other X libraries
# if they are available in your $(DISCIMAGE) which may save you some time.
#
# The default install location for Xmbx etc is set in freedesktop/makefile
# per target overrides can be set in 
# build/TARGET/fdo_meta/FDO_SOURCE_ID/makefile.fdo
# 
# per target X11ROOT's can be set in build/TARGET/makeconf.build
# Note: it is relative to the root of DISCIMAGE which should be set.
#
X11ROOT                 ?= /usr/X11R6

###############################################################################
#
# If a developer has not set $(DISCIMAGE) yet then we don't want to try
# building against system X libraries/headers.
#
ifdef DISCIMAGE
SYS_INCLUDES.$(SUPPORT_XWS)		+= -I$(SYSFDOINCLUDE) -I$(DISCIMAGE)$(X11ROOT)/include
LINK_PATH.$(SUPPORT_XWS)		+= -L$(SYSFDOLIB) -L$(DISCIMAGE)$(X11ROOT)/lib
DLINK_PATH_CT.$(SUPPORT_XWS)	        += $(SYSFDOLIB) $(X11ROOT)/lib
else
SYS_INCLUDES.$(SUPPORT_XWS)		+= -I$(SYSFDOINCLUDE)
LINK_PATH.$(SUPPORT_XWS)		+= -L$(SYSFDOLIB)
endif

DLINK_PATH_RT.$(SUPPORT_XWS)	        += $(X11ROOT)/lib


# Automatically define C compiler macros for features possible (or not) in use.
# This saves makeconf.build and makefile.alt files having to sort this out in
# multiple places in the build system.
#
# How does this work?  An example
#	If SUPPORT_XWS is undefined: -DSUPPORT_XWS is added to $(SYS_CFLAGS.)
#	If SUPPORT_XWS is 0: -DSUPPORT_XWS is added to $(SYS_CFLAGS.0)
#	If SUPPORT_XWS is 1: -DSUPPORT_XWS is added to $(SYS_CFLAGS.1)
#
# Later on,  $(SYS_CFLAGS.1) and $(SYS_CFLAGS) are added in to $(ALL_CFLAGS); 
# SYS_CFLAGS.0 is ignored
#

ifeq ($(PASSTHROUGH_BUILD), 1)
DYNAMIC_VERTEX_CODE_GEN = 0
endif


# if OPENGLES1_1 not set, create a 1_0 build
OPENGLES1_1 ?= 0

# Automatically pull in OPEGLES1_1 requirements
# (But allow easy exclusion of features if 
# e.g. USER_CLIPPLANES = 0 in makeconf.build)
ifeq ($(OPENGLES1_1), 1)
    ifneq ($(TEXENVCOMBINE), 0)
        TEXENVCOMBINE = 1
    endif
    ifneq ($(TEXENVDOT3), 0)
        TEXENVDOT3 = 1
    endif
    ifneq ($(SINGLE_PRECISION), 0)
        SINGLE_PRECISION = 1
endif
    ifneq ($(USER_CLIPPLANES), 0)
        USER_CLIPPLANES = 1
    endif
endif

# We use this case to imply OPENGLES1_0
# so we explicitly disable 1_1 features
ifeq ($(OPENGLES1_1), 0)
	#TEXENVCOMBINE = 0 #FIXME breaks build
	#TEXENVDOT3 = 0 #FIXME untested
	#SINGLE_PRECISION = 0 #FIXME untested
	USER_CLIPPLANES = 0
	MATRIX_PALETTE = 0
endif

