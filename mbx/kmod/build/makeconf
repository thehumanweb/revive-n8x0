BUILD_DATA		= $(TMP)/build_data.txt


# This is the version of OpenGL-ES we're using
#
ifdef OPENGLES1_1
OPENGLES_VERSION	=	1.1
else
OPENGLES_VERSION	=	1.0
endif

# ARFLAGS pretty much doesn't need to be changed.  Replace/update archive.
#
ARFLAGS			= rus

# These are needed for linking.
#
# LINK_PATH:     this is required for all links to find required libraries.
#
# DLINK_PATH_RT: this determines where to look for shared libraries (lib*.so)
#                when a binary or shared library is loaded
#
# DLINK_PATH_CT: this determines where to look for shared libraries at compile
#                time and is required for the cross-compiling environment.
#
LINK_PATH					+= -L$(TOOLCHAIN)/lib -L$(SYSBIN)
DLINK_PATH_RT				+= /lib /usr/lib
DLINK_PATH_CT				+= $(TOOLCHAIN)/lib $(SYSBIN)


# Defaults for useful things.
#
SUPPORT_XWS		?= 1
XWS_SERVER_ONLY	?= 0

SUPPORT_OPENGL	?= 1
SUPPORT_OPENVG	?= 0

SUPPORT_BUFFER_CLASS	?= 0

