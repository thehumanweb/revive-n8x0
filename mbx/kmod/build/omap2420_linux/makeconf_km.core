# l
#  --- Revision Logs Removed --- 
#
# You need to define the MBX core revision and whether VGP is supported or not
# (variable 'VGP') in the system makeconf file (system/$(SYSTEM)/makeconf)
# only.  No other core flags (eg. 'SUPPORT_MBX1') should be set - they are set
# below in this file as a result of the core revision & VGP setting.

# 'REV51' refers to MBX1 Lite core revision 1.5.1,
# Similar reason lies behind the MBX1 revs.  The revision is located in the
# Core Revision register (at offset 0xF10).  The Core ID register (offset
# 0xF00) indicates whether the core is 'Lite'.  Refer to hwdefs/mbx1defs.h

ifdef MBX1_LITE_REV51 # 
	SUPPORT_MBX1_LITE = 1
	CORE +=  -DSUPPORT_MBX1_LITE 		\
		-DMBX1_LITE_REV51
							
ifdef VGP_LITE
	SUPPORT_VGP_LITE=1
	CORE += -DSUPPORT_VGP_LITE
		
endif

else
$(error undefined MBX1 or MBX1-Lite revision)
endif
