ifeq ($(MBX_GPL),1)

	ifeq ($(KBUILD),1)
		
		SUBDIRS	=	gpl/driver
	
	endif
	
	ifeq ($(UBUILD),1)
		
		SUBDIRS	+=	gpl/services_um \
					gpl/mbxservicesdaemon \
					gpl/mbxdaemonapp
		
		SUBDIRS += pvr2d
		
		ifeq ($(PDUMP2),1)
			SUBDIRS += 	tools/intern/debug/dbgdriv/linux \
						tools/intern/pdump
		endif

		ifeq ($(DYNAMIC_VERTEX_CODE_GEN),1)
			SUBDIRS	+=	dvcgen
		endif

		SUBDIRS	+=	egl \
		
		ifeq ($(EGL1_2),1)
			SUBDIRS	+=	eglcommon
		endif
		
		ifeq ($(SUPPORT_BUFFER_CLASS),1)
			SUBDIRS +=	3rdparty/example_camera/kernel				\
						3rdparty/example_camera/client
		endif
		
		ifeq ($(SUPPORT_OPENGL),1)
			SUBDIRS	+=	opengles
		endif

		ifeq ($(SUPPORT_OPENVG),1)
			SUBDIRS	+=	vgu
			SUBDIRS	+=	openvg
		endif

		SUBDIRS	+=	wsegl/null_linux \
					wsegl/null_linux_flip

		OPK_SUBDIRS = 	wsegl/null_linux \
						wsegl/null_linux_flip
				
				
		# For the X11 window system, we add the following sub-directories
		#
		ifeq ($(SUPPORT_XWS),1)
			SUBDIRS	+=	wsegl/x11_linux
			OPK_SUBDIRS +=	wsegl/x11_linux
		endif
		
		ifeq ($(SUPPORT_UNITTESTS),1)
			SUBDIRS	+=	unittests/services_test \
						unittests/pvr2d_test2 \
						unittests/power_test

			ifeq ($(SUPPORT_BUFFER_CLASS),1)
				SUBDIRS +=	unittests/bufferclass_test/sw_camera_ctrl	\
							unittests/bufferclass_test/ogles_camera_ext
			endif

			ifeq ($(SUPPORT_XWS),1)
				SUBDIRS	+=	unittests/xtest
			
			ifeq ($(SUPPORT_OPENGL),1)
				SUBDIRS	+=	unittests/xegltest
			endif
			
			ifeq ($(SUPPORT_OPENVG),1)
				SUBDIRS	+=	unittests/xovg_test
			endif
		endif

		ifeq ($(SUPPORT_OPENGL),1)
			SUBDIRS	+=	unittests/egl_test \
						unittests/glinfo
		endif

		ifeq ($(SUPPORT_OPENVG),1)
			SUBDIRS	+=	unittests/ovg_demos \
						unittests/linux_ovg_test
		endif
	endif
		
		
	endif
	
else
	
	SUBDIRS	=	services \
				services_um
	
	SUBDIRS += pvr2d

	ifeq ($(PDUMP2),1)
		SUBDIRS += tools/intern/debug/dbgdriv/linux \
					tools/intern/pdump
	endif
	
	ifeq ($(DYNAMIC_VERTEX_CODE_GEN),1)
		SUBDIRS	+=	dvcgen
	endif

	SUBDIRS	+=	egl \
	
	ifeq ($(EGL1_2),1)
		SUBDIRS	+=	eglcommon
	endif
	
	ifeq ($(SUPPORT_BUFFER_CLASS),1)
		SUBDIRS +=	3rdparty/example_camera/kernel				\
					3rdparty/example_camera/client
	endif
	
	ifeq ($(SUPPORT_OPENGL),1)
		SUBDIRS	+=	opengles
	endif

	ifeq ($(SUPPORT_OPENVG),1)
		SUBDIRS	+=	vgu
		SUBDIRS	+=	openvg
	endif

	SUBDIRS	+=	wsegl/null_linux \
				wsegl/null_linux_flip
				
	OPK_SUBDIRS = 	wsegl/null_linux \
				wsegl/null_linux_flip

	# For the X11 window system, we add the following sub-directories
	#
	ifeq ($(SUPPORT_XWS),1)
		SUBDIRS	+=	wsegl/x11_linux
		OPK_SUBDIRS +=	wsegl/x11_linux
	endif
	
	ifeq ($(SUPPORT_UNITTESTS),1)
		SUBDIRS	+=	unittests/services_test \
					unittests/pvr2d_test2 \
					unittests/power_test

		ifeq ($(SUPPORT_BUFFER_CLASS),1)
			SUBDIRS +=	unittests/bufferclass_test/sw_camera_ctrl	\
						unittests/bufferclass_test/ogles_camera_ext
		endif

		ifeq ($(SUPPORT_XWS),1)
			SUBDIRS	+=	unittests/xtest
			
			ifeq ($(SUPPORT_OPENGL),1)
				SUBDIRS	+=	unittests/xegltest
			endif
			
			ifeq ($(SUPPORT_OPENVG),1)
				SUBDIRS	+=	unittests/xovg_test
			endif
		endif

		ifeq ($(SUPPORT_OPENGL),1)
			SUBDIRS	+=	unittests/egl_test \
						unittests/glinfo
		endif

		ifeq ($(SUPPORT_OPENVG),1)
			SUBDIRS	+=	unittests/ovg_demos \
						unittests/linux_ovg_test
		endif
	endif
	
endif

SUBDIRS += $(EXTRA_SUBDIRS)
