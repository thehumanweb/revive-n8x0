# Main rule - "all" comes first so other defined rules don't become the
# default.
#
all: show_settings
	$(SILENT)$(MAKE) $(MAKE_OPT) subdirs TARGET=$@
	$(SILENT)$(MAKE) $(MAKE_OPT) scripts

# Include make settings and rules.
#
include makeconf.build
include ../makeconf

package: show_settings
	$(SILENT)$(MAKE) $(MAKE_OPT) subdirs TARGET=$@
	$(SILENT)$(MAKE) $(MAKE_OPT) scripts

#
# target for creating stripped release builds with
# debug symbols in separate files.  All .so and .dbg
# files are removed prior to the build - without this
# all .so files that haven't changed since the last build
# will cause i386objcopy to fail to add the debug link
#

symbolpackage: show_settings
	$(SILENT)$(RM) $(SYSBIN)/*.so
	$(SILENT)$(RM) $(SYSBIN)/*.dbg
	$(SILENT)$(MAKE) $(MAKE_OPT) subdirs TARGET=$@
	$(SILENT)$(MAKE) $(MAKE_OPT) scripts

install: all
ifeq ($(SUPPORT_XWS),1)
	$(SILENT)(cd $(SYSBIN); \
				if [ -d $(SYSFDO) ]; then \
					./install.sh; \
				else \
					echo; \
					echo "X Window system not present for this install" 2>&1; \
					./install.sh --no-x; \
				fi)
else
	$(SILENT)(cd $(SYSBIN); ./install.sh)
endif


# OEM Porting Kit support.
#
opk:
	$(ECHO) "! TARGET=$(TARGET)"
	$(ECHO) "!"
	$(SILENT)$(MAKE) $(OPK_SUBDIRS)
	

uninstall: scripts
	$(SILENT)(cd $(SYSBIN); ./install.sh --uninstall)


# Determine PVR_BUILD_DIR automatically from the directory from which we're
# invoked.  The use of $(notdir ..) here actually strips away the leading
# components of the current directory here.  We export this so it's passed to
# sub-makes automatically.
#
export	PVR_BUILD_DIR = $(notdir $(shell pwd))

KFLAG	= $(findstring -k,$(MAKEFLAGS))
MBX_GPL ?= 0
KBUILD ?= 0
UBUILD ?= 0
LOAD_DAEMON ?= 0
PVR_KERNEL_MODULE = rc.pvr

ifeq ($(KBUILD),1)
ifeq ($(UBUILD),1)
	LOAD_DAEMON = 1
endif
endif

ifeq ($(MBX_GPL),1)
ifeq ($(KBUILD),1)
	RC_INSTALL_SCRIPT = ../scripts/rc.mbxaccess.m4
endif
else
	RC_INSTALL_SCRIPT = ../scripts/rc.pvr.m4
endif

# M4DEFS is required to determine how the auto-generation is performed.
# M4FLAGS is optional and should only be defined for debugging purposes.
#
M4DEFS	= -DKM_SUFFIX=$(KM_SUFFIX) \
			-DLIB_SUFFIX=$(LIB_SUFFIX) \
			-DKERNEL_ID=$(KERNEL_ID) \
			-DPVRVERSION=$(PVRVERSION) \
			-DPVR_BUILD_DIR=$(PVR_BUILD_DIR) \
			-DBUILD=$(BUILD) \
			-DSOLIB_VERSION=$(SOLIB_VERSION) \
			-DSUPPORT_XWS=$(SUPPORT_XWS) \
			-DSUPPORT_OPENVG=$(SUPPORT_OPENVG) \
			-DSUPPORT_UNITTESTS=$(SUPPORT_UNITTESTS) \
			-DPROFILE_COMMONLITE=$(PROFILE_COMMONLITE) \
			-DEGL1_2=$(EGL1_2) \
			-DMBX_GPL=$(MBX_GPL) \
			-DKBUILD=$(KBUILD) \
			-DUBUILD=$(UBUILD) \
			-DLOAD_DAEMON=$(LOAD_DAEMON) \
			-DSUPPORT_BUFFER_CLASS=$(SUPPORT_BUFFER_CLASS) \
			-DPVR_KERNEL_MODULE=$(PVR_KERNEL_MODULE) \
			-DPDUMP2=$(PDUMP2) \
			-DMBXACCESS_DEVICE=$(MBXACCESS_DEVICE)

M4FLAGS	= #-dtalxfi

# The scripts all depend upon these, which cause a regeneration on any
# changes.
#
SCRIPT_DEPS	= ../scripts/common.m4	\
				install.m4	\
				makeconf.build	\
				../makeconf.build	\
				$(PVR_CONSUMER_ROOT)/include/pvrversion.h

ifeq ($(MBX_GPL),1)
ifeq ($(KBUILD),1)
BUILD_PVR_KERNEL_MODULE = $(SYSBIN)/$(PVR_KERNEL_MODULE)
endif
else
BUILD_PVR_KERNEL_MODULE = $(SYSBIN)/$(PVR_KERNEL_MODULE)
endif

# Perform build(s) as if for the automated build system
#
# BUILD_TARGETS		what to build (all, xserver etc. don't use install)
#
# TARGETS			the platforms to build.
#
# BUILDS			the build types (release, timing, debug)
#
# It's very much a BAD IDEA(tm) to mix targets that have different
# compilers and/or kernels 
#
ifeq ($(SUPPORT_XWS),1)
BUILD_TARGETS	= libx11 all fdo
else
BUILD_TARGETS	= all
endif

TARGETS		?= $(PVR_BUILD_DIR)
BUILDS		?= $(BUILD)

.PHONY: _build
_build:
	$(SILENT)$(MAKE) $(BUILD_TARGETS)

.PHONY: build
build:
	$(SILENT)if [ -z "$(BUILDS)" -a -z "$(TARGETS)" ]; then \
		echo "build rule requires non-NULL settings for TARGETS and BUILDS"; \
		exit 1; \
	fi
	$(SILENT)for target in $(TARGETS); do \
		for build in $(BUILDS); do \
			$(MAKE) -C $(PVR_CONSUMER_ROOT)/build/$$target \
						$(MAKE_OPT) _build BUILD=$$build || \
			([ -z "$(KFLAG)" ] && exit 1); \
		done; \
	done


.PHONY: subdirs $(SUBDIRS)
subdirs: buildcheck
	$(ECHO) "! TARGET=$(TARGET)"
	$(ECHO) "!"
	$(SILENT)$(MAKE) $(SUBDIRS)


%:
	$(ECHO) "+$@"
	$(SILENT)$(MAKE) -C $(PVR_CONSUMER_ROOT)/$@ \
			-f $(PVR_CONSUMER_ROOT)/build/makeconf.alt \
			$(MAKE_OPT) $(TARGET) || \
		([ -z "$(KFLAG)" ] && exit 1)
	$(ECHO) "-$@"


# Construct rc.pvr from a template.
#
$(SYSBIN)/rc.pvr: $(RC_INSTALL_SCRIPT) $(SCRIPT_DEPS)
	$(ECHO) "Creating $@"
	$(SILENT)$(TOUCH) $@
ifeq ($(MBX_GPL),1)
ifeq ($(KBUILD),1)
	$(SILENT)$(M4) $(M4FLAGS) $(M4DEFS) ../../build/scripts/rc.mbxaccess.m4 install.m4 > $@
endif
else
	$(SILENT)$(M4) $(M4FLAGS) $(M4DEFS) ../scripts/rc.pvr.m4 install.m4 > $@
endif
	$(SILENT)$(DOS2UNIX) $@ 2>/dev/null
	$(SILENT)$(CHMOD) +x $@

$(SYSBIN)/rc.mbxaccess: ../../gpl/build/scripts/rc.mbxaccess.m4 $(SCRIPT_DEPS) install.m4
	$(ECHO) "Creating $@"
	$(SILENT)$(TOUCH) $@
	$(SILENT)$(M4) $(M4FLAGS) $(M4DEFS) ../../gpl/build/scripts/rc.mbxaccess.m4 install.m4 > $@
	$(SILENT)$(DOS2UNIX) $@ 2>/dev/null
	$(SILENT)$(CHMOD) +x $@

# Construct install.sh from a template.
#
$(SYSBIN)/install.sh: ../scripts/install.sh.m4 $(SCRIPT_DEPS)
	$(ECHO) "Creating $@"
	$(SILENT)$(TOUCH) $@
	$(SILENT)$(M4) $(M4FLAGS) $(M4DEFS) ../scripts/install.sh.m4 install.m4 > $@
	$(SILENT)$(DOS2UNIX) $@ 2>/dev/null
	$(SILENT)$(CHMOD) +x $@

$(SYSBIN)/checkpackage.sh: ../scripts/checkpackage.m4 $(SCRIPT_DEPS)
	$(ECHO) "Creating $@"
	$(SILENT)$(TOUCH) $@
	$(SILENT)$(M4) $(M4FLAGS) $(M4DEFS) ../scripts/checkpackage.m4 install.m4 > $@
	$(SILENT)$(DOS2UNIX) $@ 2>/dev/null
	$(SILENT)$(CHMOD) +x $@
	
.PHONY: scripts
scripts: $(SYSBIN)/install.sh $(BUILD_PVR_KERNEL_MODULE)

checkpackage: scripts $(SYSBIN)/checkpackage.sh
	@-echo "Checking package content"
	$(SILENT)(cd $(SYSBIN); \
				if [ -f ./checkpackage.sh ]; then \
					./checkpackage.sh; \
					 $(RM) -rf ./checkpackage.sh; \
				fi)

# Rules for FreeDesktop.Org (fdo) version of X Window System Version 11
#
.PHONY: X fdo fdo_clean fdo_clobber libX11 libx11 xserver xapps
xwscheck:
	@if [ "$(SUPPORT_XWS)" != 1 ]; then \
		echo "This is only applicable for X window system builds."; \
		exit 1; \
	fi

X fdo fdo_clean fdo_clobber libX11 libx11 xserver xapps: xwscheck
	$(SILENT)$(MAKE) $(MAKE_OPT) -C $(FDO) \
			SILENT=$(SILENT) \
			DDK_BINARY_DIR=$(SYSBIN) \
			BUILD=$(BUILD) \
			CC=$(CC) \
                        ARCH_CFLAGS="$(ARCH_CFLAGS)" \
			TARGET=$(PVR_BUILD_DIR) \
			XSERVER_ONLY=$(XWS_SERVER_ONLY) $@


# Rules for khronos EGL conformance tests.
#
CONFORMES=$(PVR_CONSUMER_ROOT)/tests/khronos/conformes
CONFORMES_DEST=$(DISCIMAGE)/usr/local/bin
GLES_DIR=$(PVR_CONSUMER_ROOT)/tests/khronos/GLES

$(GLES_DIR):
	$(DO_MKDIR)

_conformes: $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/opengles/drvgl.h $(GLES_DIR)/gl.h
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/opengles/drvgl.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/opengles/drvgl1_0.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/opengles/drvgl1_1.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/include/drvegl1_0.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/include/drvegl1_1.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/include/drvegl1_2.h $(GLES_DIR)
	$(SILENT)$(SED) -e 's,drvgl\.h,gl.h,' < $(PVR_CONSUMER_ROOT)/include/drvegl.h >$(GLES_DIR)/egl.h
	$(SILENT)$(LN) -sf $(PVR_CONSUMER_ROOT)/include/drvegltypes.h $(GLES_DIR)
	$(SILENT)$(LN) -sf $(SYSBIN)/libGLES*.so $(GLES_DIR)

.PHONY: conformes
conformes: all _conformes
	$(ECHO) "!"
	$(ECHO) "! The Khronos tests in this tree are not up-to-date, so this test facility"
	$(ECHO) "! is not supported.  You will have to install binaries manually by copying them"
	$(ECHO) "! from $(CONFORMES)/conform"
	$(ECHO) "!"
	$(MAKE) -C $(CONFORMES) -f GNUmakefile \
				CONFORMES=$(CONFORMES) \
				OPENGLES1_1=$(OPENGLES1_1) \
				PROFILE_COMMONLITE=$(PROFILE_COMMONLITE) \
				CC="$(CROSS_COMPILE)gcc $(SYS_CFLAGS.1) $(SYS_INCLUDES)" \
				LD="$(CROSS_COMPILE)gcc -L$(TOOLCHAIN)/lib $(CROSSPLATFORM_LIBS) -Wl,-rpath-link=$(SYSBIN)"

conformes_install: conformes
	$(SILENT)for file in covgl covegl primtest conform; do \
		echo "Copying $$file to $(CONFORMES_DEST)"; \
		$(CP) $(CONFORMES)/conform/$$file/$$file $(CONFORMES_DEST); \
	done
							
conformes_clean:
	$(RM) -r $(GLES_DIR)
	$(MAKE) -C $(CONFORMES) -f GNUmakefile CONFORMES=$(CONFORMES) clean
	
conformes_clobber:
	$(RM) -r $(GLES_DIR)
	$(MAKE) -C $(CONFORMES) -f GNUmakefile CONFORMES=$(CONFORMES) clobber


# Rules for the Linux kernel
#
.PHONY: kernel kernel_clean clean_kernel
kernel:
	$(SILENT)(cd $(KERNELDIR); $(MAKE) vmlinux zImage modules)

kernel_clean clean_kernel:
	$(SILENT)(cd $(KERNELDIR); $(MAKE) clean)
	

# Rules for tidying stuff up.
#
clean:
	$(ECHO) "! BUILD=$(BUILD) PVR_BUILD_DIR=$(PVR_BUILD_DIR)"
	$(ECHO) "!"
	$(SILENT)$(MAKE) $(MAKE_OPT) subdirs TARGET=clean
	$(SILENT)$(RM) $(SYSBIN)/install.sh
	$(SILENT)$(RM) $(SYSBIN)/rc.pvr

clobber:
	$(ECHO) "! BUILD=*all* PVR_BUILD_DIR=*all*"
	$(ECHO) "!"
	$(SILENT)$(MAKE) $(MAKE_OPT) subdirs TARGET=clobber
	$(SILENT)$(RM) -r $(_SYSBIN)_*
	$(SILENT)-find $(PVR_CONSUMER_ROOT) -name "*~" -exec $(RM) \;


opk_clean:
	$(ECHO) "! BUILD=$(BUILD) PVR_BUILD_DIR=$(PVR_BUILD_DIR)"
	$(ECHO) "!"
	$(SILENT)$(MAKE) $(MAKE_OPT) $(OPK_SUBDIRS) TARGET=clean


# Rules for make cscope file lists
#
.PHONY: cscope kscope cscope.files

cscope.files:
	$(SILENT)$(RM) $@
	$(ECHO) "-p4" > $@
	$(SILENT)$(FIND) $(PVR_CONSUMER_ROOT) -type f \
		\( -name make\* -o -name \*.[chsS] \) \
		! -name \*.o ! -name \*.depend \
		-print >> $@

cscope: cscope.files

kscope: cscope.files
ifdef KERNELDIR
	$(SILENT)$(FIND) $(KERNELDIR) -type f \
		\( -name Make\* -o -name \*.[chsS] \) \
		-print >> cscope.files
else
	$(ECHO) "Must set KERNEL ter for $@ to work."
endif


# These are the standard sub-directories for all targets.  The
# SUBDIRS macro is now out-of-bounds to other makefiles.
#

include ../makeconf.dir




###########################################################################################
###########################################################################################

checkexportlist: all checkpackage
	$(SILENT)$(RM) -f expected_resolved_ogl.txt expected_resolved_egl.txt
ifeq ($(SUPPORT_OPENVG),1)
	$(SILENT)$(RM) -f expected_resolved_ovg.txt
	$(SILENT)$(RM) -f expected_resolved_ovgu.txt
endif

#
# EGL 1.0 FUNCTIONS
#
	$(SILENT) $(ECHO) eglChooseConfig >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglCopyBuffers >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglCreateContext >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglCreatePbufferSurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglCreatePixmapSurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglCreateWindowSurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglDestroyContext >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglDestroySurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetConfigAttrib >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetConfigs >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetCurrentContext >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetCurrentDisplay >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetCurrentSurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetDisplay >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetError >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglGetProcAddress >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglInitialize >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglMakeCurrent >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglQueryContext >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglQueryString >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglQuerySurface >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglSwapBuffers >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglTerminate >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglWaitGL >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglWaitNative >> expected_resolved_egl.txt

#
# EGL 1.1 FUNCTIONS
#
ifeq ("$(EGL1_1)", "1")
	$(SILENT) $(ECHO) eglBindTexImage >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglSwapInterval >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglReleaseTexImage >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglSurfaceAttrib >> expected_resolved_egl.txt
endif # EGL1_1


#
# EGL 1.2 FUNCTIONS
#
ifeq ("$(EGL1_2)", "1")
	$(SILENT) $(ECHO) eglBindTexImage >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglSwapInterval >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglReleaseTexImage >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglSurfaceAttrib >> expected_resolved_egl.txt
endif # EGL1_2

#
# Take a copy of just the expected egl functions in ogles
#
	$(SILENT) $(CP) expected_resolved_egl.txt expected_resolved_ogl.txt


ifeq ("$(EGL1_2)", "1")
	$(SILENT) $(ECHO) eglCreatePbufferFromClientBuffer >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglBindAPI >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglQueryAPI >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglWaitClient >> expected_resolved_egl.txt
	$(SILENT) $(ECHO) eglReleaseThread >> expected_resolved_egl.txt
endif # EGL1_2

#
# OPENGLES 1.0 COMMONLITE FUNCTIONS
#
	$(SILENT) $(ECHO) glActiveTexture >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glAlphaFuncx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glBindTexture >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glBlendFunc >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClear >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClearColorx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClearDepthx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClearStencil >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClientActiveTexture >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glColor4x >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glColorMask >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glColorPointer >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glCompressedTexImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glCompressedTexSubImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glCopyTexImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glCopyTexSubImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glCullFace >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDeleteTextures >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDepthFunc >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDepthMask >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDepthRangex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDisable >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDisableClientState >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDrawArrays >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDrawElements >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glEnable >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glEnableClientState >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFinish >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFlush >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFogx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFogxv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFrontFace >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFrustumx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glGenTextures >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glGetError >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glGetIntegerv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glGetString >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glHint >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLightModelx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLightModelxv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLightx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLightxv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLineWidthx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLoadIdentity >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLoadMatrixx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glLogicOp >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glMaterialx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glMaterialxv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glMatrixMode >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glMultMatrixx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glMultiTexCoord4x >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glNormal3x >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glNormalPointer >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glOrthox >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glPixelStorei >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glPointSizex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glPolygonOffsetx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glPopMatrix >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glPushMatrix >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glReadPixels >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glRotatex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glSampleCoveragex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glScalex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glScissor >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glShadeModel >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glStencilFunc >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glStencilMask >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glStencilOp >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexCoordPointer >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexEnvx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexEnvxv >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexParameterx >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTexSubImage2D >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glTranslatex >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glVertexPointer >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glViewport >> expected_resolved_ogl.txt

#
# OPENGLES 1.0 COMMON FUNCTIONS
#
ifneq ("$(PROFILE_COMMONLITE)", "1")
	$(SILENT) $(ECHO) glAlphaFunc >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClearColor >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glClearDepthf >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glColor4f >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glDepthRangef >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFogf >> expected_resolved_ogl.txt
	$(SILENT) $(ECHO) glFogfv >> expected_resolved_ogl.txt
