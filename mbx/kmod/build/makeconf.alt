# The "all" rule.  This should come here before other rules so that the default
# target is not inferred.
#
.PHONY: all
all: target

# Include build specific settings here.
#
include $(PVR_CONSUMER_ROOT)/build/$(PVR_BUILD_DIR)/makeconf.build

# Include core specific settings here - this expands on the .build settings.
#
ifeq ($(MBX_GPL),1)
ifeq ($(UBUILD),1)
include $(PVR_CONSUMER_ROOT)/build/$(PVR_BUILD_DIR)/makeconf.core
MAKECONF_CORE = makeconf.core
else
include $(PVR_CONSUMER_ROOT)/build/$(PVR_BUILD_DIR)/makeconf_km.core
MAKECONF_CORE = makeconf_km.core
endif
else
include $(PVR_CONSUMER_ROOT)/build/$(PVR_BUILD_DIR)/makeconf.core
MAKECONF_CORE = makeconf.core
endif

# Include the local module settings.
#
include makefile.alt

# Include generic build settings and rules now.
#
include $(PVR_CONSUMER_ROOT)/build/makeconf
