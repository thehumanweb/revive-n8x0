+/* A second card behind a board's slot switch (e.g. the N810's eMMC) */
+void omap_mmc_add_slot(struct omap_mmc_s *s, BlockBackend *blk)
+{
+    s->slot[1] = sd_init(blk, false);
+    if (s->slot[1] == NULL) {
+        exit(1);
+    }
+    sd_enable(s->slot[1], 0);
+}
+
+/* Route the controller to slot 0 or 1; with no card in 1, to nothing */
+void omap_mmc_select_slot(struct omap_mmc_s *s, int slot)
+{
+    if (slot && s->slot[1]) {
+        sd_enable(s->slot[0], 0);
+        s->card = s->slot[1];
+        sd_enable(s->card, 1);
+    } else if (slot) {
+        sd_enable(s->card, 0);
+    } else {
+        if (s->slot[1]) {
+            sd_enable(s->slot[1], 0);
+        }
+        s->card = s->slot[0];
+        sd_enable(s->card, 1);
+    }
+}
+
