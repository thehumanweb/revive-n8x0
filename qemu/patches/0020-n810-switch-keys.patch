n810: keys toggle the keyboard slide, lock and headphone switches

The N810 GPIO switches (slide, kb_lock, headphone) had fixed levels:
the slide opened at reset, the lock and headphone lines low, which on
the device means locked and headphones plugged in. Start them as on the
device at rest (high: slide open, unlocked, nothing plugged in) and let
F9 (slide), F10 (lock) and F11 (headphone) toggle them, e.g. with the
monitor sendkey command, so the guest can see switch changes.

QEMU 9.1.3: Against 9.1's braced if/else.

diff --git a/hw/arm/nseries.c b/hw/arm/nseries.c
index 310abe3c0..7246190a0 100644
--- a/hw/arm/nseries.c
+++ b/hw/arm/nseries.c
@@ -62,6 +62,7 @@ struct n800_s {
 
     int keymap[0x80];
     DeviceState *kbd;
+    int switches;	/* N8X0_SW_* levels */
 
     DeviceState *usb;
     void *retu;
@@ -320,6 +321,19 @@ static void n810_tsc_setup(struct n800_s *s)
     tsc2005_set_transform(s->ts.opaque, &n810_pointercal);
 }
 
+/* Keys that toggle the N810's switches (GPIO levels), e.g. by "sendkey":
+ * F9 the keyboard slide, F10 the lock switch, F11 the headphone jack */
+#define N810_SLIDE_KEYCODE	67	/* F9 */
+#define N810_KB_LOCK_KEYCODE	68	/* F10 */
+#define N8X0_HEADPHONE_KEYCODE	87	/* F11 */
+
+static void n8x0_switch_toggle(struct n800_s *s, int line)
+{
+    s->switches ^= 1 << (line & 31);
+    qemu_set_irq(qdev_get_gpio_in(s->mpu->gpio, line),
+                 (s->switches >> (line & 31)) & 1);
+}
+
 /* N810 Keyboard controller */
 static void n810_key_event(void *opaque, int keycode)
 {
@@ -329,6 +343,14 @@ static void n810_key_event(void *opaque, int keycode)
     if (code == -1) {
         if ((keycode & 0x7f) == RETU_KEYCODE) {
             retu_key_event(s->retu, !(keycode & 0x80));
+        } else if (keycode & 0x80) {
+            return;
+        } else if (keycode == N810_SLIDE_KEYCODE) {
+            n8x0_switch_toggle(s, N810_SLIDE_GPIO);
+        } else if (keycode == N810_KB_LOCK_KEYCODE) {
+            n8x0_switch_toggle(s, N810_KB_LOCK_GPIO);
+        } else if (keycode == N8X0_HEADPHONE_KEYCODE) {
+            n8x0_switch_toggle(s, N8X0_HEADPHONE_GPIO);
         }
         return;
     }
@@ -1089,9 +1111,16 @@ static void n8x0_boot_init(void *opaque)
     /* CPU setup */
     s->mpu->cpu->env.GE = 0x5;
 
-    /* If the machine has a slided keyboard, open it */
+    /* If the machine has a slided keyboard, open it; and, as on the
+     * device at rest, no headphones (the switch is low when plugged in)
+     * and the lock switch off (low when locked) */
     if (s->kbd) {
+        s->switches = (1 << (N810_SLIDE_GPIO & 31)) |
+                      (1 << (N810_KB_LOCK_GPIO & 31)) |
+                      (1 << (N8X0_HEADPHONE_GPIO & 31));
         qemu_irq_raise(qdev_get_gpio_in(s->mpu->gpio, N810_SLIDE_GPIO));
+        qemu_irq_raise(qdev_get_gpio_in(s->mpu->gpio, N810_KB_LOCK_GPIO));
+        qemu_irq_raise(qdev_get_gpio_in(s->mpu->gpio, N8X0_HEADPHONE_GPIO));
     }
 }
 
