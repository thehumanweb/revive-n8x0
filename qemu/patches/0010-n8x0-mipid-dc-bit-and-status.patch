n8x0: MIPID panel: D/C bit, sleep-out status bits, state left by NOLO

- 9-bit words with D/C (bit 8) set are parameters: stored if the command
  takes more, otherwise ignored. They used to be taken as commands
  (e.g. COLMOD's 0x170 logged "unknown command"); a word with D/C clear
  always starts a new command. Shorter words are read cycles and leave
  the command state alone.
- COLMOD (0x3a) takes its parameter.
- RDDST bit 17 and RDDPM bit 4 are "sleep out"; the model reported the
  sleep state the other way round. RDDPM bit 6 (idle) is 0.
- When QEMU stands in for the bootloader (-kernel), leave the panel as
  NOLO does: booster on, out of sleep (self-diagnosis bit flipped),
  display on.

QEMU 9.1.3: Against 9.1's braced if/else.

diff --git a/hw/arm/nseries.c b/hw/arm/nseries.c
index dff01c4ca..2f10d9eb7 100644
--- a/hw/arm/nseries.c
+++ b/hw/arm/nseries.c
@@ -65,6 +65,7 @@ struct n800_s {
     DeviceState *usb;
     void *retu;
     void *tahvo;
+    void *mipid;
     DeviceState *nand;
 };
 
@@ -478,10 +479,19 @@ static uint32_t mipid_txrx(void *opaque, uint32_t cmd, int len)
     } else {
         ret = s->resp[s->p++];
     }
-    if (s->pm-- > 0) {
-        s->param[s->pm] = cmd;
+
+    /* Shorter words are read cycles; the panel ignores its input then */
+    if (len < 9)
+        return ret;
+
+    /* 9-bit words: D/C (bit 8) set for parameters, clear for a command */
+    if (cmd & 0x100) {
+        if (s->pm <= 0)
+            return ret;			/* Not expecting one: ignored */
+        s->param[-- s->pm] = cmd & 0xff;
     } else {
         s->cmd = cmd;
+        s->pm = -1;
     }
 
     switch (s->cmd) {
@@ -520,7 +530,7 @@ static uint32_t mipid_txrx(void *opaque, uint32_t cmd, int len)
         s->p = 0;
         s->resp[0] = s->booster << 7;
         s->resp[1] = (5 << 4) | (s->partial << 2) |
-                (s->sleep << 1) | s->normal;
+                (!s->sleep << 1) | s->normal;	/* D17: sleep out */
         s->resp[2] = (s->vscr << 7) | (s->invert << 5) |
                 (s->onoff << 2) | (s->te << 1) | (s->gamma >> 2);
         s->resp[3] = s->gamma << 6;
@@ -528,8 +538,8 @@ static uint32_t mipid_txrx(void *opaque, uint32_t cmd, int len)
 
     case 0x0a:	/* RDDPM */
         s->p = 0;
-        s->resp[0] = (s->onoff << 2) | (s->normal << 3) | (s->sleep << 4) |
-                (s->partial << 5) | (s->sleep << 6) | (s->booster << 7);
+        s->resp[0] = (s->onoff << 2) | (s->normal << 3) | (!s->sleep << 4) |
+                (s->partial << 5) | (s->booster << 7);	/* D4: sleep out */
         break;
     case 0x0b:	/* RDDMADCTR */
         s->p = 0;
@@ -637,9 +647,13 @@ static uint32_t mipid_txrx(void *opaque, uint32_t cmd, int len)
 
     case 0x38:	/* IDMOFF */
     case 0x39:	/* IDMON */
-    case 0x3a:	/* COLMOD */
         goto bad_cmd;
 
+    case 0x3a:	/* COLMOD */
+        if (s->pm < 0)
+            s->pm = 1;
+        break;
+
     case 0xb0:	/* CLKINT / DISCTL */
     case 0xb1:	/* CLKEXT */
         if (s->pm < 0) {
@@ -711,13 +725,24 @@ static void *mipid_init(void)
     return s;
 }
 
+/* As the bootloader leaves the panel: out of sleep, display on */
+static void mipid_boot_init(void *opaque)
+{
+    struct mipid_s *s = (struct mipid_s *) opaque;
+
+    mipid_reset(s);
+    s->booster = 1;
+    s->sleep = 0;
+    s->selfcheck ^= 1 << 6;	/* POFF self-diagnosis Ok */
+}
+
 static void n8x0_spi_setup(struct n800_s *s)
 {
     void *tsc = s->ts.opaque;
-    void *mipid = mipid_init();
 
+    s->mipid = mipid_init();
     omap_mcspi_attach(s->mpu->mcspi[0], s->ts.txrx, tsc, 0);
-    omap_mcspi_attach(s->mpu->mcspi[0], mipid_txrx, mipid, 1);
+    omap_mcspi_attach(s->mpu->mcspi[0], mipid_txrx, s->mipid, 1);
 }
 
 /* This task is normally performed by the bootloader.  If we're loading
@@ -1046,6 +1071,7 @@ static void n8x0_boot_init(void *opaque)
 
     /* Video setup */
     n800_dss_init(&s->blizzard);
+    mipid_boot_init(s->mipid);
 
     /* CPU setup */
     s->mpu->cpu->env.GE = 0x5;
