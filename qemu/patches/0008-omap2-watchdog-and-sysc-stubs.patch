omap2: model the WDT2 watchdog; SYSCONFIG/SYSSTATUS stubs for sham, aes, hdq1w

Nothing was mapped at 0x48022000, so Linux's omap_wdt (and Maemo's kicker)
drove a watchdog that didn't exist, its hwmod soft reset never completed,
and a dead kicker could never reset the machine. Model WDT2: 32 kHz counter
with prescaler (WCLR), WLDR/WTGR reload, WSPR start/stop sequences,
RESETDONE, and a machine reset on overflow. It starts stopped, as NOLO
leaves it. SHA1/MD5, AES and HDQ/1-wire get SYSCONFIG/SYSSTATUS only, so
their soft resets complete.

QEMU 9.1.3: NANOSECONDS_PER_SECOND; qemu_system_reset_request() takes a cause.

diff --git a/hw/arm/omap2.c b/hw/arm/omap2.c
index fad768b8a..417e6050f 100644
--- a/hw/arm/omap2.c
+++ b/hw/arm/omap2.c
@@ -1854,6 +1854,198 @@ static struct omap_prcm_s *omap_prcm_init(struct omap_target_agent_s *ta,
     return s;
 }
 
+/* OMAP2 watchdog timer (WDT2, the MPU watchdog Linux's omap_wdt drives).
+ * A 32 kHz up-counter with prescaler; overflow resets the machine. Starts
+ * stopped, as NOLO leaves it. */
+struct omap2_wdt_s {
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint32_t sysconfig;
+    uint32_t wclr;
+    uint32_t wldr;
+    uint32_t wtgr;
+    uint32_t wspr;
+    uint32_t wier;
+    uint32_t count;     /* counter at 'base_ns' */
+    int64_t base_ns;
+    int running;
+};
+
+static int64_t omap2_wdt_tick_ns(struct omap2_wdt_s *s)
+{
+    int div = (s->wclr & 0x20) ? 1 << ((s->wclr >> 2) & 7) : 1;  /* PRE, PTV */
+    return muldiv64(div, NANOSECONDS_PER_SECOND, 32768);
+}
+
+static uint32_t omap2_wdt_counter(struct omap2_wdt_s *s)
+{
+    if (!s->running)
+        return s->count;
+    return s->count + (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->base_ns) /
+                      omap2_wdt_tick_ns(s);
+}
+
+static void omap2_wdt_load(struct omap2_wdt_s *s, uint32_t count)
+{
+    s->count = count;
+    s->base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (s->running)
+        timer_mod(s->timer, s->base_ns +
+                  (int64_t) (0x100000000ULL - count) * omap2_wdt_tick_ns(s));
+    else
+        timer_del(s->timer);
+}
+
+static void omap2_wdt_expired(void *opaque)
+{
+    fprintf(stderr, "omap2_wdt: watchdog expired, resetting\n");
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+}
+
+static void omap2_wdt_reset(struct omap2_wdt_s *s)
+{
+    s->sysconfig = 0;
+    s->wclr = 0x20;             /* PRE, PTV 0 */
+    s->wldr = 0xfffb0000;
+    s->wtgr = 0;
+    s->wspr = 0;
+    s->wier = 0;
+    s->running = 0;
+    omap2_wdt_load(s, s->wldr);
+}
+
+static uint64_t omap2_wdt_read(void *opaque, hwaddr addr, unsigned size)
+{
+    struct omap2_wdt_s *s = opaque;
+
+    switch (addr) {
+    case 0x00:  return 0x10;            /* WIDR */
+    case 0x10:  return s->sysconfig;    /* WD_SYSCONFIG */
+    case 0x14:  return 1;               /* WD_SYSSTATUS: RESETDONE */
+    case 0x18:  return 0;               /* WISR */
+    case 0x1c:  return s->wier;         /* WIER */
+    case 0x24:  return s->wclr;         /* WCLR */
+    case 0x28:  return omap2_wdt_counter(s);    /* WCRR */
+    case 0x2c:  return s->wldr;         /* WLDR */
+    case 0x30:  return s->wtgr;         /* WTGR */
+    case 0x34:  return 0;               /* WWPS: no writes pending */
+    case 0x48:  return s->wspr;         /* WSPR */
+    }
+    OMAP_BAD_REG(addr);
+    return 0;
+}
+
+static void omap2_wdt_write(void *opaque, hwaddr addr, uint64_t value,
+                            unsigned size)
+{
+    struct omap2_wdt_s *s = opaque;
+    uint32_t count;
+
+    switch (addr) {
+    case 0x10:  /* WD_SYSCONFIG */
+        if (value & 2)                  /* SOFTRESET */
+            omap2_wdt_reset(s);
+        else
+            s->sysconfig = value & 0x19;
+        break;
+    case 0x18:  /* WISR */
+        break;
+    case 0x1c:  /* WIER */
+        s->wier = value & 1;
+        break;
+    case 0x24:  /* WCLR */
+        count = omap2_wdt_counter(s);
+        s->wclr = value & 0x3c;
+        omap2_wdt_load(s, count);
+        break;
+    case 0x28:  /* WCRR */
+        omap2_wdt_load(s, value);
+        break;
+    case 0x2c:  /* WLDR */
+        s->wldr = value;
+        break;
+    case 0x30:  /* WTGR: a new value reloads the counter */
+        if (value != s->wtgr)
+            omap2_wdt_load(s, s->wldr);
+        s->wtgr = value;
+        break;
+    case 0x48:  /* WSPR: 0xbbbb, 0x4444 starts; 0xaaaa, 0x5555 stops */
+        count = omap2_wdt_counter(s);
+        if (s->wspr == 0xbbbb && value == 0x4444)
+            s->running = 1;
+        else if (s->wspr == 0xaaaa && value == 0x5555)
+            s->running = 0;
+        s->wspr = value;
+        omap2_wdt_load(s, count);
+        break;
+    default:
+        OMAP_BAD_REG(addr);
+    }
+}
+
+static const MemoryRegionOps omap2_wdt_ops = {
+    .read = omap2_wdt_read,
+    .write = omap2_wdt_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static void omap2_wdt_init(MemoryRegion *sysmem, hwaddr base)
+{
+    struct omap2_wdt_s *s = g_malloc0(sizeof(*s));
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, omap2_wdt_expired, s);
+    omap2_wdt_reset(s);
+    memory_region_init_io(&s->iomem, NULL, &omap2_wdt_ops, s, "omap2.wdt",
+                          0x1000);
+    memory_region_add_subregion(sysmem, base, &s->iomem);
+}
+
+/* Modules Linux resets but QEMU doesn't model (SHA1/MD5, AES, HDQ/1-wire):
+ * just SYSCONFIG and SYSSTATUS, with soft reset completing at once. */
+struct omap2_sysc_stub_s {
+    MemoryRegion iomem;
+    hwaddr rev, sysc, syss;
+    uint32_t sysconfig;
+};
+
+static uint64_t omap2_sysc_stub_read(void *opaque, hwaddr addr, unsigned size)
+{
+    struct omap2_sysc_stub_s *s = opaque;
+
+    if (addr == s->sysc)
+        return s->sysconfig;
+    if (addr == s->syss)
+        return 1;                       /* RESETDONE */
+    return 0;
+}
+
+static void omap2_sysc_stub_write(void *opaque, hwaddr addr, uint64_t value,
+                                  unsigned size)
+{
+    struct omap2_sysc_stub_s *s = opaque;
+
+    if (addr == s->sysc)
+        s->sysconfig = value & ~2;      /* SOFTRESET self-clears */
+}
+
+static const MemoryRegionOps omap2_sysc_stub_ops = {
+    .read = omap2_sysc_stub_read,
+    .write = omap2_sysc_stub_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static void omap2_sysc_stub_init(MemoryRegion *sysmem, hwaddr base,
+                                 const char *name, hwaddr sysc, hwaddr syss)
+{
+    struct omap2_sysc_stub_s *s = g_malloc0(sizeof(*s));
+
+    s->sysc = sysc;
+    s->syss = syss;
+    memory_region_init_io(&s->iomem, NULL, &omap2_sysc_stub_ops, s, name,
+                          0x1000);
+    memory_region_add_subregion(sysmem, base, &s->iomem);
+}
+
 /* System and Pinout control */
 struct omap_sysctl_s {
     struct omap_mpu_state_s *mpu;
@@ -2437,6 +2629,11 @@ struct omap_mpu_state_s *omap2420_mpu_init(MemoryRegion *sdram,
 
     omap_tap_init(omap_l4ta(s->l4, 2), s);
 
+    omap2_wdt_init(sysmem, 0x48022000);
+    omap2_sysc_stub_init(sysmem, 0x480a4000, "omap2.sham", 0x60, 0x64);
+    omap2_sysc_stub_init(sysmem, 0x480a6000, "omap2.aes", 0x48, 0x4c);
+    omap2_sysc_stub_init(sysmem, 0x480b2000, "omap2.hdq1w", 0x14, 0x18);
+
     s->synctimer = omap_synctimer_init(omap_l4tao(s->l4, 2), s,
                     omap_findclk(s, "clk32-kHz"),
                     omap_findclk(s, "core_l4_iclk"));
