+/*
+ * The gadget host: in peripheral mode the controller is a B-device, and
+ * this plays the USB host at the other end of the cable. When the guest
+ * connects (POWER.SOFTCONN), it raises VBUS, resets the bus, enumerates
+ * the gadget, selects a CDC ECM configuration (e.g. Linux g_ether) and
+ * then moves Ethernet frames between its bulk endpoints and a QEMU NIC
+ * (the send/ready callbacks). Full speed: 64-byte packets.
+ */
+#define GH_FRAMES       32
+#define GH_FRAME_MAX    2048
+#define GH_POLL_NS      20000           /* while there is work */
+#define GH_TIMEOUT_NS   2000000000LL    /* for one control transfer */
+
+enum { GH_UNPLUGGED, GH_ATTACHED, GH_ENUM, GH_RUNNING, GH_FAILED };
+enum { CTL_START, CTL_SETUP, CTL_DATA_IN, CTL_STATUS, CTL_DONE, CTL_STALL };
+
+typedef struct MUSBGadgetHost {
+    int enabled;
+    void (*send)(void *opaque, const uint8_t *buf, int len);
+    void (*ready)(void *opaque);
+    void *opaque;
+    QEMUTimer *timer;
