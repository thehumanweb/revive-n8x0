+    uint8_t setup[8];
+    uint8_t data[1024];
+    int data_len;
+    int want;
+    int dataend;
+    int stall;
+
+    /* Enumeration results */
+    int num_configs;
+    int cfg_idx;
+    int cfg_value;
+    int data_iface;
+    int ep_in;
+    int ep_out;
+
+    /* Bulk: one frame being assembled from IN, a queue of OUT frames */
+    uint8_t in_frame[GH_FRAME_MAX];
+    int in_len;
+    uint8_t out_frame[GH_FRAMES][GH_FRAME_MAX];
+    int out_frame_len[GH_FRAMES];
+    int out_head;
+    int out_count;
+    int out_pos;
+    int out_zlp;
+} MUSBGadgetHost;
