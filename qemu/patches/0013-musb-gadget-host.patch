+/* ------------------------------------------------------------------ */
+/* Gadget host */
+
+#define GH_LOG(fmt, ...) fprintf(stderr, "usb-gadget-host: " fmt "\n", \
+                                 ## __VA_ARGS__)
+
+static int64_t gh_now(void)
+{
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void musb_gh_schedule(MUSBState *s, int64_t when)
+{
+    if (!timer_pending(s->gh.timer) ||
+        timer_expire_time_ns(s->gh.timer) > when) {
+        timer_mod(s->gh.timer, when);
+    }
+}
+
+static void musb_gh_kick(MUSBState *s)
+{
+    if (s->gh.enabled && s->gh.state != GH_UNPLUGGED) {
+        musb_gh_schedule(s, gh_now() + GH_POLL_NS);
+    }
+}
+
+static void musb_gh_reset(MUSBState *s)
+{
+    MUSBGadgetHost *gh = &s->gh;
+
+    if (!gh->enabled) {
+        return;
+    }
+    timer_del(gh->timer);
+    gh->state = GH_UNPLUGGED;
+    gh->ctl = CTL_START;
+    gh->in_len = 0;
+    gh->out_head = gh->out_count = gh->out_pos = gh->out_zlp = 0;
+}
+
+static void musb_gh_unplug(MUSBState *s)
+{
+    int was_running = s->gh.state == GH_RUNNING;
+
+    musb_gh_reset(s);
+    s->devctl = 0;
+    qemu_set_irq(s->irqs[musb_set_session], 0);
+    musb_vbus_set(s, 0);
+    if (was_running) {
+        GH_LOG("disconnected");
+    }
+}
+
+/* The gadget turned its D+ pull-up on or off */
+static void musb_gh_power(MUSBState *s, uint8_t old_power)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    int on = s->power & MGC_M_POWER_SOFTCONN;
+
+    if (on && !(old_power & MGC_M_POWER_SOFTCONN) &&
+        gh->state == GH_UNPLUGGED) {
+        /* Cable in: VBUS, then a bus reset after 100 ms */
+        s->devctl = MGC_M_DEVCTL_BDEVICE | MGC_M_DEVCTL_VBUS |
+                    MGC_M_DEVCTL_SESSION;
+        musb_vbus_set(s, 1);
+        qemu_set_irq(s->irqs[musb_set_session], 1);
+        gh->state = GH_ATTACHED;
+        gh->wait_until = gh_now() + 100000000;
+        musb_gh_schedule(s, gh->wait_until);
+    } else if (!on && (old_power & MGC_M_POWER_SOFTCONN) &&
+               gh->state != GH_UNPLUGGED) {
+        musb_gh_unplug(s);
+    }
+}
+
+static void musb_gh_csr0_write(MUSBState *s, uint16_t value)
+{
+    MUSBEndPoint *ep = &s->ep[0];
+    uint16_t csr = ep->csr[0];
+
+    if (value & MGC_M_CSR0_P_SVDRXPKTRDY) {
+        csr &= ~MGC_M_CSR0_RXPKTRDY;
+    }
+    if (value & MGC_M_CSR0_P_SVDSETUPEND) {
+        csr &= ~MGC_M_CSR0_P_SETUPEND;
+    }
+    if (!(value & MGC_M_CSR0_P_SENTSTALL)) {
+        csr &= ~MGC_M_CSR0_P_SENTSTALL;
+    }
+    if (value & MGC_M_CSR0_FLUSHFIFO) {
+        ep->fifolen[0] = ep->fifostart[0] = 0;
+        csr &= ~MGC_M_CSR0_TXPKTRDY;
+    }
+    if (value & MGC_M_CSR0_P_SENDSTALL) {
+        csr |= MGC_M_CSR0_P_SENTSTALL;
+        s->gh.stall = 1;
+    }
+    if (value & MGC_M_CSR0_TXPKTRDY) {
+        csr |= MGC_M_CSR0_TXPKTRDY;
+    }
+    if (value & MGC_M_CSR0_P_DATAEND) {
+        s->gh.dataend = 1;
+    }
+    ep->csr[0] = csr;
+    musb_gh_kick(s);
+}
+
+/* Take the packet the gadget queued on a TX (IN) endpoint */
+static int musb_gh_take_in(MUSBState *s, int epnum, uint8_t *buf, int max)
+{
+    MUSBEndPoint *ep = &s->ep[epnum];
+    int len = ep->fifolen[0];
+
+    /* The TUSB6010 is told the real length (XFR_SIZE); the FIFO is
+     * written in whole 32-bit words */
+    if (ep->ext_size[0]) {
+        len = MIN(len, ep->ext_size[0]);
+        ep->ext_size[0] = 0;
+    }
+    len = MIN(len, max);
+    if (ep->buf[0] && len > 0) {
+        memcpy(buf, ep->buf[0] + ep->fifostart[0], len);
+    }
+    ep->fifostart[0] = ep->fifolen[0] = 0;
+    return len;
+}
+
+static void musb_gh_ctl_start(MUSBState *s, int type, int req, int value,
+                              int index, int length)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    MUSBEndPoint *ep = &s->ep[0];
+
+    gh->setup[0] = type;
+    gh->setup[1] = req;
+    gh->setup[2] = value;
+    gh->setup[3] = value >> 8;
+    gh->setup[4] = index;
+    gh->setup[5] = index >> 8;
+    gh->setup[6] = length;
+    gh->setup[7] = length >> 8;
+    gh->want = length;
+    gh->data_len = 0;
+    gh->dataend = 0;
+    gh->stall = 0;
+
+    memcpy(ep->buf[1], gh->setup, 8);
+    ep->fifostart[1] = ep->fifolen[1] = 0;
+    ep->rxcount = 8;
+    ep->csr[0] |= MGC_M_CSR0_RXPKTRDY;
+    gh->ctl = CTL_SETUP;
+    gh->ctl_deadline = gh_now() + GH_TIMEOUT_NS;
+    musb_tx_intr_set(s, 0, 1);
+}
+
+/* Advance the control transfer in progress */
+static void musb_gh_ctl_run(MUSBState *s)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    MUSBEndPoint *ep = &s->ep[0];
+    int len;
+
+    if (gh->stall && gh->ctl != CTL_STALL && gh->ctl != CTL_DONE) {
+        gh->ctl = CTL_STALL;
+        musb_tx_intr_set(s, 0, 1);
+        return;
+    }
+
+    switch (gh->ctl) {
+    case CTL_SETUP:
+        if (ep->csr[0] & MGC_M_CSR0_RXPKTRDY) {
+            return;
+        }
+        gh->ctl = gh->want ? CTL_DATA_IN : CTL_STATUS;
+        /* fall through */
+    case CTL_DATA_IN:
+    case CTL_STATUS:
+        if (gh->ctl == CTL_DATA_IN && (ep->csr[0] & MGC_M_CSR0_TXPKTRDY)) {
+            len = musb_gh_take_in(s, 0, gh->data + gh->data_len,
+                                  sizeof(gh->data) - gh->data_len);
+            gh->data_len += len;
+            ep->csr[0] &= ~MGC_M_CSR0_TXPKTRDY;
+            if (gh->dataend || len < 64 || gh->data_len >= gh->want) {
+                /* Last data packet; the status stage completes with it */
+                gh->dataend = 0;
+                gh->ctl = CTL_DONE;
+            }
+            musb_tx_intr_set(s, 0, 1);
+        } else if (gh->ctl == CTL_STATUS && gh->dataend) {
+            gh->dataend = 0;
+            gh->ctl = CTL_DONE;
+            musb_tx_intr_set(s, 0, 1);
+        }
+        break;
+    }
+}
+
+/* Find a CDC ECM function in a configuration descriptor */
+static int musb_gh_find_ecm(MUSBGadgetHost *gh)
+{
+    const uint8_t *d = gh->data;
+    int len = gh->data_len, i;
+    int ecm = 0, iface = -1, alt = 0, in = 0, out = 0;
+
+    for (i = 0; i + 2 <= len && d[i] >= 2 && i + d[i] <= len; i += d[i]) {
+        switch (d[i + 1]) {
+        case USB_DT_INTERFACE:
+            iface = d[i + 2];
+            alt = d[i + 3];
+            if (d[i + 5] == 0x02 && d[i + 6] == 0x06) {
+                ecm = 1;        /* Communications, Ethernet Networking */
+            }
+            break;
+        case USB_DT_ENDPOINT:
+            if (ecm && alt == 1 && (d[i + 3] & 3) == USB_ENDPOINT_XFER_BULK) {
+                if (d[i + 2] & USB_DIR_IN) {
+                    in = d[i + 2] & 0xf;
+                } else {
+                    out = d[i + 2] & 0xf;
+                }
+            }
+            break;
+        }
+        if (ecm && in && out) {
+            gh->cfg_value = d[5];
+            gh->data_iface = iface;
+            gh->ep_in = in;
+            gh->ep_out = out;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Enumeration, one control transfer per step */
+static void musb_gh_enum(MUSBState *s)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    int total;
+
+    if (gh->ctl == CTL_START) {
+        /* Let the gadget finish with the last EP0 interrupt first */
+        if ((s->tx_intr & 1) || gh_now() < gh->wait_until) {
+            return;
+        }
+        switch (gh->step) {
+        case 0:
+            musb_gh_ctl_start(s, 0x80, USB_REQ_GET_DESCRIPTOR,
+                              USB_DT_DEVICE << 8, 0, 64);
+            break;
+        case 1:
+            musb_gh_ctl_start(s, 0x00, USB_REQ_SET_ADDRESS, 1, 0, 0);
+            break;
+        case 2:
+            musb_gh_ctl_start(s, 0x80, USB_REQ_GET_DESCRIPTOR,
+                              USB_DT_DEVICE << 8, 0, 18);
+            break;
+        case 3:
+            musb_gh_ctl_start(s, 0x80, USB_REQ_GET_DESCRIPTOR,
+                              (USB_DT_CONFIG << 8) | gh->cfg_idx, 0, 9);
+            break;
+        case 4:
+            total = MIN(gh->want, (int) sizeof(gh->data));
+            musb_gh_ctl_start(s, 0x80, USB_REQ_GET_DESCRIPTOR,
+                              (USB_DT_CONFIG << 8) | gh->cfg_idx, 0, total);
+            break;
+        case 5:
+            musb_gh_ctl_start(s, 0x00, USB_REQ_SET_CONFIGURATION,
+                              gh->cfg_value, 0, 0);
+            break;
+        case 6:
+            musb_gh_ctl_start(s, 0x01, USB_REQ_SET_INTERFACE,
+                              1, gh->data_iface, 0);
+            break;
+        }
+        return;
+    }
+
+    musb_gh_ctl_run(s);
+
+    if (gh->ctl == CTL_STALL) {
+        GH_LOG("request %02x %02x stalled, giving up",
+               gh->setup[0], gh->setup[1]);
+        gh->state = GH_FAILED;
+        return;
+    }
+    if (gh->ctl != CTL_DONE) {
+        if (gh_now() > gh->ctl_deadline) {
+            GH_LOG("request %02x %02x timed out, giving up",
+                   gh->setup[0], gh->setup[1]);
+            gh->state = GH_FAILED;
+        }
+        return;
+    }
+
+    /* The transfer is done: look at its data and pick the next one */
+    gh->ctl = CTL_START;
+    gh->wait_until = gh_now() + 2000000;
+    switch (gh->step) {
+    case 2:
+        if (gh->data_len < 18) {
+            GH_LOG("short device descriptor");
+            gh->state = GH_FAILED;
+            return;
+        }
+        gh->num_configs = gh->data[17];
+        gh->cfg_idx = 0;
+        GH_LOG("device %02x%02x:%02x%02x, %d configuration(s)",
+               gh->data[9], gh->data[8], gh->data[11], gh->data[10],
+               gh->num_configs);
+        gh->step = 3;
+        return;
+    case 3:
+        if (gh->data_len < 9) {
+            gh->state = GH_FAILED;
+            return;
+        }
+        gh->want = gh->data[2] | (gh->data[3] << 8);
+        gh->step = 4;
+        return;
+    case 4:
+        if (musb_gh_find_ecm(gh)) {
+            GH_LOG("CDC ECM in configuration %d: interface %d, "
+                   "bulk in ep%d, out ep%d", gh->cfg_value, gh->data_iface,
+                   gh->ep_in, gh->ep_out);
+            gh->step = 5;
+        } else if (++gh->cfg_idx < gh->num_configs) {
+            gh->step = 3;
+        } else {
+            GH_LOG("no CDC ECM configuration, giving up");
+            gh->state = GH_FAILED;
+        }
+        return;
+    case 6:
+        GH_LOG("configured, link up");
+        gh->state = GH_RUNNING;
+        gh->in_len = 0;
+        if (gh->ready) {
+            gh->ready(gh->opaque);
+        }
+        return;
+    default:
+        gh->step++;
+        return;
+    }
+}
+
+/* Move packets between the bulk endpoints and the NIC */
+static int musb_gh_bulk(MUSBState *s)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    MUSBEndPoint *ep;
+    int epnum, len, maxp, busy = 0;
+
+    /* IN: every packet a TX endpoint has ready */
+    for (epnum = 1; epnum < 16; epnum++) {
+        ep = &s->ep[epnum];
+        if (!(ep->csr[0] & MGC_M_TXCSR_TXPKTRDY)) {
+            continue;
+        }
+        if (epnum == gh->ep_in) {
+            maxp = (ep->maxp[0] & 0x7ff) ?: 64;
+            len = musb_gh_take_in(s, epnum, gh->in_frame + gh->in_len,
+                                  sizeof(gh->in_frame) - gh->in_len);
+            gh->in_len += len;
+            if (len < maxp) {
+                /* A short packet ends the frame */
+                if (gh->in_len && gh->send) {
+                    gh->send(gh->opaque, gh->in_frame, gh->in_len);
+                }
+                gh->in_len = 0;
+            }
+        } else {
+            /* e.g. CDC notifications: taken and dropped */
+            musb_gh_take_in(s, epnum, NULL, 0);
+        }
+        ep->csr[0] &= ~(MGC_M_TXCSR_TXPKTRDY | MGC_M_TXCSR_FIFONOTEMPTY);
+        musb_tx_intr_set(s, epnum, 1);
+        busy = 1;
+    }
+
+    /* OUT: the next packet of the frame at the head of the queue */
+    ep = &s->ep[gh->ep_out];
+    if (gh->out_count && ep->buf[1] &&
+        !(ep->csr[1] & MGC_M_RXCSR_RXPKTRDY) &&
+        !(s->rx_intr & (1 << gh->ep_out))) {
+        int flen = gh->out_frame_len[gh->out_head];
+
+        maxp = (ep->maxp[1] & 0x7ff) ?: 64;
+        len = MIN(maxp, flen - gh->out_pos);
+        if (gh->out_zlp) {
+            len = 0;
+        }
+        memcpy(ep->buf[1], gh->out_frame[gh->out_head] + gh->out_pos, len);
+        ep->fifostart[1] = ep->fifolen[1] = 0;
+        ep->rxcount = len;
+        ep->csr[1] |= MGC_M_RXCSR_RXPKTRDY | MGC_M_RXCSR_FIFOFULL;
+        musb_rx_intr_set(s, gh->ep_out, 1);
+
+        if (gh->out_zlp) {
+            gh->out_zlp = 0;
+            gh->out_pos = flen;
+        } else {
+            gh->out_pos += len;
+            /* A frame of whole packets needs a zero-length one to end */
+            if (gh->out_pos == flen && len == maxp) {
+                gh->out_zlp = 1;
+            }
+        }
+        if (gh->out_pos >= flen && !gh->out_zlp) {
+            gh->out_head = (gh->out_head + 1) % GH_FRAMES;
+            gh->out_count--;
+            gh->out_pos = 0;
+            if (gh->out_count == GH_FRAMES - 1 && gh->ready) {
+                gh->ready(gh->opaque);
+            }
+        }
+        busy = 1;
+    }
+    return busy || gh->out_count;
+}
+
+static void musb_gh_tick(void *opaque)
+{
+    MUSBState *s = opaque;
+    MUSBGadgetHost *gh = &s->gh;
+
+    switch (gh->state) {
+    case GH_ATTACHED:
+        if (gh_now() < gh->wait_until) {
+            musb_gh_schedule(s, gh->wait_until);
+            return;
+        }
+        /* Bus reset; full speed */
+        s->faddr = 0;
+        s->power &= ~MGC_M_POWER_HSMODE;
+        musb_intr_set(s, musb_irq_rst_babble, 1);
+        gh->state = GH_ENUM;
+        gh->step = 0;
+        gh->ctl = CTL_START;
+        gh->wait_until = gh_now() + 20000000;
+        /* fall through */
+    case GH_ENUM:
+        musb_gh_enum(s);
+        if (gh->state == GH_ENUM) {
+            musb_gh_schedule(s, gh_now() + (gh->ctl == CTL_START &&
+                             gh_now() < gh->wait_until ?
+                             gh->wait_until - gh_now() : GH_POLL_NS * 10));
+        }
+        break;
+    case GH_RUNNING:
+        if (musb_gh_bulk(s)) {
+            musb_gh_schedule(s, gh_now() + GH_POLL_NS);
+        }
+        break;
+    }
+}
+
+void musb_gadget_host_attach(MUSBState *s,
+                void (*send)(void *opaque, const uint8_t *buf, int len),
+                void (*ready)(void *opaque), void *opaque)
+{
+    MUSBGadgetHost *gh = &s->gh;
+
+    gh->send = send;
+    gh->ready = ready;
+    gh->opaque = opaque;
+    gh->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, musb_gh_tick, s);
+    gh->enabled = 1;
+    musb_gh_reset(s);
+}
+
+int musb_gadget_host_can_receive(MUSBState *s)
+{
+    return s->gh.enabled && s->gh.state == GH_RUNNING &&
+           s->gh.out_count < GH_FRAMES;
+}
+
+int musb_gadget_host_receive(MUSBState *s, const uint8_t *buf, int len)
+{
+    MUSBGadgetHost *gh = &s->gh;
+    int slot;
+
+    if (!musb_gadget_host_can_receive(s)) {
+        return 0;
+    }
+    if (len > GH_FRAME_MAX) {
+        return len;             /* dropped */
+    }
+    slot = (gh->out_head + gh->out_count) % GH_FRAMES;
+    memcpy(gh->out_frame[slot], buf, len);
+    gh->out_frame_len[slot] = len;
+    gh->out_count++;
+    musb_gh_kick(s);
+    return len;
+}
