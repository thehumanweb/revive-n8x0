diff --git a/hw/misc/tsl2563.c b/hw/misc/tsl2563.c
new file mode 100644
index 000000000..0054209ac
--- /dev/null
+++ b/hw/misc/tsl2563.c
@@ -0,0 +1,169 @@
+/*
+ * TAOS TSL2563 ambient light sensor (I2C).
+ *
+ * The command byte (bit 7 set) selects a register, which then
+ * auto-increments for SMBus word and block transfers. The two ADC
+ * channels read the "ch0" (visible + IR) and "ch1" (IR) properties
+ * while the chip is powered up; the interrupt pin is not modelled.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 or
+ * (at your option) version 3 of the License.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+
+#define TSL2563_CMD	0x80
+#define TSL2563_CLEARINT 0x40
+
+#define TYPE_TSL2563 "tsl2563"
+#define TSL2563(obj) OBJECT_CHECK(TSL2563State, (obj), TYPE_TSL2563)
+
+typedef struct TSL2563State {
+    I2CSlave i2c;
+    uint8_t ctrl;
+    uint8_t timing;
+    uint8_t thresh[4];
+    uint8_t intr;
+    uint8_t ptr;
+    int cycle;
+    uint16_t ch0;
+    uint16_t ch1;
+} TSL2563State;
+
+static uint8_t tsl2563_read(TSL2563State *s, uint8_t reg)
+{
+    int on = (s->ctrl & 3) == 3;
+
+    switch (reg) {
+    case 0x0:
+        return s->ctrl;
+    case 0x1:
+        return s->timing;
+    case 0x2 ... 0x5:
+        return s->thresh[reg - 2];
+    case 0x6:
+        return s->intr;
+    case 0xa:	/* ID: model 7 (as on the N810), rev. 0 */
+        return 0x70;
+    case 0xc:
+        return on ? s->ch0 : 0;
+    case 0xd:
+        return on ? s->ch0 >> 8 : 0;
+    case 0xe:
+        return on ? s->ch1 : 0;
+    case 0xf:
+        return on ? s->ch1 >> 8 : 0;
+    default:
+        return 0;
+    }
+}
+
+static void tsl2563_write(TSL2563State *s, uint8_t reg, uint8_t val)
+{
+    switch (reg) {
+    case 0x0:
+        s->ctrl = val & 3;
+        break;
+    case 0x1:
+        s->timing = val & 0x1b;
+        break;
+    case 0x2 ... 0x5:
+        s->thresh[reg - 2] = val;
+        break;
+    case 0x6:
+        s->intr = val & 0x3f;
+        break;
+    }
+}
+
+static int tsl2563_event(I2CSlave *i2c, enum i2c_event event)
+{
+    TSL2563State *s = TSL2563(i2c);
+
+    if (event == I2C_START_SEND)
+        s->cycle = 0;
+    return 0;
+}
+
+static uint8_t tsl2563_rx(I2CSlave *i2c)
+{
+    TSL2563State *s = TSL2563(i2c);
+
+    return tsl2563_read(s, s->ptr++ & 0xf);
+}
+
+static int tsl2563_tx(I2CSlave *i2c, uint8_t data)
+{
+    TSL2563State *s = TSL2563(i2c);
+
+    if (!s->cycle++) {
+        if (data & TSL2563_CMD)		/* CLEARINT: nothing pending */
+            s->ptr = data & 0xf;
+        return 0;
+    }
+    tsl2563_write(s, s->ptr++ & 0xf, data);
+    return 0;
+}
+
+static const VMStateDescription vmstate_tsl2563 = {
+    .name = TYPE_TSL2563,
+    .version_id = 0,
+    .minimum_version_id = 0,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8(ctrl, TSL2563State),
+        VMSTATE_UINT8(timing, TSL2563State),
+        VMSTATE_UINT8_ARRAY(thresh, TSL2563State, 4),
+        VMSTATE_UINT8(intr, TSL2563State),
+        VMSTATE_UINT8(ptr, TSL2563State),
+        VMSTATE_INT32(cycle, TSL2563State),
+        VMSTATE_I2C_SLAVE(i2c, TSL2563State),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void tsl2563_realize(DeviceState *dev, Error **errp)
+{
+    TSL2563State *s = TSL2563(dev);
+
+    s->timing = 0x02;		/* 402 ms, gain 1 */
+}
+
+static Property tsl2563_properties[] = {
+    /* About 300 lux at the power-on timing (fluorescent office light) */
+    DEFINE_PROP_UINT16("ch0", TSL2563State, ch0, 2800),
+    DEFINE_PROP_UINT16("ch1", TSL2563State, ch1, 400),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void tsl2563_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = tsl2563_realize;
+    k->event = tsl2563_event;
+    k->recv = tsl2563_rx;
+    k->send = tsl2563_tx;
+    dc->vmsd = &vmstate_tsl2563;
+    device_class_set_props(dc, tsl2563_properties);
+}
+
+static const TypeInfo tsl2563_info = {
+    .name          = TYPE_TSL2563,
+    .parent        = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(TSL2563State),
+    .class_init    = tsl2563_class_init,
+};
+
+static void tsl2563_register_types(void)
+{
+    type_register_static(&tsl2563_info);
+}
+
+type_init(tsl2563_register_types)
