# Started by the stock initfs's linuxrc: "chroot . /sbin/init <runlevel>"
# after pivot_root (the initfs is at /mnt/initfs, its /tmp on /tmp).
# DSME, BME and kicker keep running from the initfs.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/sh -c 'grep -q " /dev " /proc/mounts || mount -t devtmpfs devtmpfs /dev'
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

ttyS2::respawn:/sbin/getty -L ttyS2 115200 vt100

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
