#!/bin/sh
#
# Let the OMAP UARTs idle when unused: 8250_omap leaves runtime PM
# autosuspend off (a suspended UART loses received characters), and an
# active UART keeps its functional clock on, which keeps the OMAP out of
# CORE retention. The console's UART stays on, and so does a UART with no
# tty: a serdev driver owns it (UART1, Bluetooth, hci_nokia), and the chip
# talks whenever it likes.

DELAY=3000

case "$1" in
	start)
		printf "UART power management: "
		con=$(sed -n 's/.*console=\(ttyS[0-9]*\).*/\1/p' /proc/cmdline)
		for d in /sys/bus/platform/drivers/omap8250/*.serial; do
			# the port's tty: <dev>/<dev>:0/<dev>:0.0/tty/ttySn
			tty=$(ls "$d"/*/*/tty 2>/dev/null)
			[ -z "$tty" ] || [ "$tty" = "$con" ] && continue
			echo $DELAY > "$d/power/autosuspend_delay_ms" &&
				printf "%s " "$tty"
		done
		echo "OK"
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
