#!/bin/sh
#
# USB networking as a gadget: TUSB6010 (musb) in peripheral mode, g_ether
# (CDC ECM, RNDIS for Windows). The N810 is 192.168.2.15, as on Maemo;
# udhcpd offers the host 192.168.2.14, which is also the default gateway.

IP=192.168.2.15
GW=192.168.2.14

start() {
	printf "Starting USB networking: "
	# musb and TUSB6010 are built in (DSME reads musb_hdrc/mode)
	[ -d /sys/bus/platform/drivers/musb-tusb ] || modprobe tusb6010 ||
		{ echo "FAIL (tusb6010)"; return 1; }
	modprobe g_ether || { echo "FAIL (g_ether)"; return 1; }
	n=0
	while [ ! -e /sys/class/net/usb0 ] && [ $n -lt 10 ]; do
		sleep 1; n=$((n + 1))
	done
	[ -e /sys/class/net/usb0 ] || { echo "FAIL (no usb0)"; return 1; }
	ip addr add $IP/24 dev usb0
	ip link set usb0 up
	# The PC is the gateway, as with Maemo (unless there is another one)
	ip route show | grep -q "^default" || ip route add default via $GW dev usb0
	mkdir -p /var/lib/misc
	touch /var/lib/misc/udhcpd.leases
	udhcpd /etc/udhcpd.usb0.conf
	echo "OK (usb0 $IP)"
}

stop() {
	printf "Stopping USB networking: "
	killall udhcpd 2>/dev/null
	ip link set usb0 down 2>/dev/null
	modprobe -r g_ether
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
