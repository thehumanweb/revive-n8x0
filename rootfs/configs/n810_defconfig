# Nokia N810 (OMAP2420, ARM1136JF-S, ARMv6): a small glibc rootfs.
# The kernel is built separately (../kernel); its modules and mbxaccess.ko
# are overlaid by scripts/build-rootfs.sh.
BR2_arm=y
BR2_arm1136jf_s=y
BR2_ARM_EABI=y
BR2_ARM_FPU_VFPV2=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TARGET_GENERIC_HOSTNAME="n810"
BR2_TARGET_GENERIC_ISSUE="Nokia N810"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_N810_PATH)/board/n810/overlay $(BR2_EXTERNAL_N810_PATH)/build/modules-overlay"
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_MTD=y
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="96M"
BR2_TARGET_ROOTFS_JFFS2=y
BR2_TARGET_ROOTFS_JFFS2_CUSTOM=y
BR2_TARGET_ROOTFS_JFFS2_CUSTOM_EBSIZE=0x20000
BR2_TARGET_ROOTFS_JFFS2_NOCLEANMARKER=y
BR2_TARGET_ROOTFS_JFFS2_PAGESIZE=0x800
