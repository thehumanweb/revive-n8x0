+/*
+ * Bus timings, set by the client for its controller (Nokia's omapfb did so
+ * from the controller's clock; the bootloader's don't survive a DSS reset).
+ * RFBI counts in L4 interface clock ticks, optionally halved.
+ */
+unsigned long rfbi_get_tick_ps(struct rfbi_device *rfbi)
+{
+	struct clk *ick = clk_get(NULL, "dss_ick");
+	unsigned long rate;
+
+	if (IS_ERR(ick))
+		return 0;
+	rate = clk_get_rate(ick);
+	clk_put(ick);
+
+	return rate ? 1000000000UL / (rate / 1000) : 0;
+}
+
+/* With the bus held. After Nokia's rfbi_convert_timings(). */
+int rfbi_set_timings(struct rfbi_device *rfbi, const struct rfbi_timings *t,
+		     int div)
+{
+	unsigned long tick = rfbi_get_tick_ps(rfbi) * div;
+	unsigned int cson, csoff, weon, weoff, reon, reoff;
+	unsigned int actim, wecyc, recyc, cspulse;
+	u32 l;
+
+	if (!tick || div < 1 || div > 2)
+		return -EINVAL;
+
+#define TICKS(ps)	DIV_ROUND_UP(ps, tick)
+	weon = TICKS(t->we_on);
+	weoff = max(TICKS(t->we_off), weon + 1);
+	reon = TICKS(t->re_on);
+	reoff = max(TICKS(t->re_off), reon + 1);
+	cson = TICKS(t->cs_on);
+	csoff = max3(TICKS(t->cs_off), cson + 1, max(weoff, reoff));
+	actim = max(TICKS(t->access), reon + 1);
+	wecyc = max(TICKS(t->we_cycle), weoff);
+	recyc = max(TICKS(t->re_cycle), reoff);
+	cspulse = TICKS(t->cs_pulse);
+#undef TICKS
+
+	if (weon > 0x0f || reon > 0x0f || cson > 0x0f || weoff > 0x3f ||
+	    reoff > 0x3f || csoff > 0x3f || actim > 0x3f || wecyc > 0x3f ||
+	    recyc > 0x3f || cspulse > 0x3f)
+		return -ERANGE;
+
+	rfbi_write_reg(rfbi, RFBI_ONOFF_TIME0, cson | csoff << 4 | weon << 10 |
+		       weoff << 14 | reon << 20 | reoff << 24);
+	rfbi_write_reg(rfbi, RFBI_CYCLE_TIME0, wecyc | recyc << 6 |
+		       cspulse << 12 | actim << 22);
+	l = rfbi_read_reg(rfbi, RFBI_CONFIG0) & ~RFBI_CONFIG0_CLKDIV2;
+	if (div == 2)
+		l |= RFBI_CONFIG0_CLKDIV2;
+	rfbi_write_reg(rfbi, RFBI_CONFIG0, l);
+
+	return 0;
+}
+
