+/*
+ * Register access timings for a system clock of sysclk Hz, at the first
+ * RFBI clock divider they fit (Nokia's calc_reg_timing(): CS on at 0, WE
+ * and RE on at 2 ns, access 12.2 ns later, cycles 2 SYSCLK + 2 ns).
+ */
+static int s1d1374x_set_timings(struct s1d1374x *ctrl, unsigned long sysclk)
+{
+	unsigned long tick = rfbi_get_tick_ps(ctrl->rfbi);
+	unsigned int systim = 1000000000 / (sysclk / 1000);	/* ps */
+	struct rfbi_timings t;
+	int div;
+
+	for (div = 1; tick && div <= 2; div++) {
+		unsigned long bus = tick * div;
+
+#define R(ps)	roundup((ps), bus)
+		t.cs_on = 0;
+		t.we_on = R(2000);
+		t.re_on = R(2000);
+		t.access = R(t.re_on + 12200);
+		t.we_off = R(t.we_on + 1000);
+		t.re_off = R(t.re_on + 13000);
+		t.cs_off = R(t.re_off + 1000);
+		t.we_cycle = max_t(unsigned int, R(2 * systim + 2000), t.we_off);
+		t.re_cycle = max_t(unsigned int, R(2 * systim + 2000), t.re_off);
+		t.cs_pulse = 0;
+#undef R
+		if (!rfbi_set_timings(ctrl->rfbi, &t, div))
+			return 0;
+	}
+
+	dev_err(ctrl->dev, "no RFBI timings for a %lu Hz controller\n",
+		sysclk);
+	return -ERANGE;
+}
+
+/* Bus timings for the input clock, then for the PLL's (blizzard_setup_clocks) */
+static int s1d1374x_setup_clocks(struct s1d1374x *ctrl)
+{
+	unsigned long ext = ctrl->ext_clk ? clk_get_rate(ctrl->ext_clk) : 0;
+	unsigned long sys = ext;
+	u8 src, pll_div;
+	int r;
+
+	if (!ext)
+		ext = sys = 19200000;	/* the N8x0's oscillator */
+
+	r = s1d1374x_set_timings(ctrl, ext);
+	if (r)
+		return r;
+
+	pll_div = s1d1374x_read_reg(ctrl, BLIZZARD_PLL_DIV);
+	if (!(pll_div & BIT(7))) {
+		dev_err(ctrl->dev, "PLL not locked\n");
+		return -ENODEV;
+	}
+
+	src = s1d1374x_read_reg(ctrl, BLIZZARD_CLK_SRC);
+	if (!(src & (3 << 1))) {	/* system clock from the PLL */
+		u32 mul = s1d1374x_read_reg(ctrl, BLIZZARD_PLL_CLOCK_SYNTH_0) |
+			  (s1d1374x_read_reg(ctrl, BLIZZARD_PLL_CLOCK_SYNTH_1) &
+			   0x0f) << 11;
+
+		sys = div_u64((u64)ext * mul, (pll_div & 0x3f) + 1);
+	}
+
+	r = s1d1374x_set_timings(ctrl, sys);
+	if (!r)
+		dev_info(ctrl->dev, "system clock %lu Hz (input %lu Hz)\n",
+			 sys, ext);
+	return r;
+}
