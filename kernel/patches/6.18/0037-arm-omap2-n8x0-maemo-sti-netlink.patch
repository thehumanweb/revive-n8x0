+#include <net/net_namespace.h>
+#include <net/netlink.h>
+#include <net/sock.h>
 
 #include "common.h"
 
@@ -574,6 +580,53 @@
 static inline void n8x0_maemo_musb_init(void) { }
 #endif
 
+/*
+ * Nokia's STI (OMAP serial trace port) interface: userspace sent trace
+ * records over NETLINK_USERSOCK to the kernel (2.6.21's sti-netlink.c),
+ * which wrote them to the debug port. BME sends one for each of its
+ * events (nlmsg_type STI_WRITE | id << 8, channel in nlmsg_flags' upper
+ * byte); without a kernel socket every send failed with ECONNREFUSED and
+ * BME printed "sendmsg: Connection refused" to the console, many times
+ * a minute. There is no STI here: take the records and drop them; acked
+ * on request as then, a read gets nothing.
+ */
+#define STI_READ	0
+#define STI_WRITE	1
+
+static void n8x0_sti_input(struct sk_buff *skb)
+{
+	while (skb->len >= NLMSG_HDRLEN) {
+		struct nlmsghdr *nlh = nlmsg_hdr(skb);
+		u32 rlen;
+
+		if (nlh->nlmsg_len < NLMSG_HDRLEN || skb->len < nlh->nlmsg_len)
+			return;
+		switch (nlh->nlmsg_type & 0xff) {
+		case STI_WRITE:
+		case STI_READ:
+			if (nlh->nlmsg_flags & NLM_F_ACK)
+				netlink_ack(skb, nlh, 0, NULL);
+			break;
+		default:
+			netlink_ack(skb, nlh, -ENOTTY, NULL);
+		}
+		rlen = NLMSG_ALIGN(nlh->nlmsg_len);
+		if (rlen > skb->len)
+			rlen = skb->len;
+		skb_pull(skb, rlen);
+	}
+}
+
+static void __init n8x0_maemo_sti_init(void)
+{
+	struct netlink_kernel_cfg cfg = {
+		.input	= n8x0_sti_input,
+	};
+
+	if (!netlink_kernel_create(&init_net, NETLINK_USERSOCK, &cfg))
+		pr_warn("n8x0-maemo: no STI netlink socket\n");
+}
+
 static int __init n8x0_maemo_init(void)
 {
 	struct device_node *chosen;
@@ -602,6 +655,7 @@
 	n8x0_maemo_omapfb_init();
 	n8x0_maemo_switches_init();
 	n8x0_maemo_musb_init();
+	n8x0_maemo_sti_init();
 
 	return sysfs_create_file(power_kobj, &sleep_while_idle_attr.attr);
 }
