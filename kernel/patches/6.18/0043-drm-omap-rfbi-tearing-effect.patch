From: Carsten Munk <carsten.munk@gmail.com>
Subject: [PATCH] drm/omap: rfbi, s1d1374x: start updates on the tearing effect signal

The S1D1374x drives a TE pin from its panel timing, wired to RFBI on the
N800/N810. Use it as Nokia's omapfb did: instead of RFBI's internal
trigger, each update waits for the controller's VSYNC, or, when RFBI
sends a line slower than the panel scans one (the N810 case), for line 1
on HSYNC or'ed with VSYNC, so the frame goes out right behind the scan.

RFBI gets the TE pulse widths, trigger mode and line number, and Nokia's
measured transfer rates per operating point; the controller computes the
mode from its panel registers. If no TE pulse comes, the first FRAMEDONE
timeout goes back to the internal trigger. omapdrm.tearsync=0 turns it off.

---
--- a/drivers/gpu/drm/omapdrm/dss/dss.h
+++ b/drivers/gpu/drm/omapdrm/dss/dss.h
@@ -236,6 +236,12 @@
 unsigned long rfbi_get_tick_ps(struct rfbi_device *rfbi);
 int rfbi_set_timings(struct rfbi_device *rfbi, const struct rfbi_timings *t,
 		     int div);
+unsigned long rfbi_get_max_tx_rate(struct rfbi_device *rfbi);
+
+/* Tearing effect input: start updates on the controller's sync pulses */
+int rfbi_setup_te(struct rfbi_device *rfbi, unsigned long hs_ps,
+		  unsigned long vs_ps);
+void rfbi_set_te_line(struct rfbi_device *rfbi, unsigned int line);
 
 struct dss_lcd_mgr_config {
 	enum dss_io_pad_mode io_pad_mode;
--- a/drivers/gpu/drm/omapdrm/dss/rfbi.c
+++ b/drivers/gpu/drm/omapdrm/dss/rfbi.c
@@ -19,6 +19,7 @@
 #include <linux/component.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
@@ -48,6 +49,8 @@
 #define RFBI_ONOFF_TIME0	0x0064
 #define RFBI_CYCLE_TIME0	0x0068
 #define RFBI_DATA_CYCLE1_0	0x006c
+#define RFBI_VSYNC_WIDTH	0x0090
+#define RFBI_HSYNC_WIDTH	0x0094
 
 #define RFBI_CONTROL_ENABLE	BIT(0)
 #define RFBI_CONTROL_CS0	BIT(2)
@@ -56,6 +59,9 @@
 #define RFBI_CONFIG0_PARALLEL_MASK	(3 << 0)
 #define RFBI_CONFIG0_PARALLEL_8		(0 << 0)
 #define RFBI_CONFIG0_PARALLEL_16	(3 << 0)
+#define RFBI_CONFIG0_TRIGGER_MASK	(3 << 2)
+#define RFBI_CONFIG0_TRIGGER_ITE	(0 << 2)
+#define RFBI_CONFIG0_TRIGGER_TE1	(1 << 2)	/* one TE pin */
 #define RFBI_CONFIG0_CLKDIV2		BIT(4)	/* timing ticks: L4 clock / 2 */
 
 struct rfbi_device {
@@ -71,6 +77,10 @@
 	struct dss_lcd_mgr_config mgr_config;
 	bool enabled;
 
+	/* updates start on the TE pin, at this line (0: VSYNC) */
+	bool te;
+	unsigned int te_line;
+
 	const struct rfbi_client_ops *client_ops;
 	void *client_data;
 
@@ -236,6 +246,70 @@
 	return 0;
 }
 
+/*
+ * Pixels per second RFBI keeps up with at the current L4 and DSS1 clocks,
+ * from Nokia's rfbi_get_max_tx_rate(): not computable, per TI, so measured
+ * on the N800/N810 operating points, else as if at one of those.
+ */
+unsigned long rfbi_get_max_tx_rate(struct rfbi_device *rfbi)
+{
+	static const struct {
+		unsigned int l4_mhz, dss1_mhz, min_l4_ticks;
+	} ftab[] = {
+		{ 133, 133, 12 },	/* OP0, 11.08 Mpix/s */
+		{ 110, 110, 12 },	/* OP1, 9.16 Mpix/s */
+		{  44,  88,  8 },	/* OP2, 5.50 Mpix/s */
+		{  27, 110,  6 },	/* OP3, 4.58 Mpix/s */
+	};
+	unsigned long tick = rfbi_get_tick_ps(rfbi);
+	unsigned long l4 = tick ? div_u64(1000000000000ULL, tick) : 0;
+	unsigned long dss1 = dss_get_dispc_clk_rate(rfbi->dss);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ftab); i++)
+		if (abs((long)(l4 / 1000000) - (long)ftab[i].l4_mhz) < 3 &&
+		    abs((long)(dss1 / 1000000) - (long)ftab[i].dss1_mhz) < 3)
+			return l4 / ftab[i].min_l4_ticks;
+
+	/* 12 L4 ticks a pixel, as at both fast operating points */
+	dev_warn_once(&rfbi->pdev->dev,
+		      "no measured RFBI transfer rate for L4 %lu Hz, DSS1 %lu Hz: assuming %lu pixels/s\n",
+		      l4, dss1, l4 / 12);
+	return l4 / 12;
+}
+
+/*
+ * Tearing effect, with the bus held: from now on updates start on the
+ * controller's TE pulses instead of at once. One pin carries VSYNC, or
+ * HSYNC or'ed with it, told apart by width (Nokia's rfbi_setup_tearsync()).
+ */
+int rfbi_setup_te(struct rfbi_device *rfbi, unsigned long hs_ps,
+		  unsigned long vs_ps)
+{
+	unsigned long tick = rfbi_get_tick_ps(rfbi);
+	unsigned int hs, vs;
+
+	if (!tick)
+		return -EINVAL;
+	hs = DIV_ROUND_UP(hs_ps, tick);
+	vs = DIV_ROUND_UP(vs_ps, tick);
+	if (hs < 2 || vs < 4 || vs == hs || hs > 0xffff || vs > 0xffff)
+		return -EDOM;
+
+	rfbi_write_reg(rfbi, RFBI_HSYNC_WIDTH, hs);
+	rfbi_write_reg(rfbi, RFBI_VSYNC_WIDTH, vs);
+	rfbi->te = true;
+	rfbi->te_line = 0;
+
+	return 0;
+}
+
+/* Within prepare_update(): the line the next update waits for */
+void rfbi_set_te_line(struct rfbi_device *rfbi, unsigned int line)
+{
+	rfbi->te_line = min(line, 0x7ffu);
+}
+
 /* -----------------------------------------------------------------------------
  * Manual update
  */
@@ -265,6 +339,10 @@
 						framedone_timeout_work.work);
 
 	DSSERR("FRAMEDONE not received for 250ms\n");
+	if (rfbi->te) {
+		DSSWARN("no tearing effect signal: back to the internal trigger\n");
+		rfbi->te = false;
+	}
 	rfbi_update_done(rfbi);
 }
 
@@ -274,6 +352,7 @@
 						output);
 	u16 w = rfbi->vm.hactive;
 	u16 h = rfbi->vm.vactive;
+	u32 l;
 	int r;
 
 	down(&rfbi->bus_sem);
@@ -306,10 +385,18 @@
 
 	schedule_delayed_work(&rfbi->framedone_timeout_work,
 			      msecs_to_jiffies(250));
+
+	/* Start at once, or on the controller's TE pulse at te_line */
+	l = rfbi_read_reg(rfbi, RFBI_CONFIG0) & ~RFBI_CONFIG0_TRIGGER_MASK;
+	l |= rfbi->te ? RFBI_CONFIG0_TRIGGER_TE1 : RFBI_CONFIG0_TRIGGER_ITE;
+	rfbi_write_reg(rfbi, RFBI_CONFIG0, l);
+	rfbi_write_reg(rfbi, RFBI_LINE_NUMBER, rfbi->te ? rfbi->te_line : 0);
 
 	/* Arm RFBI, then let DISPC send the frame (stall mode, one shot) */
-	rfbi_write_reg(rfbi, RFBI_CONTROL, rfbi_read_reg(rfbi, RFBI_CONTROL) |
-		       RFBI_CONTROL_ENABLE | RFBI_CONTROL_ITE);
+	l = rfbi_read_reg(rfbi, RFBI_CONTROL) | RFBI_CONTROL_ENABLE;
+	if (!rfbi->te)
+		l |= RFBI_CONTROL_ITE;
+	rfbi_write_reg(rfbi, RFBI_CONTROL, l);
 	dss_mgr_start_update(&rfbi->output);
 
 	return 0;
--- a/drivers/gpu/drm/omapdrm/dss/s1d1374x.c
+++ b/drivers/gpu/drm/omapdrm/dss/s1d1374x.c
@@ -41,6 +41,13 @@
 #define BLIZZARD_PLL_CLOCK_SYNTH_0	0x08
 #define BLIZZARD_PLL_CLOCK_SYNTH_1	0x0a
 #define BLIZZARD_CLK_SRC		0x0e
+#define BLIZZARD_HDISP			0x2a
+#define BLIZZARD_HNDP			0x2c
+#define BLIZZARD_VDISP0			0x2e
+#define BLIZZARD_VDISP1			0x30
+#define BLIZZARD_VNDP			0x32
+#define BLIZZARD_HSW			0x34
+#define BLIZZARD_VSW			0x38
 #define BLIZZARD_INPUT_WIN_X_START_0	0x6c
 #define BLIZZARD_NDISP_CTRL_STATUS	0xe8
 
@@ -59,8 +66,16 @@
 	struct rfbi_device *rfbi;
 	u8 data_source;
 	bool identified;
+
+	unsigned long sys_clk;		/* Hz */
+	unsigned int we_cycle;		/* ps, the RFBI write cycle */
+	int te_line;			/* updates start here; -1: no TE */
 };
 
+static bool tearsync = true;
+module_param(tearsync, bool, 0444);
+MODULE_PARM_DESC(tearsync, "Start updates on the S1D1374x tearing effect signal");
+
 #define drm_bridge_to_s1d1374x(b) container_of(b, struct s1d1374x, bridge)
 
 /* With the RFBI bus held, 8 bits per cycle */
@@ -74,6 +89,12 @@
 	return val;
 }
 
+static void s1d1374x_write_reg(struct s1d1374x *ctrl, u8 reg, u8 val)
+{
+	rfbi_write_command(ctrl->rfbi, &reg, 1);
+	rfbi_write_data(ctrl->rfbi, &val, 1);
+}
+
 static void s1d1374x_identify(struct s1d1374x *ctrl)
 {
 	u8 rev = s1d1374x_read_reg(ctrl, BLIZZARD_REV_CODE);
@@ -125,8 +146,10 @@
 		t.re_cycle = max_t(unsigned int, R(2 * systim + 2000), t.re_off);
 		t.cs_pulse = 0;
 #undef R
-		if (!rfbi_set_timings(ctrl->rfbi, &t, div))
+		if (!rfbi_set_timings(ctrl->rfbi, &t, div)) {
+			ctrl->we_cycle = t.we_cycle;
 			return 0;
+		}
 	}
 
 	dev_err(ctrl->dev, "no RFBI timings for a %lu Hz controller\n",
@@ -165,10 +188,90 @@
 	}
 
 	r = s1d1374x_set_timings(ctrl, sys);
-	if (!r)
+	if (!r) {
+		ctrl->sys_clk = sys;
 		dev_info(ctrl->dev, "system clock %lu Hz (input %lu Hz)\n",
 			 sys, ext);
+	}
 	return r;
+}
+
+/*
+ * Tearing effect (Nokia's setup_tearsync()): the controller drives its TE
+ * pin from the panel timing and RFBI starts each update on it. If a line
+ * goes out faster than the panel scans one, VSYNC alone does and the frame
+ * starts in the vertical blank; otherwise HSYNC is or'ed in (or, with
+ * inverted sync polarities, the non-display periods drive TE) and the frame
+ * starts on line 1, right behind the scan. With the bus held, 8 bits.
+ */
+static void s1d1374x_setup_te(struct s1d1374x *ctrl)
+{
+	u8 hsw = s1d1374x_read_reg(ctrl, BLIZZARD_HSW);
+	u8 vsw = s1d1374x_read_reg(ctrl, BLIZZARD_VSW);
+	unsigned int hdisp = s1d1374x_read_reg(ctrl, BLIZZARD_HDISP) * 8;
+	unsigned int hndp = s1d1374x_read_reg(ctrl, BLIZZARD_HNDP) & 0x3f;
+	unsigned int vdisp = s1d1374x_read_reg(ctrl, BLIZZARD_VDISP0) |
+		(s1d1374x_read_reg(ctrl, BLIZZARD_VDISP1) & 0x03) << 8;
+	unsigned int vndp = s1d1374x_read_reg(ctrl, BLIZZARD_VNDP);
+	unsigned int pix_div =
+		((s1d1374x_read_reg(ctrl, BLIZZARD_CLK_SRC) >> 3) & 0x1f) + 1;
+	unsigned long pix_clk = ctrl->sys_clk / pix_div;
+	unsigned long tx_rate = rfbi_get_max_tx_rate(ctrl->rfbi);
+	bool inverted = !(hsw & 0x80) || !(vsw & 0x80);
+	u64 pix_tx, line_upd, hs, vs;
+	bool use_hsvs, use_ndp;
+	u8 b;
+	int r;
+
+	ctrl->te_line = -1;
+	if (!pix_clk || !hdisp || !vdisp)
+		return;
+
+	/* ps to send a pixel, and for the panel to scan a line */
+	pix_tx = ctrl->we_cycle;
+	if (tx_rate)
+		pix_tx = max_t(u64, pix_tx, div_u64(1000000000000ULL, tx_rate));
+	line_upd = div_u64((u64)(hdisp + hndp) * 1000000000000ULL, pix_clk);
+
+	use_hsvs = hdisp * pix_tx > line_upd;
+	use_ndp = use_hsvs && inverted;
+	if (use_ndp) {
+		hs = hndp;
+		vs = vndp;
+	} else {
+		hs = hsw & 0x7f;
+		vs = vsw & 0x3f;
+	}
+	hs = div_u64(hs * 1000000000000ULL, pix_clk);
+	vs = div_u64(vs * (hdisp + hndp) * 1000000000000ULL, pix_clk);
+	if (vs <= hs) {
+		dev_warn(ctrl->dev, "sync pulses unusable for tearing effect\n");
+		return;
+	}
+	/* VSYNC 150% of HSYNC for quick detection; HSYNC at most 10 ns */
+	vs = div_u64(hs * 15, 10);
+	hs = min_t(u64, hs, 10000);
+
+	r = rfbi_setup_te(ctrl->rfbi, hs, vs);
+	if (r) {
+		dev_warn(ctrl->dev, "no tearing effect: RFBI says %d\n", r);
+		return;
+	}
+
+	b = s1d1374x_read_reg(ctrl, BLIZZARD_NDISP_CTRL_STATUS) & ~0x03;
+	b |= use_hsvs ? 0x01 : 0;
+	b |= use_ndp ? 0 : 0x02;
+	b |= BIT(3);					/* TE output on */
+	s1d1374x_write_reg(ctrl, BLIZZARD_NDISP_CTRL_STATUS, b);
+	ctrl->te_line = use_hsvs ? 1 : 0;
+
+	dev_info(ctrl->dev,
+		 "panel %ux%u, %lu Hz pixel clock, %lu.%lu Hz; tearing effect on %s, line %d (%llu ps a pixel sent, %llu a line scanned)\n",
+		 hdisp, vdisp, pix_clk,
+		 pix_clk * 10 / ((hdisp + hndp) * (vdisp + vndp)) / 10,
+		 pix_clk * 10 / ((hdisp + hndp) * (vdisp + vndp)) % 10,
+		 use_ndp ? "non-display periods" : use_hsvs ? "HSYNC|VSYNC" : "VSYNC",
+		 ctrl->te_line, pix_tx, line_upd);
 }
 
 /* Wait until the last window has been written to the controller's SDRAM */
@@ -197,9 +300,14 @@
 		if (r)
 			return r;
 		s1d1374x_identify(ctrl);
+		ctrl->te_line = -1;
+		if (tearsync)
+			s1d1374x_setup_te(ctrl);
 	}
 
 	s1d1374x_wait_line_buffer(ctrl);
+	if (ctrl->te_line >= 0)
+		rfbi_set_te_line(ctrl->rfbi, ctrl->te_line);
 
 	/* Input window, then output window (same, no scaling): 0x6c - 0x8a */
 	regs[0] = 0;		regs[1] = 0;		/* X start */
