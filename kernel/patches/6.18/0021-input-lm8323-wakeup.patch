Input: lm8323 - let key presses wake the system

lm8323_suspend() cleared the IRQ's wake flag and disabled it, and resume
set the flag again (on top of the one probe set), so a key press could
never wake the system, although the device is registered as a wakeup
source. Keep the IRQ armed for wakeup over suspend when the device may
wake the system, disable it only otherwise, and set the wake flag only
for the time of the suspend.

--- a/drivers/input/keyboard/lm8323.c
+++ b/drivers/input/keyboard/lm8323.c
@@ -794,7 +794,6 @@
 	i2c_set_clientdata(client, lm);
 
 	device_init_wakeup(&client->dev, 1);
-	enable_irq_wake(client->irq);
 
 	return 0;
 }
@@ -809,8 +808,11 @@
 	struct lm8323_chip *lm = i2c_get_clientdata(client);
 	int i;
 
-	irq_set_irq_wake(client->irq, 0);
-	disable_irq(client->irq);
+	/* A key press wakes the system, unless that has been disabled */
+	if (device_may_wakeup(dev))
+		enable_irq_wake(client->irq);
+	else
+		disable_irq(client->irq);
 
 	scoped_guard(mutex, &lm->lock) {
 		lm->pm_suspend = true;
@@ -837,8 +839,10 @@
 		if (lm->pwm[i].enabled)
 			led_classdev_resume(&lm->pwm[i].cdev);
 
-	enable_irq(client->irq);
-	irq_set_irq_wake(client->irq, 1);
+	if (device_may_wakeup(dev))
+		disable_irq_wake(client->irq);
+	else
+		enable_irq(client->irq);
 
 	return 0;
 }
