ARM: dts: n8x0: add Tahvo

Tahvo (cbus address 2, IRQ on gpio111 as in the old board-n8x0 code)
drives the charger PWM, battery current measurement and the USB
transceiver; retu-mfd already handles "nokia,tahvo", but the DT never
described it.


diff -urN a/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi b/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi
--- a/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi
@@ -26,6 +26,14 @@
 				interrupts = <12 IRQ_TYPE_EDGE_RISING>;
 				reg = <0x1>;
 			};
+
+			/* Charger PWM and control, battery current, USB transceiver */
+			tahvo: tahvo@2 {
+				compatible = "nokia,tahvo";
+				interrupt-parent = <&gpio4>;
+				interrupts = <15 IRQ_TYPE_EDGE_RISING>;	/* gpio111 */
+				reg = <0x2>;
+			};
 		};
 	};
 };
