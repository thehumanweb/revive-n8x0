 ATTRIBUTE_GROUPS(lm8323);
+
+/*
+ * Firmware description (e.g. DT), as platform data. The chip reports a key
+ * as (x << 4) | y, so in "linux,keymap" row is x (0-7), column y (0-11);
+ * "keypad,num-rows" and "keypad,num-columns" are the x and y sizes of the
+ * matrix wired to the chip.
+ */
+static struct lm8323_platform_data *
+lm8323_parse_properties(struct device *dev, struct input_dev *idev)
+{
+	struct lm8323_platform_data *pdata;
+	unsigned short *keymap;
+	unsigned int rows, cols;
+	u32 debounce = 10, active = 500;
+	int err;
+
+	pdata = devm_kzalloc(dev, sizeof(*pdata), GFP_KERNEL);
+	keymap = devm_kcalloc(dev, LM8323_KEYMAP_SIZE, sizeof(*keymap),
+			      GFP_KERNEL);
+	if (!pdata || !keymap)
+		return ERR_PTR(-ENOMEM);
 
+	err = matrix_keypad_parse_properties(dev, &rows, &cols);
+	if (err)
+		return ERR_PTR(err);
+	pdata->size_x = rows;
+	pdata->size_y = cols;
+
+	/* 8 rows of 16 columns: matrix scan code == the chip's key code */
+	err = matrix_keypad_build_keymap(NULL, NULL, 8, 16, keymap, idev);
+	if (err)
+		return ERR_PTR(err);
+	pdata->keymap = keymap;
+
+	device_property_read_u32(dev, "debounce-delay-ms", &debounce);
+	device_property_read_u32(dev, "national,active-time-ms", &active);
+	pdata->debounce_time = debounce;
+	pdata->active_time = active;
+	pdata->repeat = device_property_read_bool(dev, "autorepeat");
+	device_property_read_string(dev, "label", &pdata->name);
+
+	/* LED class names for the PWM outputs; none, no LEDs */
+	err = device_property_read_string_array(dev, "national,pwm-names",
+						pdata->pwm_names,
+						LM8323_NUM_PWMS);
+	if (err < 0 && err != -EINVAL)
+		return ERR_PTR(err);
+
+	return pdata;
+}
