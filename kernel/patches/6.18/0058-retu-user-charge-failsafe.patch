+/*
+ * The charge failsafe. Maemo's BME charges from userspace through this
+ * device, setting Tahvo's charge PWM; if it dies or hangs mid-charge the
+ * PWM stays where it was with nothing regulating it. The file that last
+ * set a non-zero PWM owns the charge (opens by others, such as a monitor
+ * reading registers, change nothing), and the charger goes off (PWM 0 and
+ * CHGCTL's override to 0 %, as BME's own charger-off) when:
+ *  - the owner closes the device (BME exited or crashed);
+ *  - the owning process hasn't used either device (/dev/retu, where its
+ *    ADC readings are, or /dev/tahvo) for CHG_IDLE (BME hung; it reads
+ *    every second);
+ *  - the PWM has been on for CHG_MAX_TIME in one charge, not counting
+ *    the gaps of BME's pulses (latched until reboot);
+ *  - Retu's ADC, with BME's default calibration, reads the battery above
+ *    ~4.45 V, its NTC above ~55 or below ~-5 degrees C, or the NTC open,
+ *    twice running: latched, and the device powered off.
+ * The caps are for catastrophes only, past BME's own limits; BME and
+ * n810-guard keep the finer ones. A latched failsafe refuses non-zero PWM
+ * writes until reboot.
+ */
+#define TAHVO_REG_CHGCURR	0x04
+#define TAHVO_REG_CHGCTL	0x08
+#define CHGCTL_PWM_ZERO		0x000c	/* PWMOVR | PWMOVRZERO: PWM forced to 0 % */
+#define CHG_TICK		(4 * HZ)
+#define CHG_IDLE		(12 * HZ)
+#define CHG_MAX_TIME		(6UL * 3600 * HZ)	/* PWM-on time in one charge */
+#define CHG_NEW_AFTER		(30UL * 60 * HZ)	/* off this long: a new charge */
+#define RETU_ADC_BATTEMP	2
+#define RETU_ADC_BATVOLT	8
+/* raw codes with BME's defaults (BME.md, "Formulas"): mV = 2527 + 2.1373 x
+ * (1.3189 raw - 2); the NTC (beta 4050, divider 2.2 x R25) reads lower
+ * when hotter */
+#define VBAT_RAW_MAX		684	/* ~4450 mV */
+#define NTC_RAW_HOT		119	/* ~55 degrees C */
+#define NTC_RAW_COLD		690	/* ~-5 degrees C, or open */
+
+static struct retu_dev *retu_adc_dev;	/* Retu's, for the caps */
+/* the owning process and its last use of either device */
+static pid_t chg_tgid;
+static unsigned long chg_seen;
+
+/*
+ * The time cap counts how long the PWM has been on in this charge, not
+ * since the charge began: BME's pulsed charging (method 4) sets the PWM to
+ * 0 every minute or two to read the battery at rest, and each of those
+ * would otherwise start the clock again. A charge ends after CHG_NEW_AFTER
+ * with the PWM off (the charger unplugged, or BME's full hold).
+ * Called with ru->mutex held.
+ */
+static void tahvo_chg_timer_on(struct retu_user *ru)
+{
+	if (ru->chg_on)
+		return;
+	if (!ru->chg_ever || time_after(jiffies, ru->chg_off_at + CHG_NEW_AFTER))
+		ru->chg_on_total = 0;
+	ru->chg_on = true;
+	ru->chg_ever = true;
+	ru->chg_on_at = jiffies;
+}
+
+static void tahvo_chg_timer_off(struct retu_user *ru)
+{
+	if (!ru->chg_on)
+		return;
+	ru->chg_on_total += jiffies - ru->chg_on_at;
+	ru->chg_on = false;
+	ru->chg_off_at = jiffies;
+}
+
+static unsigned long tahvo_chg_time(struct retu_user *ru)
+{
+	return ru->chg_on_total + (ru->chg_on ? jiffies - ru->chg_on_at : 0);
+}
+
+/* Called with ru->mutex held */
+static void tahvo_chg_off(struct retu_user *ru, const char *why)
+{
+	retu_write(ru->rdev, TAHVO_REG_CHGCURR, 0);
+	retu_update_bits(ru->rdev, TAHVO_REG_CHGCTL, CHGCTL_PWM_ZERO, CHGCTL_PWM_ZERO);
+	dev_crit(ru->dev, "charge failsafe: charger off: %s\n", why);
+	tahvo_chg_timer_off(ru);
+	ru->chg_owner = NULL;
+	ru->chg_hot = 0;
+	WRITE_ONCE(chg_tgid, 0);
+}
+
+static void tahvo_chg_work(struct work_struct *work)
+{
+	struct retu_user *ru = container_of(to_delayed_work(work), struct retu_user, chg_work);
+	bool poweroff = false;
+	int pwm, vbat = -1, ntc = -1;
+
+	mutex_lock(&ru->mutex);
+	pwm = retu_read(ru->rdev, TAHVO_REG_CHGCURR);
+	if (pwm <= 0) {
+		tahvo_chg_timer_off(ru);
+		ru->chg_owner = NULL;
+		ru->chg_hot = 0;
+		mutex_unlock(&ru->mutex);
+		return;
+	}
+	if (retu_adc_dev) {
+		vbat = retu_read_adc(retu_adc_dev, RETU_ADC_BATVOLT);
+		ntc = retu_read_adc(retu_adc_dev, RETU_ADC_BATTEMP);
+	}
+	if ((vbat >= 0 && vbat > VBAT_RAW_MAX) ||
+	    (ntc >= 0 && (ntc <= NTC_RAW_HOT || ntc >= NTC_RAW_COLD)))
+		ru->chg_hot++;
+	else
+		ru->chg_hot = 0;
+	if (ru->chg_hot >= 2) {
+		dev_crit(ru->dev, "charge failsafe: battery %d, NTC %d (raw; caps %d, %d-%d)\n",
+			 vbat, ntc, VBAT_RAW_MAX, NTC_RAW_HOT, NTC_RAW_COLD);
+		tahvo_chg_off(ru, "battery voltage or temperature past its cap; powering off");
+		ru->chg_latched = true;
+		poweroff = true;
+	} else if (!ru->chg_owner) {
+		tahvo_chg_off(ru, "PWM on with no owner");
+	} else if (time_after(jiffies, READ_ONCE(chg_seen) + CHG_IDLE)) {
+		tahvo_chg_off(ru, "the charging process stopped using the device");
+	} else if (tahvo_chg_time(ru) > CHG_MAX_TIME) {
+		tahvo_chg_off(ru, "charging longer than the time limit; off until reboot");
+		ru->chg_latched = true;
+	} else {
+		schedule_delayed_work(&ru->chg_work, CHG_TICK);
+	}
+	mutex_unlock(&ru->mutex);
+	if (poweroff)
+		orderly_poweroff(true);
+}
+
+/* filp's charge PWM write went through: tracks the charge's owner. Called
+ * with ru->mutex held. */
+static void tahvo_chg_written(struct retu_user *ru, struct file *filp)
+{
+	int pwm = retu_read(ru->rdev, TAHVO_REG_CHGCURR);
+
+	if (pwm <= 0) {
+		tahvo_chg_timer_off(ru);
+		ru->chg_owner = NULL;
+		WRITE_ONCE(chg_tgid, 0);
+		return;
+	}
+	tahvo_chg_timer_on(ru);
+	ru->chg_owner = filp;
+	WRITE_ONCE(chg_seen, jiffies);
+	WRITE_ONCE(chg_tgid, current->tgid);
+	schedule_delayed_work(&ru->chg_work, CHG_TICK);
+}
+
 static int retu_user_open(struct inode *inode, struct file *filp)
 {
 	/* misc_open() left our miscdevice here */
@@ -326,6 +488,8 @@
 		retu_user_unreg_irq_handlers(ru);
 		ru->subscr = NULL;
 	}
+	if (ru->chip == &tahvo_chip && ru->chg_owner == filp)
+		tahvo_chg_off(ru, "the charging process closed the device");
 	mutex_unlock(&ru->mutex);
 
 	return 0;
@@ -337,6 +501,9 @@
 	struct retu_user *ru = filp->private_data;
 	struct retu_tahvo_write_parms par;
 
+	if (READ_ONCE(chg_tgid) == current->tgid)
+		WRITE_ONCE(chg_seen, jiffies);	/* the charge's owner is alive */
+
 	if (cmd == URT_IOCT_IRQ_SUBSCR)
 		return retu_user_subscribe_to_irq(ru, arg, filp);
 
@@ -346,8 +513,24 @@
 	if (cmd == ru->chip->write_cmd) {
 		if (copy_from_user(&par, (void __user *)arg, sizeof(par)))
 			return -EFAULT;
-		par.result = retu_user_write_with_mask(ru, par.field,
-						       par.value);
+		if (ru->chip == &tahvo_chip &&
+		    FIELD_REG(par.field) == TAHVO_REG_CHGCURR) {
+			mutex_lock(&ru->mutex);
+			if (ru->chg_latched && par.value) {
+				dev_crit_ratelimited(ru->dev,
+					"charge failsafe: latched, charge PWM write refused\n");
+				par.result = -EPERM;
+			} else {
+				par.result = retu_user_write_with_mask(ru, par.field,
+								       par.value);
+				if (!par.result)
+					tahvo_chg_written(ru, filp);
+			}
+			mutex_unlock(&ru->mutex);
+		} else {
+			par.result = retu_user_write_with_mask(ru, par.field,
+							       par.value);
+		}
 		if (copy_to_user((void __user *)arg, &par, sizeof(par)))
 			return -EFAULT;
 		return 0;
@@ -443,6 +626,9 @@
 	for (i = 0; i < RETU_USER_MAX_IRQ_BUF_LEN; i++)
 		list_add(&ru->pool[i].node, &ru->reserve);
 	init_waitqueue_head(&ru->wait);
+	INIT_DELAYED_WORK(&ru->chg_work, tahvo_chg_work);
+	if (ru->chip == &retu_chip)
+		retu_adc_dev = ru->rdev;
 
 	ru->misc.minor = ru->chip->minor;
 	ru->misc.name = ru->chip->name;
@@ -459,8 +645,13 @@
 	struct retu_user *ru = platform_get_drvdata(pdev);
 
 	misc_deregister(&ru->misc);
+	cancel_delayed_work_sync(&ru->chg_work);
 	mutex_lock(&ru->mutex);
 	retu_user_unreg_irq_handlers(ru);
+	if (ru->chip == &tahvo_chip && retu_read(ru->rdev, TAHVO_REG_CHGCURR) > 0)
+		tahvo_chg_off(ru, "the driver is going away");
+	if (ru->chip == &retu_chip)
+		retu_adc_dev = NULL;
 	mutex_unlock(&ru->mutex);
 }
 
