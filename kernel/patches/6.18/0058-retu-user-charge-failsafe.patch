+	bool			chg_on;		/* the PWM on, since chg_on_at */
+	bool			chg_ever;
+	unsigned long		chg_on_at, chg_off_at;
+	unsigned long		chg_on_total;	/* this charge's PWM-on time before chg_on_at */
+	bool			chg_latched;
+	int			chg_hot;
+	struct delayed_work	chg_work;
