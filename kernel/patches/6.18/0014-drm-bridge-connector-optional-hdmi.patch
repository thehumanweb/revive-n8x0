drm/display: bridge connector: optional HDMI, audio and CEC support

DRM_BRIDGE_CONNECTOR unconditionally selects the HDMI state, HDMI audio
and HDMI CEC helpers (and through them the CEC core), so every driver
that terminates its bridge chain with drm_bridge_connector, omapdrm
included, carries them. The N800/N810 have a fixed panel and no HDMI;
the helpers and the CEC core cost 13 KB of the compressed image, which
must fit a 2.1 MB partition.

Add DRM_BRIDGE_CONNECTOR_HDMI (default y, visible with EXPERT). Without
it the helpers aren't selected, the calls into them compile away, and
drm_bridge_connector_init() refuses bridge chains with HDMI, HDMI/DP
audio or CEC operations (-EOPNOTSUPP) instead of silently ignoring them.

--- a/drivers/gpu/drm/display/Kconfig
+++ b/drivers/gpu/drm/display/Kconfig
@@ -16,12 +16,24 @@
 
 config DRM_BRIDGE_CONNECTOR
 	bool
-	select DRM_DISPLAY_HDMI_AUDIO_HELPER
-	select DRM_DISPLAY_HDMI_CEC_HELPER
-	select DRM_DISPLAY_HDMI_STATE_HELPER
+	select DRM_DISPLAY_HDMI_AUDIO_HELPER if DRM_BRIDGE_CONNECTOR_HDMI
+	select DRM_DISPLAY_HDMI_CEC_HELPER if DRM_BRIDGE_CONNECTOR_HDMI
+	select DRM_DISPLAY_HDMI_STATE_HELPER if DRM_BRIDGE_CONNECTOR_HDMI
 	help
 	  DRM connector implementation terminating DRM bridge chains.
 
+config DRM_BRIDGE_CONNECTOR_HDMI
+	bool "HDMI, HDMI/DP audio and CEC support in the bridge connector" if EXPERT
+	depends on DRM_BRIDGE_CONNECTOR
+	default y
+	help
+	  Support bridges with HDMI, HDMI or DisplayPort audio, or CEC
+	  operations in the bridge connector. This pulls in the HDMI state,
+	  audio and CEC helpers and the CEC core.
+
+	  Say N only for devices without such outputs (e.g. a fixed panel);
+	  bridge chains using these operations then fail to get a connector.
+
 config DRM_DISPLAY_DP_AUX_CEC
 	bool "Enable DisplayPort CEC-Tunneling-over-AUX HDMI support"
 	select DRM_DISPLAY_DP_HELPER
