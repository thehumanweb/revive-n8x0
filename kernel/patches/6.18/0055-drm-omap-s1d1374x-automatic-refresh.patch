+/*
+ * The rate at which an update of w x h pixels takes two scans: its
+ * transfer time plus the setup around it (measured on the N810: about 15%
+ * and 2 ms), as two frame periods, to the nearest Hz. A full 800x480 frame
+ * gives 40 Hz, which a sweep found to be the one even rate: 98 of 120
+ * flips 50 ms apart, against 55-73 at 37-39 and 41 Hz.
+ */
+static unsigned int s1d1374x_two_scan_hz(struct s1d1374x *ctrl, u16 w, u16 h)
+{
+	u64 cost = (u64)w * h * ctrl->pix_tx;		/* ps */
+
+	cost = div_u64(cost * 115, 100) + 2000000000ULL;
+	return (unsigned int)div64_u64(2 * 1000000000000ULL + cost / 2, cost);
+}
+
 static int s1d1374x_prepare_update(void *data, u16 x, u16 y, u16 w, u16 h,
 				   u16 frame_w, u16 frame_h)
 {
@@ -359,11 +390,39 @@
 		ctrl->te_line = -1;
 		if (tearsync)
 			s1d1374x_setup_te(ctrl);
-	} else if (refresh != ctrl->refresh_set) {
+	} else if (refresh && refresh != ctrl->refresh_set) {
 		s1d1374x_set_refresh(ctrl, refresh);
 		ctrl->te_line = -1;
 		if (tearsync)
 			s1d1374x_setup_te(ctrl);
+	} else if (!refresh) {
+		/* 0: the bootloader's rate */
+		unsigned int want = refresh_auto ? 0 :
+			s1d1374x_two_scan_hz(ctrl, ctrl->panel_w, ctrl->panel_h);
+
+		/* lines it covers on the panel: a smaller frame is scaled up */
+		u32 oh = ctrl->panel_h && frame_h && frame_h < ctrl->panel_h ?
+			 (u32)h * ctrl->panel_h / frame_h : h;
+
+		if (refresh_auto && ctrl->te_line >= 0 &&
+		    (u64)w * h * ctrl->pix_tx >= (u64)oh * ctrl->line_upd) {
+			/*
+			 * One slow rate, a whole frame's: rates worked out per
+			 * update follow each update's height (scrolling) and
+			 * retune the panel nearly every frame, which puts rows
+			 * of an update in the wrong scan
+			 */
+			want = s1d1374x_two_scan_hz(ctrl, ctrl->panel_w, ctrl->panel_h);
+			ctrl->slow_until = jiffies + msecs_to_jiffies(500);
+		} else if (ctrl->refresh_set && time_before(jiffies, ctrl->slow_until)) {
+			want = ctrl->refresh_set;	/* stay slow a while */
+		}
+		if (want != ctrl->refresh_set) {
+			s1d1374x_set_refresh(ctrl, want);
+			ctrl->te_line = -1;
+			if (tearsync)
+				s1d1374x_setup_te(ctrl);
+		}
 	}
 
