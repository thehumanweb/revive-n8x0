 		 "panel %ux%u, %lu Hz pixel clock, %lu.%lu Hz; tearing effect on %s, line %d (%llu ps a pixel sent, %llu a line scanned)\n",
 		 hdisp, vdisp, pix_clk,
 		 pix_clk * 10 / ((hdisp + hndp) * (vdisp + vndp)) / 10,
 		 pix_clk * 10 / ((hdisp + hndp) * (vdisp + vndp)) % 10,
 		 use_ndp ? "non-display periods" : use_hsvs ? "HSYNC|VSYNC" : "VSYNC",
