+		else if (tag == OMAP_TAG_GPIO_SWITCH && tlen >= 16)
+			n8x0_maemo_add_switch(data, tlen);
 
 		p = data + ALIGN(tlen, 4);
 	}
@@ -205,6 +543,7 @@
 				   component_version_show);
 
