--- a/Documentation/devicetree/bindings/mfd/ti,tsc2301.yaml
+++ b/Documentation/devicetree/bindings/mfd/ti,tsc2301.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/ti,tsc2301.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments TSC2301 touchscreen, keypad and audio controller
+
+maintainers:
+  - Carsten Munk <carsten.munk@gmail.com>
+
+description:
+  The TSC2301 is a 4-wire resistive touchscreen controller with a 4x4
+  keypad scanner and a stereo audio codec, on SPI with 16-bit words. The
+  Nokia N800 uses all three. Keypad bits are numbered row * 4 + column.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+  - $ref: /schemas/input/touchscreen/touchscreen.yaml#
+  - $ref: /schemas/input/matrix-keymap.yaml#
+
+properties:
+  compatible:
+    const: ti,tsc2301
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 33000000
+
+  interrupts:
+    items:
+      - description: DAV, low when touchscreen data is ready
+      - description: KBIRQ, low when a key is down
+
+  interrupt-names:
+    items:
+      - const: dav
+      - const: kbirq
+
+  reset-gpios:
+    maxItems: 1
+
+  ti,x-plate-ohms:
+    description: resistance of the touchscreen's X plates in ohm (default 280)
+
+  label:
+    description: name of the keypad input device
+
+  autorepeat: true
+  linux,keymap: true
+  touchscreen-fuzz-pressure: true
+  touchscreen-fuzz-x: true
+  touchscreen-fuzz-y: true
+  touchscreen-max-pressure: true
+  touchscreen-size-x: true
+  touchscreen-size-y: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/input/input.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "ti,tsc2301";
+            reg = <0>;
+            spi-max-frequency = <6000000>;
+            interrupts-extended = <&gpio4 7 IRQ_TYPE_EDGE_FALLING>,
+                                  <&gpio4 13 IRQ_TYPE_EDGE_FALLING>;
+            interrupt-names = "dav", "kbirq";
+            reset-gpios = <&gpio4 22 GPIO_ACTIVE_HIGH>;
+            ti,x-plate-ohms = <280>;
+            touchscreen-max-pressure = <2048>;
+            linux,keymap = <MATRIX_KEY(0, 1, KEY_UP)
+                            MATRIX_KEY(1, 1, KEY_ENTER)>;
+        };
+    };
