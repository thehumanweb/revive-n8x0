--- a/drivers/mfd/tsc2301.c
+++ b/drivers/mfd/tsc2301.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * TI TSC2301 core: SPI register access, reset, and the touchscreen and
+ * keypad as child devices (the audio codec is not supported yet).
+ *
+ * After Nokia's 2.6.21 tsc2301-core.c,
+ * Copyright (C) 2005, 2006 Nokia Corporation (Juha Yrjölä).
+ */
+
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mfd/core.h>
+#include <linux/mfd/tsc2301.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/spi/spi.h>
+
+/*
+ * The chip needs 16-bit SPI words, as Nokia's driver sent them: regmap's
+ * buffers hold CPU-endian words, and the read flag is bit 15 of the
+ * command word.
+ */
+#ifdef __BIG_ENDIAN
+#define TSC2301_READ_FLAG	0x80
+#else
+#define TSC2301_READ_FLAG	0x8000
+#endif
+
+static const struct regmap_config tsc2301_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 16,
+	.reg_stride = TSC2301_REG_STRIDE,
+	.max_register = TSC2301_REG_MAX,
+	.reg_format_endian = REGMAP_ENDIAN_NATIVE,
+	.val_format_endian = REGMAP_ENDIAN_NATIVE,
+	.read_flag_mask = TSC2301_READ_FLAG,
+	.cache_type = REGCACHE_NONE,
+};
+
+static const struct mfd_cell tsc2301_cells[] = {
+	{ .name = "tsc2301-ts" },
+	{ .name = "tsc2301-keypad" },
+};
+
+/* Keypad interrupt mode, CONFIG2 bits 15-14 (Nokia: tsc2301_write_kbc) */
+int tsc2301_write_kbc(struct tsc2301 *tsc, unsigned int mode)
+{
+	u16 val;
+	int ret;
+
+	guard(mutex)(&tsc->lock);
+	val = (tsc->config2 & ~TSC2301_CONFIG2_KBC_MASK) |
+	      TSC2301_CONFIG2_KBC(mode & 3);
+	ret = regmap_write(tsc->regmap, TSC2301_REG_CONFIG2, val);
+	if (!ret)
+		tsc->config2 = val;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tsc2301_write_kbc);
+
+static int __tsc2301_kp_start(struct tsc2301 *tsc)
+{
+	int ret;
+
+	ret = regmap_write(tsc->regmap, TSC2301_REG_KPMASK, tsc->kp_mask);
+	if (ret)
+		return ret;
+	return regmap_write(tsc->regmap, TSC2301_REG_KEY,
+			    TSC2301_KEY_DEBOUNCE_20MS);
+}
+
+/* Start (with the keys in @mask ignored) or stop keypad scanning */
+int tsc2301_kp_scan(struct tsc2301 *tsc, bool on, u16 mask)
+{
+	guard(mutex)(&tsc->lock);
+	tsc->kp_scanning = on;
+	tsc->kp_mask = mask;
+	if (on)
+		return __tsc2301_kp_start(tsc);
+	return regmap_write(tsc->regmap, TSC2301_REG_KEY, TSC2301_KEY_STOP);
+}
+EXPORT_SYMBOL_GPL(tsc2301_kp_scan);
+
+/*
+ * Nokia: the keypad scanner can get stuck busy, with no more interrupts,
+ * after this sequence: a key held, keypad disabled, all keys released,
+ * keypad enabled, touchscreen scanning disabled. So whenever the
+ * touchscreen scanning changes, restart a running keypad scan.
+ */
+void tsc2301_kp_restart(struct tsc2301 *tsc)
+{
+	guard(mutex)(&tsc->lock);
+	if (tsc->kp_scanning)
+		__tsc2301_kp_start(tsc);
+}
+EXPORT_SYMBOL_GPL(tsc2301_kp_restart);
+
+static int tsc2301_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct gpio_desc *reset;
+	struct tsc2301 *tsc;
+	unsigned int val;
+	int ret;
+
+	tsc = devm_kzalloc(dev, sizeof(*tsc), GFP_KERNEL);
+	if (!tsc)
+		return -ENOMEM;
+	tsc->dev = dev;
+	ret = devm_mutex_init(dev, &tsc->lock);
+	if (ret)
+		return ret;
+	spi_set_drvdata(spi, tsc);
+
+	spi->mode = SPI_MODE_0;
+	spi->bits_per_word = 16;
+	ret = spi_setup(spi);
+	if (ret)
+		return ret;
+
+	tsc->regmap = devm_regmap_init_spi(spi, &tsc2301_regmap_config);
+	if (IS_ERR(tsc->regmap))
+		return PTR_ERR(tsc->regmap);
+
+	/* Nokia drove the reset line high for 1 ms, then low */
+	reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset), "reset GPIO\n");
+	if (reset) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(reset, 0);
+	}
+
+	ret = regmap_write(tsc->regmap, TSC2301_REG_RESET, TSC2301_RESET_MAGIC);
+	if (ret)
+		return ret;
+	usleep_range(1000, 2000);
+
+	/* After reset the ADC is idle and the DAC powered down */
+	ret = regmap_read(tsc->regmap, TSC2301_REG_ADC, &val);
+	if (ret)
+		return ret;
+	if (!(val & TSC2301_ADC_STOP))
+		return dev_err_probe(dev, -ENODEV, "invalid ADC register %04x\n", val);
+	ret = regmap_read(tsc->regmap, TSC2301_REG_DAC, &val);
+	if (ret)
+		return ret;
+	if (!(val & TSC2301_DAC_PD))
+		return dev_err_probe(dev, -ENODEV, "invalid DAC register %04x\n", val);
+
+	ret = regmap_write(tsc->regmap, TSC2301_REG_KEY, TSC2301_KEY_STOP);
+	if (ret)
+		return ret;
+
+	/* Bit 15 is set after reset but doesn't read back */
+	ret = regmap_read(tsc->regmap, TSC2301_REG_CONFIG2, &val);
+	if (ret)
+		return ret;
+	tsc->config2 = val | BIT(15);
+
+	return devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, tsc2301_cells,
+				    ARRAY_SIZE(tsc2301_cells), NULL, 0, NULL);
+}
+
+static const struct of_device_id tsc2301_of_match[] = {
+	{ .compatible = "ti,tsc2301" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tsc2301_of_match);
+
+static const struct spi_device_id tsc2301_spi_ids[] = {
+	{ "tsc2301" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, tsc2301_spi_ids);
+
+static struct spi_driver tsc2301_driver = {
+	.driver = {
+		.name = "tsc2301",
+		.of_match_table = tsc2301_of_match,
+	},
+	.id_table = tsc2301_spi_ids,
+	.probe = tsc2301_probe,
+};
+module_spi_driver(tsc2301_driver);
+
+MODULE_AUTHOR("Juha Yrjölä <juha.yrjola@nokia.com>");
+MODULE_DESCRIPTION("TI TSC2301 core driver");
+MODULE_LICENSE("GPL");
--- a/include/linux/mfd/tsc2301.h
+++ b/include/linux/mfd/tsc2301.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * TI TSC2301: touchscreen, keypad and audio codec on SPI
+ *
+ * Register definitions after Nokia's 2.6.21 <linux/spi/tsc2301.h>,
+ * Copyright (C) 2005-2007 Nokia Corporation.
+ */
+#ifndef __LINUX_MFD_TSC2301_H
+#define __LINUX_MFD_TSC2301_H
+
+#include <linux/bits.h>
+#include <linux/mutex.h>
+#include <linux/types.h>
+
+struct device;
+struct regmap;
+
+/*
+ * The chip takes 16-bit SPI words. A command word holds the read flag
+ * (bit 15), the page (bits 12-11) and the address (bits 10-5); a write
+ * sends the data word next, a read clocks out data words, the address
+ * incrementing after each one.
+ */
+#define TSC2301_REG(page, addr)		(((page) << 11) | ((addr) << 5))
+#define TSC2301_REG_STRIDE		TSC2301_REG(0, 1)
+
+/* Page 0: conversion results */
+#define TSC2301_REG_X			TSC2301_REG(0, 0)
+#define TSC2301_REG_Y			TSC2301_REG(0, 1)
+#define TSC2301_REG_Z1			TSC2301_REG(0, 2)
+#define TSC2301_REG_Z2			TSC2301_REG(0, 3)
+#define TSC2301_REG_KPDATA		TSC2301_REG(0, 4)
+/* Page 1: control */
+#define TSC2301_REG_ADC			TSC2301_REG(1, 0)
+#define TSC2301_REG_KEY			TSC2301_REG(1, 1)
+#define TSC2301_REG_DAC			TSC2301_REG(1, 2)
+#define TSC2301_REG_REF			TSC2301_REG(1, 3)
+#define TSC2301_REG_RESET		TSC2301_REG(1, 4)
+#define TSC2301_REG_CONFIG		TSC2301_REG(1, 5)
+#define TSC2301_REG_CONFIG2		TSC2301_REG(1, 6)
+#define TSC2301_REG_KPMASK		TSC2301_REG(1, 16)
+/* Page 2: audio */
+#define TSC2301_REG_AUDCNTL		TSC2301_REG(2, 0)
+#define TSC2301_REG_ADCVOL		TSC2301_REG(2, 1)
+#define TSC2301_REG_DACVOL		TSC2301_REG(2, 2)
+#define TSC2301_REG_BPVOL		TSC2301_REG(2, 3)
+#define TSC2301_REG_KEYCTL		TSC2301_REG(2, 4)
+#define TSC2301_REG_PD_MISC		TSC2301_REG(2, 5)
+#define TSC2301_REG_GPIO		TSC2301_REG(2, 6)
+#define TSC2301_REG_ADCLKCFG		TSC2301_REG(2, 27)
+#define TSC2301_REG_MAX			TSC2301_REG(2, 31)
+
+/* ADC: touchscreen conversion control */
+#define TSC2301_ADC_CTRL_BY_TSC		BIT(15)	/* else by the host */
+#define TSC2301_ADC_STOP		BIT(14)	/* write: stop; read: idle */
+#define TSC2301_ADC_FUNC_XYZ		(2 << 10)
+#define TSC2301_ADC_RES_12BIT		(3 << 8)
+#define TSC2301_ADC_AVG(n)		((n) << 6) /* none, 4, 8, 16 samples */
+#define TSC2301_ADC_CLK_2MHZ		(2 << 4)
+#define TSC2301_ADC_CLK_1MHZ		(3 << 4)
+#define TSC2301_ADC_STAB(n)		((n) << 1) /* 0, 100us, 500us, 1, 5, 10, 50, 100ms */
+
+/* KEY: keypad scan control */
+#define TSC2301_KEY_STOP		BIT(14)
+#define TSC2301_KEY_DEBOUNCE_20MS	(2 << 11)
+
+/* DAC: reads 1 in bit 15 after reset */
+#define TSC2301_DAC_PD			BIT(15)
+
+/* CONFIG2: keypad interrupt mode (bit 15 doesn't read back) */
+#define TSC2301_CONFIG2_KBC_MASK	(3 << 14)
+#define TSC2301_CONFIG2_KBC(n)		((n) << 14)
+
+#define TSC2301_RESET_MAGIC		0xbb00
+
+struct tsc2301 {
+	struct device *dev;
+	struct regmap *regmap;
+
+	struct mutex lock;	/* CONFIG2 shadow, keypad scan state */
+	u16 config2;
+	bool kp_scanning;
+	u16 kp_mask;
+};
+
+int tsc2301_write_kbc(struct tsc2301 *tsc, unsigned int mode);
+int tsc2301_kp_scan(struct tsc2301 *tsc, bool on, u16 mask);
+void tsc2301_kp_restart(struct tsc2301 *tsc);
+
+#endif /* __LINUX_MFD_TSC2301_H */
