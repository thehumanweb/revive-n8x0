--- a/drivers/input/touchscreen/tsc2301_ts.c
+++ b/drivers/input/touchscreen/tsc2301_ts.c
@@ -0,0 +1,319 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * TI TSC2301 touchscreen
+ *
+ * After Nokia's 2.6.21 tsc2301_ts.c,
+ * Copyright (C) 2005-2007 Nokia Corporation
+ * (Jarkko Oikarinen, Imre Deak, Juha Yrjölä).
+ *
+ * The chip converts X, Y, Z1 and Z2 by itself while the pen is down and
+ * pulls DAV low when a set is ready; reading it releases DAV. With no DAV
+ * for 20 ms the pen is up. Samples are filtered as Nokia did: the touch
+ * resistance must stay below a limit (a lower one for the first sample),
+ * positions are averaged over 4 samples, the reported pressure is the
+ * lowest resistance of the last 16 samples, and a position within 8 units
+ * of the last one is not reported unless the pressure rose.
+ */
+
+#include <linux/input.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/tsc2301.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+
+#define TSC2301_TS_PENUP_MS		20
+#define TSC2301_TS_SAMPLES		4
+#define TSC2301_TS_P_SAMPLES		16
+#define TSC2301_TS_RECT			8
+#define TSC2301_TS_TOUCH_PRESSURE	400	/* first sample limit */
+#define MAX_12BIT			0xfff
+
+struct tsc2301_ts {
+	struct tsc2301 *tsc;
+	struct input_dev *idev;
+	struct touchscreen_properties prop;
+	struct timer_list penup_timer;
+	spinlock_t lock;		/* filter and pen state */
+	int irq;
+
+	u32 x_plate_ohm;
+	int p_max;
+	int touch_pressure;
+
+	int sample_cnt;
+	int avg_x, avg_y;
+	int p_n;
+	int p_buf[TSC2301_TS_P_SAMPLES];
+	int x, y, p;
+	bool sample_sent;
+	bool pen_down;
+	bool pen_active;
+};
+
+/*
+ * Nokia, after the TSC2301 errata: stop, configure host-controlled
+ * conversions, then hand conversions to the chip. Then a 2.5 V internal
+ * reference (100 us settling) and 340 us precharge, 544 us sense time.
+ * 8-sample averaging and 1 ms settling are Nokia's N800 settings for the
+ * LS041Y3 panel (its LPH8923 used 100 us).
+ */
+static int tsc2301_ts_start(struct tsc2301_ts *ts)
+{
+	struct regmap *map = ts->tsc->regmap;
+	static const u16 adc[] = {
+		TSC2301_ADC_STOP | TSC2301_ADC_RES_12BIT |
+			TSC2301_ADC_CLK_2MHZ | TSC2301_ADC_STAB(7),
+		TSC2301_ADC_FUNC_XYZ | TSC2301_ADC_RES_12BIT |
+			TSC2301_ADC_AVG(3) | TSC2301_ADC_CLK_1MHZ |
+			TSC2301_ADC_STAB(7),
+		TSC2301_ADC_CTRL_BY_TSC | TSC2301_ADC_FUNC_XYZ |
+			TSC2301_ADC_RES_12BIT | TSC2301_ADC_CLK_2MHZ |
+			TSC2301_ADC_AVG(2) | TSC2301_ADC_STAB(3),
+	};
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(adc); i++) {
+		ret = regmap_write(map, TSC2301_REG_ADC, adc[i]);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_write(map, TSC2301_REG_REF, BIT(4) | BIT(2) | BIT(0));
+	if (!ret)
+		ret = regmap_write(map, TSC2301_REG_CONFIG, 3 << 3 | 2 << 0);
+	tsc2301_kp_restart(ts->tsc);
+	return ret;
+}
+
+static void tsc2301_ts_stop(struct tsc2301_ts *ts)
+{
+	regmap_write(ts->tsc->regmap, TSC2301_REG_ADC, TSC2301_ADC_STOP);
+	tsc2301_kp_restart(ts->tsc);
+}
+
+static void tsc2301_ts_report(struct tsc2301_ts *ts, int x, int y, int p)
+{
+	struct input_dev *idev = ts->idev;
+
+	if (p) {
+		touchscreen_report_pos(idev, &ts->prop, x, y, false);
+		input_report_abs(idev, ABS_PRESSURE, p);
+		if (!ts->pen_down)
+			input_report_key(idev, BTN_TOUCH, 1);
+		ts->pen_down = true;
+	} else {
+		input_report_abs(idev, ABS_PRESSURE, 0);
+		if (ts->pen_down)
+			input_report_key(idev, BTN_TOUCH, 0);
+		ts->pen_down = false;
+	}
+	input_sync(idev);
+}
+
+/* Nokia's tsc2301_ts_rx(); called with ts->lock held */
+static void tsc2301_ts_sample(struct tsc2301_ts *ts, int x, int y,
+			      int z1, int z2)
+{
+	int pressure, limit, i;
+	bool inside;
+
+	if (x > MAX_12BIT || y > MAX_12BIT)
+		return;
+	if (z1 < 100 || z1 > 4000 || z2 < z1 || z2 > 4000)
+		return;
+
+	pressure = x * (z2 - z1) / z1;
+	pressure = pressure * ts->x_plate_ohm / 4096;
+	limit = ts->sample_sent ? ts->p_max : ts->touch_pressure;
+	if (pressure > limit)
+		return;
+
+	if (!ts->pen_active) {
+		ts->pen_active = true;
+		ts->sample_cnt = 0;
+		ts->avg_x = 0;
+		ts->avg_y = 0;
+		ts->p_n = 0;
+		memset(ts->p_buf, 0, sizeof(ts->p_buf));
+	}
+
+	ts->avg_x += x;
+	ts->avg_y += y;
+	ts->p_buf[ts->p_n++] = pressure;
+	if (ts->p_n >= TSC2301_TS_P_SAMPLES)
+		ts->p_n = 0;
+
+	if (++ts->sample_cnt < TSC2301_TS_SAMPLES)
+		return;
+
+	x = ts->avg_x / TSC2301_TS_SAMPLES;
+	y = ts->avg_y / TSC2301_TS_SAMPLES;
+	ts->sample_cnt = 0;
+	ts->avg_x = 0;
+	ts->avg_y = 0;
+
+	for (i = 0; i < TSC2301_TS_P_SAMPLES; i++)
+		if (ts->p_buf[i] && ts->p_buf[i] < pressure)
+			pressure = ts->p_buf[i];
+
+	inside = ts->sample_sent &&
+		 abs(x - ts->x) < TSC2301_TS_RECT &&
+		 abs(y - ts->y) < TSC2301_TS_RECT;
+	if (inside) {
+		x = ts->x;
+		y = ts->y;
+	}
+	if (!inside || pressure < ts->p) {
+		tsc2301_ts_report(ts, x, y, pressure);
+		ts->sample_sent = true;
+		ts->x = x;
+		ts->y = y;
+		ts->p = pressure;
+	}
+}
+
+static irqreturn_t tsc2301_ts_irq(int irq, void *data)
+{
+	struct tsc2301_ts *ts = data;
+	unsigned long flags;
+	u16 d[4];
+	int ret;
+
+	/* X, Y, Z1, Z2 in one read: the address increments */
+	ret = regmap_bulk_read(ts->tsc->regmap, TSC2301_REG_X, d, ARRAY_SIZE(d));
+	if (ret) {
+		dev_err_ratelimited(ts->idev->dev.parent, "read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	spin_lock_irqsave(&ts->lock, flags);
+	tsc2301_ts_sample(ts, d[0], d[1], d[2], d[3]);
+	spin_unlock_irqrestore(&ts->lock, flags);
+
+	mod_timer(&ts->penup_timer,
+		  jiffies + msecs_to_jiffies(TSC2301_TS_PENUP_MS));
+	return IRQ_HANDLED;
+}
+
+static void tsc2301_ts_penup(struct timer_list *t)
+{
+	struct tsc2301_ts *ts = timer_container_of(ts, t, penup_timer);
+	unsigned long flags;
+
+	spin_lock_irqsave(&ts->lock, flags);
+	if (ts->sample_sent) {
+		tsc2301_ts_report(ts, 0, 0, 0);
+		ts->sample_sent = false;
+	}
+	ts->pen_active = false;
+	spin_unlock_irqrestore(&ts->lock, flags);
+}
+
+static int tsc2301_ts_open(struct input_dev *idev)
+{
+	struct tsc2301_ts *ts = input_get_drvdata(idev);
+	int ret;
+
+	ret = tsc2301_ts_start(ts);
+	if (ret)
+		return ret;
+	enable_irq(ts->irq);
+	return 0;
+}
+
+static void tsc2301_ts_close(struct input_dev *idev)
+{
+	struct tsc2301_ts *ts = input_get_drvdata(idev);
+
+	disable_irq(ts->irq);
+	tsc2301_ts_stop(ts);
+	timer_delete_sync(&ts->penup_timer);
+	tsc2301_ts_penup(&ts->penup_timer);
+}
+
+static void tsc2301_ts_shutdown_timer(void *timer)
+{
+	timer_shutdown_sync(timer);
+}
+
+static int tsc2301_ts_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct tsc2301_ts *ts;
+	struct input_dev *idev;
+	int ret;
+
+	/* Properties and interrupts are in the chip's node */
+	device_set_of_node_from_dev(dev, dev->parent);
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->tsc = dev_get_drvdata(dev->parent);
+	spin_lock_init(&ts->lock);
+	timer_setup(&ts->penup_timer, tsc2301_ts_penup, 0);
+
+	ts->irq = fwnode_irq_get_byname(dev_fwnode(dev), "dav");
+	if (ts->irq < 0)
+		return dev_err_probe(dev, ts->irq, "no DAV interrupt\n");
+
+	ts->x_plate_ohm = 280;
+	device_property_read_u32(dev, "ti,x-plate-ohms", &ts->x_plate_ohm);
+
+	idev = devm_input_allocate_device(dev);
+	if (!idev)
+		return -ENOMEM;
+	ts->idev = idev;
+	idev->name = "TSC2301 touchscreen";
+	idev->phys = "tsc2301/input0";
+	idev->id.bustype = BUS_SPI;
+	idev->open = tsc2301_ts_open;
+	idev->close = tsc2301_ts_close;
+	input_set_drvdata(idev, ts);
+
+	input_set_capability(idev, EV_KEY, BTN_TOUCH);
+	input_set_abs_params(idev, ABS_X, 0, MAX_12BIT, 4, 0);
+	input_set_abs_params(idev, ABS_Y, 0, MAX_12BIT, 8, 0);
+	input_set_abs_params(idev, ABS_PRESSURE, 0, 2048, 2, 0);
+	touchscreen_parse_properties(idev, false, &ts->prop);
+
+	ts->p_max = input_abs_get_max(idev, ABS_PRESSURE);
+	ts->touch_pressure = min(TSC2301_TS_TOUCH_PRESSURE, ts->p_max);
+
+	ret = devm_request_threaded_irq(dev, ts->irq, NULL, tsc2301_ts_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"tsc2301-ts", ts);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, tsc2301_ts_shutdown_timer,
+				       &ts->penup_timer);
+	if (ret)
+		return ret;
+
+	return input_register_device(idev);
+}
+
+static const struct platform_device_id tsc2301_ts_ids[] = {
+	{ "tsc2301-ts" },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, tsc2301_ts_ids);
+
+static struct platform_driver tsc2301_ts_driver = {
+	.driver = {
+		.name = "tsc2301-ts",
+	},
+	.id_table = tsc2301_ts_ids,
+	.probe = tsc2301_ts_probe,
+};
+module_platform_driver(tsc2301_ts_driver);
+
+MODULE_AUTHOR("Jarkko Oikarinen <jarkko.oikarinen@nokia.com>");
+MODULE_DESCRIPTION("TI TSC2301 touchscreen driver");
+MODULE_LICENSE("GPL");
