--- a/drivers/input/keyboard/tsc2301_kp.c
+++ b/drivers/input/keyboard/tsc2301_kp.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * TI TSC2301 keypad: a 4x4 matrix
+ *
+ * After Nokia's 2.6.21 tsc2301_kp.c,
+ * Copyright (C) 2005-2006 Nokia Corporation
+ * (Jarkko Oikarinen, Juha Yrjölä).
+ *
+ * KPDATA holds one bit per key, bit (row * 4 + column). The chip pulls
+ * KBIRQ low after a scan finds a key down; in interrupt mode 2 reading
+ * KPDATA releases it (Nokia: mode 0 could leave KBIRQ stuck). There is no
+ * release interrupt: keys still down keep interrupting, and with no
+ * interrupt for 50 ms all keys are released.
+ */
+
+#include <linux/input.h>
+#include <linux/input/matrix_keypad.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/tsc2301.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+
+#define TSC2301_KP_ROWS		4
+#define TSC2301_KP_COLS		4
+#define TSC2301_KP_ROW_SHIFT	2
+#define TSC2301_KP_KEYS		(TSC2301_KP_ROWS * TSC2301_KP_COLS)
+#define TSC2301_KP_RELEASE_MS	50
+
+struct tsc2301_kp {
+	struct tsc2301 *tsc;
+	struct input_dev *idev;
+	struct timer_list timer;
+	spinlock_t lock;		/* keys_pressed */
+	int irq;
+	u16 mask;			/* keys not in the keymap */
+	u16 keys_pressed;
+	unsigned short keymap[TSC2301_KP_KEYS];
+};
+
+static void tsc2301_kp_report(struct tsc2301_kp *kp, u16 prev, u16 state)
+{
+	u16 changed = prev ^ state;
+	int i;
+
+	if (!changed)
+		return;
+	for (i = 0; i < TSC2301_KP_KEYS; i++) {
+		if (!(changed & BIT(i)))
+			continue;
+		input_event(kp->idev, EV_MSC, MSC_SCAN, i);
+		input_report_key(kp->idev, kp->keymap[i], state & BIT(i));
+	}
+	input_sync(kp->idev);
+}
+
+/*
+ * Nokia: two keys down in each of two rows, in the same columns, make the
+ * matrix show the other corners of the rectangle too. Drop newly pressed
+ * keys in such a rectangle.
+ */
+static u16 tsc2301_kp_filter_ghosts(u16 prev, u16 state)
+{
+	static const u8 rect_pat[] = { 0x3, 0x5, 0x9, 0x6, 0xa, 0xc };
+	u16 out = state;
+	int r1, r2, i;
+
+	for (r1 = 0; r1 < TSC2301_KP_ROWS; r1++) {
+		u16 row1 = (state >> (r1 * 4)) & 0xf;
+
+		if (!row1)
+			continue;
+		for (r2 = r1 + 1; r2 < TSC2301_KP_ROWS; r2++) {
+			u16 rect = ((state >> (r2 * 4)) & 0xf) & row1;
+
+			if (!rect)
+				continue;
+			for (i = 0; i < ARRAY_SIZE(rect_pat); i++) {
+				u16 m;
+
+				if ((rect & rect_pat[i]) != rect_pat[i])
+					continue;
+				m = (rect_pat[i] << (r1 * 4)) |
+				    (rect_pat[i] << (r2 * 4));
+				out &= ~(m & ~prev);
+			}
+		}
+	}
+	return out;
+}
+
+static irqreturn_t tsc2301_kp_irq(int irq, void *data)
+{
+	struct tsc2301_kp *kp = data;
+	unsigned long flags;
+	unsigned int val;
+	u16 state;
+
+	mod_timer(&kp->timer, jiffies + msecs_to_jiffies(TSC2301_KP_RELEASE_MS));
+
+	if (regmap_read(kp->tsc->regmap, TSC2301_REG_KPDATA, &val))
+		return IRQ_HANDLED;
+
+	spin_lock_irqsave(&kp->lock, flags);
+	state = tsc2301_kp_filter_ghosts(kp->keys_pressed, val & ~kp->mask);
+	tsc2301_kp_report(kp, kp->keys_pressed, state);
+	kp->keys_pressed = state;
+	spin_unlock_irqrestore(&kp->lock, flags);
+
+	return IRQ_HANDLED;
+}
+
+static void tsc2301_kp_release(struct timer_list *t)
+{
+	struct tsc2301_kp *kp = timer_container_of(kp, t, timer);
+	unsigned long flags;
+
+	spin_lock_irqsave(&kp->lock, flags);
+	tsc2301_kp_report(kp, kp->keys_pressed, 0);
+	kp->keys_pressed = 0;
+	spin_unlock_irqrestore(&kp->lock, flags);
+}
+
+static int tsc2301_kp_open(struct input_dev *idev)
+{
+	struct tsc2301_kp *kp = input_get_drvdata(idev);
+	unsigned int val;
+	int ret;
+
+	ret = tsc2301_write_kbc(kp->tsc, 2);
+	if (!ret)
+		ret = tsc2301_kp_scan(kp->tsc, true, kp->mask);
+	if (ret)
+		return ret;
+	/* Nokia read KPDATA once before waiting for interrupts */
+	regmap_read(kp->tsc->regmap, TSC2301_REG_KPDATA, &val);
+	enable_irq(kp->irq);
+	return 0;
+}
+
+static void tsc2301_kp_close(struct input_dev *idev)
+{
+	struct tsc2301_kp *kp = input_get_drvdata(idev);
+
+	disable_irq(kp->irq);
+	tsc2301_kp_scan(kp->tsc, false, kp->mask);
+	timer_delete_sync(&kp->timer);
+	tsc2301_kp_release(&kp->timer);
+}
+
+static void tsc2301_kp_shutdown_timer(void *timer)
+{
+	timer_shutdown_sync(timer);
+}
+
+static int tsc2301_kp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct tsc2301_kp *kp;
+	struct input_dev *idev;
+	const char *label;
+	int i, ret;
+
+	device_set_of_node_from_dev(dev, dev->parent);
+
+	if (!device_property_present(dev, "linux,keymap"))
+		return -ENODEV;	/* no keypad wired */
+
+	kp = devm_kzalloc(dev, sizeof(*kp), GFP_KERNEL);
+	if (!kp)
+		return -ENOMEM;
+	kp->tsc = dev_get_drvdata(dev->parent);
+	spin_lock_init(&kp->lock);
+	timer_setup(&kp->timer, tsc2301_kp_release, 0);
+
+	kp->irq = fwnode_irq_get_byname(dev_fwnode(dev), "kbirq");
+	if (kp->irq < 0)
+		return dev_err_probe(dev, kp->irq, "no KBIRQ interrupt\n");
+
+	idev = devm_input_allocate_device(dev);
+	if (!idev)
+		return -ENOMEM;
+	kp->idev = idev;
+	if (device_property_read_string(dev, "label", &label))
+		label = "TSC2301 keypad";
+	idev->name = label;
+	idev->phys = "tsc2301/input1";
+	idev->id.bustype = BUS_SPI;
+	idev->open = tsc2301_kp_open;
+	idev->close = tsc2301_kp_close;
+	input_set_drvdata(idev, kp);
+
+	ret = matrix_keypad_build_keymap(NULL, NULL, TSC2301_KP_ROWS,
+					 TSC2301_KP_COLS, kp->keymap, idev);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid keymap\n");
+	for (i = 0; i < TSC2301_KP_KEYS; i++)
+		if (kp->keymap[i] == KEY_RESERVED)
+			kp->mask |= BIT(i);
+
+	input_set_capability(idev, EV_MSC, MSC_SCAN);
+	if (device_property_read_bool(dev, "autorepeat"))
+		__set_bit(EV_REP, idev->evbit);
+
+	ret = devm_request_threaded_irq(dev, kp->irq, NULL, tsc2301_kp_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"tsc2301-kp", kp);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, tsc2301_kp_shutdown_timer,
+				       &kp->timer);
+	if (ret)
+		return ret;
+
+	return input_register_device(idev);
+}
+
+static const struct platform_device_id tsc2301_kp_ids[] = {
+	{ "tsc2301-keypad" },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, tsc2301_kp_ids);
+
+static struct platform_driver tsc2301_kp_driver = {
+	.driver = {
+		.name = "tsc2301-keypad",
+	},
+	.id_table = tsc2301_kp_ids,
+	.probe = tsc2301_kp_probe,
+};
+module_platform_driver(tsc2301_kp_driver);
+
+MODULE_AUTHOR("Juha Yrjölä <juha.yrjola@nokia.com>");
+MODULE_DESCRIPTION("TI TSC2301 keypad driver");
+MODULE_LICENSE("GPL");
