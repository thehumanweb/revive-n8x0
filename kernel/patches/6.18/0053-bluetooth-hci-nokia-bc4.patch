+/*
+ * CSR BlueCore4, as Nokia's hci_h4p set it up on the N800/N810.
+ *
+ * bc4fw.bin is a list of complete H4+ packets, each after a length byte
+ * (a zero length ends the list): the negotiation request (baud divider
+ * and system clock for the board, sent as it is), an alive request, then
+ * BCCMD PS-key writes (HCI vendor command 0xfc00, channel 0xc2) and a
+ * BCCMD warm reset as the last packet. The chip answers each BCCMD with
+ * a vendor event (no Command Complete), its status in event bytes 11-12;
+ * the warm reset gets no answer, and the chip comes back at the rate in
+ * its PSKEY_UART_BAUDRATE, 3692300 baud, where an alive exchange
+ * confirms it. The packets are padded to even lengths already.
+ *
+ * PSKEY_BDADDR (key 0x0001) holds a placeholder address. Nokia's driver
+ * patched in the address its userspace had written to sysfs; here the
+ * address comes from set_bdaddr (mgmt's public-addr), which runs the
+ * whole setup again with it, so the controller starts unconfigured.
+ */
+#define BC4_REPLY_TIMEOUT_MS	1000
+#define BC4_ALIVE_TRIES		10
+#define BC4_VARID_PS		0x7003
+#define BC4_PSKEY_BDADDR	0x0001
+
+static int nokia_setup(struct hci_uart *hu);
+
+/* Queue one of bc4fw.bin's packets (its first byte is the H4 type) */
+static int nokia_bc4_send(struct hci_uart *hu, const u8 *pkt, u8 len)
+{
+	struct sk_buff *skb;
+	int err;
+
+	skb = bt_skb_alloc(len, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	hci_skb_pkt_type(skb) = pkt[0];
+	skb_put_data(skb, pkt + 1, len - 1);
+
+	err = nokia_enqueue(hu, skb);
+	if (err)
+		return err;	/* skb_pad() freed it */
+
+	hci_uart_tx_wakeup(hu);
+
+	return 0;
+}
+
+static bool nokia_bc4_is_bdaddr(const u8 *pkt, u8 len)
+{
+	/* 01 00fc plen | c2 type len seq varid status | key len stores | value */
+	return len >= 29 && pkt[0] == HCI_COMMAND_PKT &&
+	       get_unaligned_le16(pkt + 11) == BC4_VARID_PS &&
+	       get_unaligned_le16(pkt + 15) == BC4_PSKEY_BDADDR;
+}
+
+/* PSKEY_BDADDR, little-endian words: LAP[23:16], LAP[15:0], UAP, NAP */
+static void nokia_bc4_put_bdaddr(u8 *v, const bdaddr_t *bdaddr)
+{
+	v[0] = bdaddr->b[2];
+	v[1] = 0x00;
+	v[2] = bdaddr->b[0];
+	v[3] = bdaddr->b[1];
+	v[4] = bdaddr->b[3];
+	v[5] = 0x00;
+	v[6] = bdaddr->b[4];
+	v[7] = bdaddr->b[5];
+}
+
+/* Wait until everything queued has left the UART (the warm reset) */
+static void nokia_bc4_wait_sent(struct hci_uart *hu)
+{
+	struct nokia_bt_dev *btdev = hu->priv;
+	int i;
+
+	for (i = 0; i < 100; i++) {
+		if (skb_queue_empty(&btdev->txq) && !hu->tx_skb &&
+		    !test_bit(HCI_UART_SENDING, &hu->tx_state))
+			break;
+		msleep(10);
+	}
+
+	serdev_device_wait_until_sent(btdev->serdev, msecs_to_jiffies(100));
+}
+
+static int nokia_bc4_negotiate(struct hci_uart *hu, const u8 *pkt, u8 len)
+{
+	struct nokia_bt_dev *btdev = hu->priv;
+	struct serdev_device *serdev = btdev->serdev;
+	struct device *dev = &serdev->dev;
+	int err;
+
+	btdev->init_error = 0;
+	init_completion(&btdev->init_completion);
+
+	err = nokia_bc4_send(hu, pkt, len);
+	if (err)
+		return err;
+
+	if (!wait_for_completion_timeout(&btdev->init_completion,
+					 msecs_to_jiffies(BC4_REPLY_TIMEOUT_MS))) {
+		dev_err(dev, "No negotiation reply");
+		return -ETIMEDOUT;
+	}
+
+	if (btdev->init_error < 0)
+		return btdev->init_error;
+
+	/*
+	 * Off to 921600 baud. The chip drops CTS while it changes its
+	 * rate (Nokia's driver waited for that), then raises it again.
+	 */
+	nokia_flow_control(serdev, false);
+	serdev_device_wait_for_cts(serdev, false, 100);
+	serdev_device_set_baudrate(serdev, SETUP_BAUD_RATE);
+	err = serdev_device_wait_for_cts(serdev, true, 200);
+	if (err < 0) {
+		dev_err(dev, "CTS not received: %d", err);
+		return err;
+	}
+	nokia_flow_control(serdev, true);
+
+	btdev->init_error = 0;
+	err = nokia_send_alive_packet(hu);
+	if (err < 0)
+		dev_err(dev, "Alive check failed: %d", err);
+
+	return err;
+}
+
+static int nokia_bc4_setup(struct hci_uart *hu)
+{
+	struct nokia_bt_dev *btdev = hu->priv;
+	struct serdev_device *serdev = btdev->serdev;
+	struct device *dev = &serdev->dev;
+	bool have_bdaddr = bacmp(&btdev->bdaddr, BDADDR_ANY);
+	const struct firmware *fw;
+	const u8 *p, *end, *last = NULL;
+	int err, n = 0, i;
+
+	err = request_firmware(&fw, FIRMWARE_BC4, dev);
+	if (err < 0) {
+		dev_err(dev, "%s: Failed to load Nokia firmware file (%d)",
+			hu->hdev->name, err);
+		return err;
+	}
+
+	/* Check the packet list; the last command is the warm reset */
+	end = fw->data + fw->size;
+	for (p = fw->data; p < end && *p; p += 1 + *p) {
+		if (p + 1 + *p > end || *p < 2)
+			break;
+		if (p[1] == HCI_COMMAND_PKT)
+			last = p;
+	}
+	if ((p < end && *p) || !last || fw->data[1] != HCI_NOKIA_NEG_PKT) {
+		dev_err(dev, "%s: corrupted firmware file", FIRMWARE_BC4);
+		err = -EINVAL;
+		goto out;
+	}
+
+	err = nokia_bc4_negotiate(hu, fw->data + 1, fw->data[0]);
+	if (err < 0)
+		goto out;
+
+	WRITE_ONCE(btdev->bc4_fw_loading, true);
+
+	for (p = fw->data; p < end && *p; p += 1 + *p) {
+		const u8 *pkt = p + 1;
+		u8 *patched = NULL;
+
+		/* The negotiation and alive packets are done */
+		if (pkt[0] != HCI_COMMAND_PKT)
+			continue;
+		n++;
+
+		if (have_bdaddr && nokia_bc4_is_bdaddr(pkt, *p)) {
+			patched = kmemdup(pkt, *p, GFP_KERNEL);
+			if (!patched) {
+				err = -ENOMEM;
+				goto out;
+			}
+			nokia_bc4_put_bdaddr(patched + 21, &btdev->bdaddr);
+			pkt = patched;
+		}
+
+		btdev->bc4_fw_status = 0;
+		init_completion(&btdev->init_completion);
+		err = nokia_bc4_send(hu, pkt, *p);
+		kfree(patched);
+		if (err)
+			goto out;
+
+		if (p == last)
+			break;
+
+		if (!wait_for_completion_timeout(&btdev->init_completion,
+				msecs_to_jiffies(BC4_REPLY_TIMEOUT_MS))) {
+			dev_err(dev, "No reply to firmware command %d", n);
+			err = -ETIMEDOUT;
+			goto out;
+		}
+		if (btdev->bc4_fw_status) {
+			dev_err(dev, "Firmware command %d failed: status %d",
+				n, btdev->bc4_fw_status);
+			err = -EPROTO;
+			goto out;
+		}
+	}
+
+	WRITE_ONCE(btdev->bc4_fw_loading, false);
+
+	/* The warm reset: the chip restarts at its final rate */
+	nokia_bc4_wait_sent(hu);
+	serdev_device_set_baudrate(serdev, MAX_BAUD_RATE);
+	err = serdev_device_wait_for_cts(serdev, true, 500);
+	if (err < 0) {
+		dev_err(dev, "CTS not received after warm reset: %d", err);
+		goto out;
+	}
+
+	for (i = 0; i < BC4_ALIVE_TRIES; i++) {
+		btdev->init_error = 0;
+		err = nokia_send_alive_packet(hu);
+		if (!err)
+			break;
+	}
+	if (err < 0) {
+		dev_err(dev, "No alive reply after warm reset: %d", err);
+		goto out;
+	}
+
+	dev_info(dev, "BC4 set up: %s, %d commands, %s address",
+		 FIRMWARE_BC4, n, have_bdaddr ? "with its" : "no");
+
+out:
+	WRITE_ONCE(btdev->bc4_fw_loading, false);
+	release_firmware(fw);
+	return err;
+}
+
+static int nokia_bc4_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
+{
+	struct hci_uart *hu = hci_get_drvdata(hdev);
+	struct nokia_bt_dev *btdev = hu->priv;
+
+	bacpy(&btdev->bdaddr, bdaddr);
+
+	return nokia_setup(hu);
+}
