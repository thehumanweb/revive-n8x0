+/*
+ * Bluetooth: a CSR BlueCore4 on UART1 speaking Nokia's H4+, as NOLO's
+ * OMAP_TAG_NOKIA_BT describes it (chip_type 1, bt_uart 1, GPIOs 61, 98
+ * and 92). hci_nokia loads bc4fw.bin (Nokia's initfs has it).
+ */
+&uart1 {
+	bluetooth {
+		compatible = "csr,bc4-nokia", "nokia,h4p-bluetooth";
+		reset-gpios = <&gpio3 28 GPIO_ACTIVE_LOW>;		/* gpio92 */
+		host-wakeup-gpios = <&gpio4 2 GPIO_ACTIVE_HIGH>;	/* gpio98 */
+		bluetooth-wakeup-gpios = <&gpio2 29 GPIO_ACTIVE_HIGH>;	/* gpio61 */
+		clocks = <&bt_sysclk>;
+		clock-names = "sysclk";
+	};
+};
