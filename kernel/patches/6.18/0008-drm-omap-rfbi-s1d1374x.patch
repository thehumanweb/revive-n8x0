diff -uN a/drivers/gpu/drm/omapdrm/dss/rfbi.c b/drivers/gpu/drm/omapdrm/dss/rfbi.c
--- a/drivers/gpu/drm/omapdrm/dss/rfbi.c
+++ b/drivers/gpu/drm/omapdrm/dss/rfbi.c
@@ -0,0 +1,515 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OMAP2 RFBI (Remote Frame Buffer Interface) output.
+ *
+ * RFBI is a parallel bus to a display controller with its own frame memory,
+ * such as the Epson S1D13745 on the Nokia N800/N810. Updates are manual:
+ * for each frame the controller on the bus is first told where the pixels
+ * go (the client's prepare_update), then DISPC streams the frame through
+ * RFBI in stall mode and signals FRAMEDONE.
+ *
+ * Register handling after the RFBI drivers in Nokia's omapfb (Imre Deak,
+ * Juha Yrjölä) and the omapdss rfbi.c removed in 2017 (Tomi Valkeinen);
+ * the output, bridge and update plumbing follows omapdrm's DSI command mode.
+ */
+
+#define DSS_SUBSYS_NAME "RFBI"
+
+#include <linux/component.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/semaphore.h>
+#include <linux/workqueue.h>
+
+#include <drm/drm_bridge.h>
+#include <video/videomode.h>
+
+#include "omapdss.h"
+#include "dss.h"
+
+#define RFBI_REVISION		0x0000
+#define RFBI_SYSCONFIG		0x0010
+#define RFBI_SYSSTATUS		0x0014
+#define RFBI_CONTROL		0x0040
+#define RFBI_PIXEL_CNT		0x0044
+#define RFBI_LINE_NUMBER	0x0048
+#define RFBI_CMD		0x004c
+#define RFBI_PARAM		0x0050
+#define RFBI_DATA		0x0054
+#define RFBI_READ		0x0058
+#define RFBI_STATUS		0x005c
+#define RFBI_CONFIG0		0x0060
+#define RFBI_DATA_CYCLE1_0	0x006c
+
+#define RFBI_CONTROL_ENABLE	BIT(0)
+#define RFBI_CONTROL_CS0	BIT(2)
+#define RFBI_CONTROL_ITE	BIT(4)	/* internal trigger, cleared by HW */
+
+#define RFBI_CONFIG0_PARALLEL_MASK	(3 << 0)
+#define RFBI_CONFIG0_PARALLEL_8		(0 << 0)
+#define RFBI_CONFIG0_PARALLEL_16	(3 << 0)
+#define RFBI_CONFIG0_CLKDIV2		BIT(4)	/* timing, set by bootloader */
+
+struct rfbi_device {
+	struct platform_device *pdev;
+	void __iomem *base;
+	struct dss_device *dss;
+
+	/* held over a client's bus access and over a whole update */
+	struct semaphore bus_sem;
+	struct delayed_work framedone_timeout_work;
+
+	struct videomode vm;
+	struct dss_lcd_mgr_config mgr_config;
+	bool enabled;
+
+	const struct rfbi_client_ops *client_ops;
+	void *client_data;
+
+	struct omap_dss_device output;
+	struct drm_bridge bridge;
+};
+
+#define drm_bridge_to_rfbi(b) container_of(b, struct rfbi_device, bridge)
+
+static inline void rfbi_write_reg(struct rfbi_device *rfbi, u16 idx, u32 val)
+{
+	__raw_writel(val, rfbi->base + idx);
+}
+
+static inline u32 rfbi_read_reg(struct rfbi_device *rfbi, u16 idx)
+{
+	return __raw_readl(rfbi->base + idx);
+}
+
+static int rfbi_runtime_get(struct rfbi_device *rfbi)
+{
+	return pm_runtime_resume_and_get(&rfbi->pdev->dev);
+}
+
+static void rfbi_runtime_put(struct rfbi_device *rfbi)
+{
+	pm_runtime_put(&rfbi->pdev->dev);
+}
+
+static void rfbi_set_bits_per_cycle(struct rfbi_device *rfbi, int bpc)
+{
+	u32 l = rfbi_read_reg(rfbi, RFBI_CONFIG0);
+
+	l &= ~RFBI_CONFIG0_PARALLEL_MASK;
+	l |= bpc == 16 ? RFBI_CONFIG0_PARALLEL_16 : RFBI_CONFIG0_PARALLEL_8;
+	rfbi_write_reg(rfbi, RFBI_CONFIG0, l);
+}
+
+/* -----------------------------------------------------------------------------
+ * Bus access for the display controller on the other side
+ */
+
+struct rfbi_device *rfbi_get(struct device_node *node)
+{
+	struct platform_device *pdev = of_find_device_by_node(node);
+	struct rfbi_device *rfbi = pdev ? platform_get_drvdata(pdev) : NULL;
+
+	if (pdev)
+		put_device(&pdev->dev);
+
+	return rfbi ?: ERR_PTR(-EPROBE_DEFER);
+}
+
+void rfbi_set_client(struct rfbi_device *rfbi,
+		     const struct rfbi_client_ops *ops, void *data)
+{
+	down(&rfbi->bus_sem);
+	rfbi->client_ops = ops;
+	rfbi->client_data = data;
+	up(&rfbi->bus_sem);
+}
+
+/* Take the bus for register access outside an update (8 bits per cycle) */
+int rfbi_bus_get(struct rfbi_device *rfbi)
+{
+	int r;
+
+	down(&rfbi->bus_sem);
+	r = rfbi_runtime_get(rfbi);
+	if (r) {
+		up(&rfbi->bus_sem);
+		return r;
+	}
+	rfbi_set_bits_per_cycle(rfbi, 8);
+
+	return 0;
+}
+
+void rfbi_bus_put(struct rfbi_device *rfbi)
+{
+	rfbi_runtime_put(rfbi);
+	up(&rfbi->bus_sem);
+}
+
+/* With the bus held: from rfbi_bus_get() or within prepare_update() */
+void rfbi_write_command(struct rfbi_device *rfbi, const u8 *buf, size_t len)
+{
+	while (len--)
+		rfbi_write_reg(rfbi, RFBI_CMD, *buf++);
+}
+
+void rfbi_write_data(struct rfbi_device *rfbi, const u8 *buf, size_t len)
+{
+	while (len--)
+		rfbi_write_reg(rfbi, RFBI_PARAM, *buf++);
+}
+
+void rfbi_read_data(struct rfbi_device *rfbi, u8 *buf, size_t len)
+{
+	while (len--) {
+		rfbi_write_reg(rfbi, RFBI_READ, 0);
+		*buf++ = rfbi_read_reg(rfbi, RFBI_READ);
+	}
+}
+
+/* -----------------------------------------------------------------------------
+ * Manual update
+ */
+
+static void rfbi_update_done(struct rfbi_device *rfbi)
+{
+	u32 l = rfbi_read_reg(rfbi, RFBI_CONTROL);
+
+	rfbi_write_reg(rfbi, RFBI_CONTROL, l & ~RFBI_CONTROL_ENABLE);
+	rfbi_set_bits_per_cycle(rfbi, 8);
+	dispc_enable_sidle(rfbi->dss->dispc);
+	rfbi_runtime_put(rfbi);
+	up(&rfbi->bus_sem);
+}
+
+static void rfbi_framedone_irq_callback(void *data)
+{
+	struct rfbi_device *rfbi = data;
+
+	if (cancel_delayed_work(&rfbi->framedone_timeout_work))
+		rfbi_update_done(rfbi);
+}
+
+static void rfbi_framedone_timeout_work_callback(struct work_struct *work)
+{
+	struct rfbi_device *rfbi = container_of(work, struct rfbi_device,
+						framedone_timeout_work.work);
+
+	DSSERR("FRAMEDONE not received for 250ms\n");
+	rfbi_update_done(rfbi);
+}
+
+static int rfbi_update(struct omap_dss_device *dssdev)
+{
+	struct rfbi_device *rfbi = container_of(dssdev, struct rfbi_device,
+						output);
+	u16 w = rfbi->vm.hactive;
+	u16 h = rfbi->vm.vactive;
+	int r;
+
+	down(&rfbi->bus_sem);
+
+	if (!rfbi->enabled || !w || !h) {
+		r = -EIO;
+		goto err_up;
+	}
+
+	r = rfbi_runtime_get(rfbi);
+	if (r)
+		goto err_up;
+
+	/* Tell the controller where the pixels go */
+	rfbi_set_bits_per_cycle(rfbi, 8);
+	if (rfbi->client_ops && rfbi->client_ops->prepare_update) {
+		r = rfbi->client_ops->prepare_update(rfbi->client_data, w, h);
+		if (r)
+			goto err_put;
+	}
+
+	/*
+	 * DISPC interrupts can't wake the CPU: no smart idle while the frame
+	 * is in flight (as for DSI command mode).
+	 */
+	dispc_disable_sidle(rfbi->dss->dispc);
+
+	rfbi_set_bits_per_cycle(rfbi, 16);
+	rfbi_write_reg(rfbi, RFBI_PIXEL_CNT, w * h);
+
+	schedule_delayed_work(&rfbi->framedone_timeout_work,
+			      msecs_to_jiffies(250));
+
+	/* Arm RFBI, then let DISPC send the frame (stall mode, one shot) */
+	rfbi_write_reg(rfbi, RFBI_CONTROL, rfbi_read_reg(rfbi, RFBI_CONTROL) |
+		       RFBI_CONTROL_ENABLE | RFBI_CONTROL_ITE);
+	dss_mgr_start_update(&rfbi->output);
+
+	return 0;
+
+err_put:
+	rfbi_set_bits_per_cycle(rfbi, 8);
+	rfbi_runtime_put(rfbi);
+err_up:
+	up(&rfbi->bus_sem);
+	return r;
+}
+
+static bool rfbi_is_video_mode(struct omap_dss_device *dssdev)
+{
+	return false;
+}
+
+static const struct omapdss_dsi_ops rfbi_manual_update_ops = {
+	.update = rfbi_update,
+	.is_video_mode = rfbi_is_video_mode,
+};
+
+/* -----------------------------------------------------------------------------
+ * DRM bridge
+ */
+
+static int rfbi_bridge_attach(struct drm_bridge *bridge,
+			      struct drm_encoder *encoder,
+			      enum drm_bridge_attach_flags flags)
+{
+	struct rfbi_device *rfbi = drm_bridge_to_rfbi(bridge);
+
+	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR))
+		return -EINVAL;
+
+	return drm_bridge_attach(encoder, rfbi->output.next_bridge,
+				 bridge, flags);
+}
+
+static void rfbi_bridge_mode_set(struct drm_bridge *bridge,
+				 const struct drm_display_mode *mode,
+				 const struct drm_display_mode *adjusted_mode)
+{
+	struct rfbi_device *rfbi = drm_bridge_to_rfbi(bridge);
+
+	drm_display_mode_to_videomode(adjusted_mode, &rfbi->vm);
+}
+
+static void rfbi_bridge_enable(struct drm_bridge *bridge)
+{
+	struct rfbi_device *rfbi = drm_bridge_to_rfbi(bridge);
+	int r;
+
+	r = dispc_runtime_get(rfbi->dss->dispc);
+	if (r)
+		return;
+
+	r = dss_mgr_register_framedone_handler(&rfbi->output,
+			rfbi_framedone_irq_callback, rfbi);
+	if (r) {
+		DSSERR("can't register FRAMEDONE handler\n");
+		goto err_put;
+	}
+
+	rfbi->mgr_config.io_pad_mode = DSS_IO_PAD_MODE_RFBI;
+	rfbi->mgr_config.stallmode = true;
+	rfbi->mgr_config.fifohandcheck = false;
+	rfbi->mgr_config.video_port_width = 16;
+	rfbi->mgr_config.lcden_sig_polarity = 0;
+	rfbi->mgr_config.clock_info.lck_div = 1;
+	rfbi->mgr_config.clock_info.pck_div = 2;
+	dss_mgr_set_lcd_config(&rfbi->output, &rfbi->mgr_config);
+	dss_mgr_set_timings(&rfbi->output, &rfbi->vm);
+
+	r = dss_mgr_enable(&rfbi->output);
+	if (r)
+		goto err_unregister;
+
+	down(&rfbi->bus_sem);
+	rfbi->enabled = true;
+	up(&rfbi->bus_sem);
+
+	return;
+
+err_unregister:
+	dss_mgr_unregister_framedone_handler(&rfbi->output,
+			rfbi_framedone_irq_callback, rfbi);
+err_put:
+	dispc_runtime_put(rfbi->dss->dispc);
+}
+
+static void rfbi_bridge_disable(struct drm_bridge *bridge)
+{
+	struct rfbi_device *rfbi = drm_bridge_to_rfbi(bridge);
+
+	/* Waits for an update in flight */
+	down(&rfbi->bus_sem);
+	rfbi->enabled = false;
+	up(&rfbi->bus_sem);
+
+	dss_mgr_disable(&rfbi->output);
+	dss_mgr_unregister_framedone_handler(&rfbi->output,
+			rfbi_framedone_irq_callback, rfbi);
+	dispc_runtime_put(rfbi->dss->dispc);
+}
+
+static const struct drm_bridge_funcs rfbi_bridge_funcs = {
+	.attach = rfbi_bridge_attach,
+	.mode_set = rfbi_bridge_mode_set,
+	.enable = rfbi_bridge_enable,
+	.disable = rfbi_bridge_disable,
+};
+
+/* -----------------------------------------------------------------------------
+ * Component, output and platform driver
+ */
+
+static void rfbi_hw_init(struct rfbi_device *rfbi)
+{
+	u32 l;
+
+	/*
+	 * No soft reset: the bootloader set the bus timings for the
+	 * controller (ONOFF/CYCLE_TIME0, CONFIG0 clock divider).
+	 */
+	l = rfbi_read_reg(rfbi, RFBI_SYSCONFIG);
+	l |= (1 << 0) | (2 << 3);		/* autoidle, smart idle */
+	rfbi_write_reg(rfbi, RFBI_SYSCONFIG, l);
+
+	/* 8/16-bit parallel, ITE trigger, 16-bit RGB565 pixel data */
+	l = rfbi_read_reg(rfbi, RFBI_CONFIG0) & RFBI_CONFIG0_CLKDIV2;
+	l |= RFBI_CONFIG0_PARALLEL_8 | (0x00 << 2) | (0x01 << 5) |
+	     (0x02 << 7) | (1 << 20) | (1 << 21);
+	rfbi_write_reg(rfbi, RFBI_CONFIG0, l);
+	rfbi_write_reg(rfbi, RFBI_DATA_CYCLE1_0, 0x00000010);
+
+	/* CS0, not bypass */
+	rfbi_write_reg(rfbi, RFBI_CONTROL, RFBI_CONTROL_CS0);
+}
+
+static int rfbi_bind(struct device *dev, struct device *master, void *data)
+{
+	struct rfbi_device *rfbi = dev_get_drvdata(dev);
+	u32 rev;
+	int r;
+
+	rfbi->dss = dss_get_device(master);
+
+	r = rfbi_runtime_get(rfbi);
+	if (r)
+		return r;
+
+	rfbi_hw_init(rfbi);
+	rev = rfbi_read_reg(rfbi, RFBI_REVISION);
+	dev_info(dev, "OMAP RFBI rev %d.%d\n", (rev >> 4) & 0xf, rev & 0xf);
+
+	rfbi_runtime_put(rfbi);
+
+	return 0;
+}
+
+static void rfbi_unbind(struct device *dev, struct device *master, void *data)
+{
+}
+
+static const struct component_ops rfbi_component_ops = {
+	.bind	= rfbi_bind,
+	.unbind	= rfbi_unbind,
+};
+
+static int rfbi_init_output(struct rfbi_device *rfbi)
+{
+	struct omap_dss_device *out = &rfbi->output;
+	int r;
+
+	rfbi->bridge.of_node = rfbi->pdev->dev.of_node;
+	drm_bridge_add(&rfbi->bridge);
+
+	out->dev = &rfbi->pdev->dev;
+	out->id = OMAP_DSS_OUTPUT_DBI;
+	out->type = OMAP_DISPLAY_TYPE_DBI;
+	out->name = "rfbi.0";
+	out->dispc_channel = OMAP_DSS_CHANNEL_LCD;
+	out->of_port = 0;
+	out->dsi_ops = &rfbi_manual_update_ops;
+
+	r = omapdss_device_init_output(out, &rfbi->bridge);
+	if (r < 0) {
+		drm_bridge_remove(&rfbi->bridge);
+		return r;
+	}
+
+	omapdss_device_register(out);
+
+	return 0;
+}
+
+static void rfbi_uninit_output(struct rfbi_device *rfbi)
+{
+	omapdss_device_unregister(&rfbi->output);
+	omapdss_device_cleanup_output(&rfbi->output);
+	drm_bridge_remove(&rfbi->bridge);
+}
+
+static int rfbi_probe(struct platform_device *pdev)
+{
+	struct rfbi_device *rfbi;
+	int r;
+
+	rfbi = devm_drm_bridge_alloc(&pdev->dev, struct rfbi_device, bridge,
+				     &rfbi_bridge_funcs);
+	if (IS_ERR(rfbi))
+		return PTR_ERR(rfbi);
+
+	rfbi->pdev = pdev;
+	sema_init(&rfbi->bus_sem, 1);
+	INIT_DEFERRABLE_WORK(&rfbi->framedone_timeout_work,
+			     rfbi_framedone_timeout_work_callback);
+	platform_set_drvdata(pdev, rfbi);
+
+	rfbi->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(rfbi->base))
+		return PTR_ERR(rfbi->base);
+
+	pm_runtime_enable(&pdev->dev);
+
+	r = rfbi_init_output(rfbi);
+	if (r)
+		goto err_pm_disable;
+
+	r = component_add(&pdev->dev, &rfbi_component_ops);
+	if (r)
+		goto err_uninit_output;
+
+	return 0;
+
+err_uninit_output:
+	rfbi_uninit_output(rfbi);
+err_pm_disable:
+	pm_runtime_disable(&pdev->dev);
+	return r;
+}
+
+static void rfbi_remove(struct platform_device *pdev)
+{
+	struct rfbi_device *rfbi = platform_get_drvdata(pdev);
+
+	component_del(&pdev->dev, &rfbi_component_ops);
+	rfbi_uninit_output(rfbi);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static const struct of_device_id rfbi_of_match[] = {
+	{ .compatible = "ti,omap2-rfbi", },
+	{},
+};
+
+struct platform_driver omap_rfbihw_driver = {
+	.probe		= rfbi_probe,
+	.remove		= rfbi_remove,
+	.driver		= {
+		.name	= "omapdss_rfbi",
+		.of_match_table = rfbi_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
diff -uN a/drivers/gpu/drm/omapdrm/dss/s1d1374x.c b/drivers/gpu/drm/omapdrm/dss/s1d1374x.c
--- a/drivers/gpu/drm/omapdrm/dss/s1d1374x.c
+++ b/drivers/gpu/drm/omapdrm/dss/s1d1374x.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Epson S1D13744/S1D13745 ("Blizzard") display controller on OMAP RFBI.
+ *
+ * The controller has its own frame memory and drives the LCD panel; the
+ * host sends it pixel rectangles. Before each RFBI update, set its input
+ * and output window and point the register index at the memory data port,
+ * so the 16-bit pixels DISPC sends next land in the right place.
+ *
+ * The bootloader (NOLO on the N800/N810) sets up the controller's PLL,
+ * SDRAM and panel timings, and the panel itself; they are kept as found.
+ *
+ * Register use after Nokia's omapfb blizzard.c (Imre Deak, Juha Yrjölä).
+ */
+
+#define DSS_SUBSYS_NAME "S1D1374X"
+
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/platform_device.h>
+
+#include <drm/drm_bridge.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_modes.h>
+
+#include "omapdss.h"
+#include "dss.h"
+
+#define BLIZZARD_REV_CODE		0x00
+#define BLIZZARD_CONFIG			0x02
+#define BLIZZARD_INPUT_WIN_X_START_0	0x6c
+#define BLIZZARD_NDISP_CTRL_STATUS	0xe8
+
+#define BLIZZARD_COLOR_RGB565		0x01
+
+#define BLIZZARD_SRC_WRITE_LCD		0x00	/* S1D13744 */
+#define BLIZZARD_SRC_WRITE_LCD_DESTRUCTIVE 0x01	/* S1D13745 */
+
+struct s1d1374x {
+	struct drm_bridge bridge;
+	struct device *dev;
+	struct device_node *rfbi_node;
+	struct rfbi_device *rfbi;
+	u8 data_source;
+	bool identified;
+};
+
+#define drm_bridge_to_s1d1374x(b) container_of(b, struct s1d1374x, bridge)
+
+/* With the RFBI bus held, 8 bits per cycle */
+static u8 s1d1374x_read_reg(struct s1d1374x *ctrl, u8 reg)
+{
+	u8 val;
+
+	rfbi_write_command(ctrl->rfbi, &reg, 1);
+	rfbi_read_data(ctrl->rfbi, &val, 1);
+
+	return val;
+}
+
+static void s1d1374x_identify(struct s1d1374x *ctrl)
+{
+	u8 rev = s1d1374x_read_reg(ctrl, BLIZZARD_REV_CODE);
+	u8 conf = s1d1374x_read_reg(ctrl, BLIZZARD_CONFIG);
+
+	switch (rev & 0xfc) {
+	case 0x9c:
+		ctrl->data_source = BLIZZARD_SRC_WRITE_LCD;
+		dev_info(ctrl->dev, "S1D13744 rev %d (CNF pins %x)\n",
+			 rev & 0x03, conf & 0x07);
+		break;
+	case 0xa4:
+		ctrl->data_source = BLIZZARD_SRC_WRITE_LCD_DESTRUCTIVE;
+		dev_info(ctrl->dev, "S1D13745 rev %d (CNF pins %x)\n",
+			 rev & 0x03, conf & 0x07);
+		break;
+	default:
+		ctrl->data_source = BLIZZARD_SRC_WRITE_LCD_DESTRUCTIVE;
+		dev_warn(ctrl->dev, "unknown revision %#04x, assuming S1D13745\n",
+			 rev);
+	}
+	ctrl->identified = true;
+}
+
+/* Wait until the last window has been written to the controller's SDRAM */
+static void s1d1374x_wait_line_buffer(struct s1d1374x *ctrl)
+{
+	unsigned long tmo = jiffies + msecs_to_jiffies(30);
+
+	while (s1d1374x_read_reg(ctrl, BLIZZARD_NDISP_CTRL_STATUS) & BIT(7)) {
+		if (time_after(jiffies, tmo)) {
+			dev_err_ratelimited(ctrl->dev, "line buffer not ready\n");
+			break;
+		}
+	}
+}
+
+static int s1d1374x_prepare_update(void *data, u16 w, u16 h)
+{
+	struct s1d1374x *ctrl = data;
+	u8 cmd = BLIZZARD_INPUT_WIN_X_START_0;
+	u8 regs[18];
+	u16 x_end = w - 1, y_end = h - 1;
+
+	if (!ctrl->identified)
+		s1d1374x_identify(ctrl);
+
+	s1d1374x_wait_line_buffer(ctrl);
+
+	/* Input window, then output window (same, no scaling): 0x6c - 0x8a */
+	regs[0] = 0;		regs[1] = 0;		/* X start */
+	regs[2] = 0;		regs[3] = 0;		/* Y start */
+	regs[4] = x_end;	regs[5] = x_end >> 8;	/* X end */
+	regs[6] = y_end;	regs[7] = y_end >> 8;	/* Y end */
+	memcpy(&regs[8], &regs[0], 8);
+	regs[16] = BLIZZARD_COLOR_RGB565;		/* 0x8c input format */
+	regs[17] = ctrl->data_source;			/* 0x8e data source */
+
+	/* Leaves the register index at 0x90, the display memory data port */
+	rfbi_write_command(ctrl->rfbi, &cmd, 1);
+	rfbi_write_data(ctrl->rfbi, regs, sizeof(regs));
+
+	return 0;
+}
+
+static const struct rfbi_client_ops s1d1374x_rfbi_ops = {
+	.prepare_update = s1d1374x_prepare_update,
+};
+
+static int s1d1374x_bridge_attach(struct drm_bridge *bridge,
+				  struct drm_encoder *encoder,
+				  enum drm_bridge_attach_flags flags)
+{
+	struct s1d1374x *ctrl = drm_bridge_to_s1d1374x(bridge);
+	struct rfbi_device *rfbi;
+
+	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR))
+		return -EINVAL;
+
+	rfbi = rfbi_get(ctrl->rfbi_node);
+	if (IS_ERR(rfbi))
+		return PTR_ERR(rfbi);
+
+	ctrl->rfbi = rfbi;
+	rfbi_set_client(rfbi, &s1d1374x_rfbi_ops, ctrl);
+
+	return 0;
+}
+
+static void s1d1374x_bridge_detach(struct drm_bridge *bridge)
+{
+	struct s1d1374x *ctrl = drm_bridge_to_s1d1374x(bridge);
+
+	if (ctrl->rfbi)
+		rfbi_set_client(ctrl->rfbi, NULL, NULL);
+	ctrl->rfbi = NULL;
+}
+
+/*
+ * The N800/N810 panel (Sharp LS041Y3): 800x480 at about 51 Hz, as the
+ * bootloader programs the controller. The pixel clock only paces DISPC;
+ * the panel runs off the controller's own timing.
+ */
+static const struct drm_display_mode s1d1374x_n8x0_mode = {
+	.clock = 21940,
+	.hdisplay = 800,
+	.hsync_start = 800 + 28,
+	.hsync_end = 800 + 28 + 4,
+	.htotal = 800 + 28 + 4 + 49,
+	.vdisplay = 480,
+	.vsync_start = 480 + 3,
+	.vsync_end = 480 + 3 + 2,
+	.vtotal = 480 + 3 + 2 + 3,
+	.width_mm = 89,
+	.height_mm = 53,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int s1d1374x_bridge_get_modes(struct drm_bridge *bridge,
+				     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &s1d1374x_n8x0_mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+
+	return 1;
+}
+
+static const struct drm_bridge_funcs s1d1374x_bridge_funcs = {
+	.attach = s1d1374x_bridge_attach,
+	.detach = s1d1374x_bridge_detach,
+	.get_modes = s1d1374x_bridge_get_modes,
+};
+
+static int s1d1374x_probe(struct platform_device *pdev)
+{
+	struct s1d1374x *ctrl;
+
+	ctrl = devm_drm_bridge_alloc(&pdev->dev, struct s1d1374x, bridge,
+				     &s1d1374x_bridge_funcs);
+	if (IS_ERR(ctrl))
+		return PTR_ERR(ctrl);
+
+	ctrl->dev = &pdev->dev;
+	ctrl->rfbi_node = of_graph_get_remote_node(pdev->dev.of_node, 0, 0);
+	if (!ctrl->rfbi_node) {
+		dev_err(&pdev->dev, "no RFBI port connection\n");
+		return -ENODEV;
+	}
+
+	ctrl->bridge.of_node = pdev->dev.of_node;
+	ctrl->bridge.ops = DRM_BRIDGE_OP_MODES;
+	ctrl->bridge.type = DRM_MODE_CONNECTOR_DPI;
+	platform_set_drvdata(pdev, ctrl);
+
+	return devm_drm_bridge_add(&pdev->dev, &ctrl->bridge);
+}
+
+static void s1d1374x_remove(struct platform_device *pdev)
+{
+	struct s1d1374x *ctrl = platform_get_drvdata(pdev);
+
+	of_node_put(ctrl->rfbi_node);
+}
+
+static const struct of_device_id s1d1374x_of_match[] = {
+	{ .compatible = "epson,s1d13744", },
+	{ .compatible = "epson,s1d13745", },
+	{},
+};
+
+struct platform_driver omapdss_s1d1374x_driver = {
+	.probe		= s1d1374x_probe,
+	.remove		= s1d1374x_remove,
+	.driver		= {
+		.name	= "omapdss_s1d1374x",
+		.of_match_table = s1d1374x_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
