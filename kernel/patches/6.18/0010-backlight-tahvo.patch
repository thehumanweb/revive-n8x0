 obj-$(CONFIG_BACKLIGHT_ARCXCNN) 	+= arcxcnn_bl.o
--- a/drivers/video/backlight/tahvo_bl.c
+++ b/drivers/video/backlight/tahvo_bl.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LCD backlight PWM of the Nokia Tahvo ASIC (N800/N810).
+ *
+ * Tahvo's LEDPWM register sets the backlight duty cycle: 7 bits on Tahvo
+ * 3.x from revision 0x50 and on Betty (0x0b), 4 bits on older Tahvo.
+ * Revision check and register use after Nokia's board-n8x0-lcd.c.
+ */
+
+#include <linux/backlight.h>
+#include <linux/mfd/retu.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define TAHVO_REG_ASICR		0x00
+#define TAHVO_REG_LEDPWMR	0x05
+
+struct tahvo_bl {
+	struct retu_dev *rdev;
+	unsigned int max;
+};
+
+static int tahvo_bl_update_status(struct backlight_device *bd)
+{
+	struct tahvo_bl *bl = bl_get_data(bd);
+
+	return retu_write(bl->rdev, TAHVO_REG_LEDPWMR,
+			  backlight_get_brightness(bd));
+}
+
+static int tahvo_bl_get_brightness(struct backlight_device *bd)
+{
+	struct tahvo_bl *bl = bl_get_data(bd);
+	int val = retu_read(bl->rdev, TAHVO_REG_LEDPWMR);
+
+	return val < 0 ? val : val & bl->max;
+}
+
+static const struct backlight_ops tahvo_bl_ops = {
+	.options	= BL_CORE_SUSPENDRESUME,
+	.update_status	= tahvo_bl_update_status,
+	.get_brightness	= tahvo_bl_get_brightness,
+};
+
+static int tahvo_bl_probe(struct platform_device *pdev)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.scale = BACKLIGHT_SCALE_LINEAR,
+	};
+	struct backlight_device *bd;
+	struct tahvo_bl *bl;
+	int rev, level;
+
+	bl = devm_kzalloc(&pdev->dev, sizeof(*bl), GFP_KERNEL);
+	if (!bl)
+		return -ENOMEM;
+
+	bl->rdev = dev_get_drvdata(pdev->dev.parent);
+
+	rev = retu_read(bl->rdev, TAHVO_REG_ASICR);
+	if (rev < 0)
+		return rev;
+	if (((rev >> 8) == 0x03 && (rev & 0xff) >= 0x50) || (rev >> 8) == 0x0b)
+		bl->max = 0x7f;
+	else
+		bl->max = 0x0f;
+
+	level = retu_read(bl->rdev, TAHVO_REG_LEDPWMR);
+	if (level < 0)
+		return level;
+
+	/* Keep the bootloader's level; full brightness if it left it off */
+	props.max_brightness = bl->max;
+	props.brightness = (level & bl->max) ?: bl->max;
+
+	bd = devm_backlight_device_register(&pdev->dev, dev_name(&pdev->dev),
+					    &pdev->dev, bl, &tahvo_bl_ops,
+					    &props);
+	if (IS_ERR(bd))
+		return PTR_ERR(bd);
+
+	platform_set_drvdata(pdev, bd);
+	dev_info(&pdev->dev, "Tahvo rev %#06x, %u levels\n", rev, bl->max + 1);
+
+	return 0;
+}
+
+static const struct of_device_id tahvo_bl_of_match[] = {
+	{ .compatible = "nokia,tahvo-backlight" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tahvo_bl_of_match);
+
+static struct platform_driver tahvo_bl_driver = {
+	.probe	= tahvo_bl_probe,
+	.driver	= {
+		.name		= "tahvo-backlight",
+		.of_match_table	= tahvo_bl_of_match,
+	},
+};
+module_platform_driver(tahvo_bl_driver);
+
+MODULE_ALIAS("platform:tahvo-backlight");
+MODULE_DESCRIPTION("Nokia Tahvo LCD backlight");
+MODULE_LICENSE("GPL");
