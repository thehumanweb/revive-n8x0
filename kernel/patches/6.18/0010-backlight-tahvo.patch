backlight: Nokia Tahvo LCD backlight (N800/N810)

The N800/N810 LCD backlight is a PWM in the Tahvo ASIC (LEDPWM, 0x05):
7 bits on Tahvo 3.x from revision 0x50 and on Betty, 4 bits on older
Tahvo. A retu-mfd cell with a DT node, so the panel can refer to it.
The bootloader's level is kept at probe (full if it left it off).
Register use after Nokia's board-n8x0-lcd.c.

--- a/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap2420-n8x0-common.dtsi
@@ -33,6 +33,10 @@
 				interrupt-parent = <&gpio4>;
 				interrupts = <15 IRQ_TYPE_EDGE_RISING>;	/* gpio111 */
 				reg = <0x2>;
+
+				backlight: backlight {
+					compatible = "nokia,tahvo-backlight";
+				};
 			};
 		};
 	};
--- a/drivers/mfd/retu-mfd.c
+++ b/drivers/mfd/retu-mfd.c
@@ -124,6 +124,10 @@
 		.name		= "tahvo-usb",
 		.resources	= tahvo_usb_res,
 		.num_resources	= ARRAY_SIZE(tahvo_usb_res),
+	},
+	{
+		.name		= "tahvo-backlight",
+		.of_compatible	= "nokia,tahvo-backlight",
 	},
 #if IS_ENABLED(CONFIG_MFD_RETU_USER)
 	{
--- a/drivers/video/backlight/Kconfig
+++ b/drivers/video/backlight/Kconfig
@@ -441,6 +441,13 @@
 	  To compile this driver as a module, choose M here: the module will
 	  be called sky81452-backlight
 
