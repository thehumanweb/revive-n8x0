+/* Can this CRTC's display be sent a rectangle instead of the frame? */
+bool omap_crtc_can_update_rect(struct drm_crtc *crtc)
+{
+	struct omap_crtc *omap_crtc = to_omap_crtc(crtc);
+	struct omap_dss_device *dssdev = omap_crtc->pipe->output;
+
+	return to_omap_crtc_state(crtc->state)->manually_updated && dssdev &&
+	       dssdev->dsi_ops && dssdev->dsi_ops->update_rect;
+}
+
+/* The primary plane fetches just r in this commit: send only that */
+void omap_crtc_set_update_rect(struct drm_crtc *crtc, const struct drm_rect *r)
+{
+	struct omap_crtc *omap_crtc = to_omap_crtc(crtc);
+
+	omap_crtc->rect_next = *r;
+	omap_crtc->partial_next = true;
+}
+
