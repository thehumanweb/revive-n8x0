+/*
+ * A manually updated display (RFBI, DSI command mode) is sent only what
+ * changed: the primary plane alone on its CRTC, covering it unscaled and
+ * unrotated, fetches just the merged damage (whole 8-pixel columns), and
+ * the CRTC sends that rectangle (omap_crtc_set_update_rect()).
+ */
+static void omap_plane_crop_to_damage(struct drm_plane_state *old_state,
+				      struct drm_plane_state *new_state,
+				      struct omap_overlay_info *info)
+{
+	struct drm_crtc_state *cs = new_state->crtc->state;
+	const struct drm_format_info *f = new_state->fb->format;
+	int sx = new_state->src_x >> 16, sy = new_state->src_y >> 16;
+	struct drm_rect r;
+
+	if (!omap_crtc_can_update_rect(new_state->crtc) || f->num_planes != 1 ||
+	    new_state->rotation != DRM_MODE_ROTATE_0 ||
+	    hweight32(cs->plane_mask) != 1 ||
+	    new_state->crtc_x || new_state->crtc_y ||
+	    new_state->crtc_w != cs->mode.hdisplay ||
+	    new_state->crtc_h != cs->mode.vdisplay ||
+	    (new_state->src_w >> 16) != new_state->crtc_w ||
+	    (new_state->src_h >> 16) != new_state->crtc_h ||
+	    !drm_atomic_helper_damage_merged(old_state, new_state, &r))
+		return;
+
+	/* damage is in the framebuffer, the plane's source starts at sx, sy */
+	drm_rect_translate(&r, -sx, -sy);
+	r.x1 = round_down(max(r.x1, 0), 8);
+	r.y1 = max(r.y1, 0);
+	r.x2 = min_t(int, round_up(r.x2, 8), new_state->crtc_w);
+	r.y2 = min_t(int, r.y2, new_state->crtc_h);
+	if (r.x1 >= r.x2 || r.y1 >= r.y2 ||
+	    (!r.x1 && !r.y1 && r.x2 == new_state->crtc_w &&
+	     r.y2 == new_state->crtc_h))
+		return;
+
+	info->paddr += r.y1 * new_state->fb->pitches[0] + r.x1 * f->cpp[0];
+	info->width = info->out_width = drm_rect_width(&r);
+	info->height = info->out_height = drm_rect_height(&r);
+	info->pos_x = 0;
+	info->pos_y = 0;
+	omap_crtc_set_update_rect(new_state->crtc, &r);
+}
+
