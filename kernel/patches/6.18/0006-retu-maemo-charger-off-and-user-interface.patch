+/*
+ * Tahvo drives the charger PWM. Nothing in the kernel manages charging; Maemo's
+ * BME does it from userspace. Whatever left the charger running (bootloader,
+ * previous kernel, BME), turn it off: charge PWM to 0, at probe, on
+ * shutdown/reboot/kexec and on panic. CHGCTL's PWM override bits are left
+ * alone until measured on hardware.
+ */
+static int tahvo_charger_off(struct retu_dev *rdev)
+{
+	return retu_write(rdev, TAHVO_REG_CHGCURR, 0);
+}
