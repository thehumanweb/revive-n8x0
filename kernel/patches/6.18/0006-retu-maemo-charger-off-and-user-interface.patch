+/*
+ * Read a Retu ADC channel (10 bits), as Nokia's retu driver did, including
+ * the Vilma battery voltage quirk.
+ */
+int retu_read_adc(struct retu_dev *rdev, int channel)
+{
+	unsigned int scr, adcr;
+	int ret;
+
+	if (rdev->is_tahvo)
+		return -ENODEV;
+	if (channel < 0 || channel > RETU_ADC_MAX_CHANNEL)
+		return -EINVAL;
 
+	mutex_lock(&rdev->mutex);
+
+	if (channel == 8 && rdev->is_vilma) {
+		ret = regmap_read(rdev->regmap, RETU_REG_ADCSCR, &scr);
+		if (!ret)
+			ret = regmap_read(rdev->regmap, RETU_REG_ADCR, &adcr);
+		if (!ret && (scr & 0xff) && ((adcr >> 10) & 0xf) != 8)
+			ret = regmap_write(rdev->regmap, RETU_REG_ADCSCR,
+					   scr & ~0xff);
+		if (ret)
+			goto out;
+	}
+
+	ret = regmap_write(rdev->regmap, RETU_REG_ADCR, channel << 10);
+	if (!ret)
+		ret = regmap_read(rdev->regmap, RETU_REG_ADCR, &adcr);
+	if (!ret && rdev->is_vilma)
+		ret = regmap_write(rdev->regmap, RETU_REG_ADCR, 1 << 13);
+out:
+	mutex_unlock(&rdev->mutex);
+
+	return ret ? ret : (adcr & 0x3ff);
+}
+EXPORT_SYMBOL_GPL(retu_read_adc);
