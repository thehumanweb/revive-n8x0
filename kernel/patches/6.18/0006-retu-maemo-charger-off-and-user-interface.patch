+/* Read-modify-write under the device lock */
+int retu_update_bits(struct retu_dev *rdev, u8 reg, u16 mask, u16 val)
+{
+	int ret;
+
+	mutex_lock(&rdev->mutex);
+	ret = regmap_update_bits(rdev->regmap, reg, mask, val);
+	mutex_unlock(&rdev->mutex);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(retu_update_bits);
