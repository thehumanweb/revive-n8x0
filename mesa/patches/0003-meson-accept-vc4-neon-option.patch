From: Carsten Munk <carsten.munk@gmail.com>
Subject: [PATCH] meson: accept the gallium-vc4-neon option Buildroot passes

---
diff -ruN a/meson.options b/meson.options
--- a/meson.options	2026-11-06 16:47:52.954753074 +0100
+++ b/meson.options	2026-11-06 16:47:52.954753074 +0100
@@ -879,3 +879,11 @@
   value : false,
   description : 'use experimental virtio backend for intel driver',
 )
+
+option(
+  'gallium-vc4-neon',
+  type : 'combo',
+  value : 'auto',
+  choices : ['auto', 'enabled', 'disabled'],
+  description : 'Accepted and ignored: Buildroot 2026.08.1 still passes it, Mesa 26.1.8 no longer has it (vc4 is not built here).',
+)
